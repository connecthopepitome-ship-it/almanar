---
import Icon from './Icon.astro';
import HeroVenetianCarousel from './HeroVenetianCarousel';

// Six technical service divisions matching Image 2 exactly
const servicePanels = [
  {
    id: 'hvac',
    titleLine1: 'HVAC',
    titleLine2: 'INSTALLATIONS',
    href: '/services/hvac',
    iconName: 'fan'
  },
  {
    id: 'mep',
    titleLine1: 'MEP',
    titleLine2: 'CONTRACTING',
    href: '/services/mep-contracting',
    iconName: 'settings'
  },
  {
    id: 'fire',
    titleLine1: 'FIRE',
    titleLine2: 'DETECTION',
    href: '/services/fire-detection',
    iconName: 'flame'
  },
  {
    id: 'telecom',
    titleLine1: 'IT &',
    titleLine2: 'TELECOMMUNICATIONS',
    href: '/services/it-telecom',
    iconName: 'network'
  },
  {
    id: 'security',
    titleLine1: 'SECURITY &',
    titleLine2: 'SURVEILLANCE',
    href: '/services/security',
    iconName: 'shield-check'
  },
  {
    id: 'maintenance',
    titleLine1: 'FACILITY',
    titleLine2: 'MAINTENANCE',
    href: '/services/facility-maintenance',
    iconName: 'wrench'
  }
];

// Bottom information strip items
const infoItems = [
  {
    iconName: 'calendar',
    label: 'ESTABLISHED 2001'
  },
  {
    iconName: 'map-pin',
    label: 'ABU DHABI & AL AIN'
  },
  {
    iconName: 'layers',
    label: 'INTEGRATED ENGINEERING'
  },
  {
    iconName: 'grid',
    label: 'SIX TECHNICAL SERVICE DIVISIONS'
  }
];
---

<section 
  id="homepage-hero"
  class="relative -mt-20 sm:-mt-24 pt-24 sm:pt-28 min-h-[92vh] lg:min-h-[95vh] flex flex-col justify-between bg-[#111920] text-white overflow-hidden border-b border-[#252F38]"
  aria-label="Al Manar Tech Homepage Hero"
>
  <!-- =========================================================================
       1. AUTOMATIC CINEMATIC 14-SLICE VENETIAN-BLIND BACKGROUND CAROUSEL
       ========================================================================= -->
  <div class="absolute inset-0 z-0 overflow-hidden pointer-events-none select-none">
    <!-- 14-Slice Venetian-Blind Continuous Carousel Component (React) -->
    <HeroVenetianCarousel client:load />

    <!-- Uniform Dark Navy Overlay (Section 4: Starting at rgba(17, 25, 32, 0.38)) -->
    <div 
      class="absolute inset-0 bg-[#111920]/40 pointer-events-none"
    ></div>

    <!-- Top Gradient Overlay (ensures floating header contrast) -->
    <div 
      class="absolute inset-0 pointer-events-none" 
      style="background: linear-gradient(180deg, rgba(17, 25, 32, 0.75) 0%, rgba(17, 25, 32, 0.35) 25%, transparent 50%);"
    ></div>

    <!-- Left Gradient Overlay (provides obsidian density for 100% text contrast) -->
    <div 
      class="absolute inset-0 pointer-events-none" 
      style="background: linear-gradient(90deg, rgba(17, 25, 32, 0.96) 0%, rgba(17, 25, 32, 0.88) 35%, rgba(17, 25, 32, 0.50) 65%, rgba(17, 25, 32, 0.15) 100%);"
    ></div>

    <!-- Bottom Gradient Overlay (ensures strong contrast for information strip) -->
    <div 
      class="absolute inset-0 pointer-events-none" 
      style="background: linear-gradient(0deg, rgba(17, 25, 32, 0.90) 0%, rgba(17, 25, 32, 0.50) 15%, transparent 35%);"
    ></div>

    <!-- Center Radial Warm Copper Ambient Lighting -->
    <div 
      class="absolute inset-0 pointer-events-none"
      style="background: radial-gradient(circle at 75% 45%, rgba(240, 120, 66, 0.08) 0%, transparent 60%);"
    ></div>

    <!-- Technical Coordinate Grid Overlay (Matching Reference Image 2) -->
    <div 
      class="absolute inset-0 opacity-[0.06] pointer-events-none"
      style="background-image: linear-gradient(to right, #FFFFFF 1px, transparent 1px), linear-gradient(to bottom, #FFFFFF 1px, transparent 1px); background-size: 80px 80px;"
    ></div>

    <!-- Thin Glowing Copper Curves SVG (Matching Reference Image 2) -->
    <svg 
      class="absolute inset-0 w-full h-full pointer-events-none opacity-40" 
      xmlns="http://www.w3.org/2000/svg"
    >
      <defs>
        <linearGradient id="heroCopperStreak" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#F07842" stop-opacity="0" />
          <stop offset="40%" stop-color="#F07842" stop-opacity="0.8" />
          <stop offset="70%" stop-color="#FFAB78" stop-opacity="0.9" />
          <stop offset="100%" stop-color="#D96532" stop-opacity="0" />
        </linearGradient>
        <filter id="heroGlow" x="-20%" y="-20%" width="140%" height="140%">
          <feGaussianBlur stdDeviation="3" result="blur" />
          <feComposite in="SourceGraphic" in2="blur" operator="over" />
        </filter>
      </defs>
      <path 
        d="M 320 480 C 480 320, 680 180, 880 140 C 980 120, 1140 180, 1320 320" 
        fill="none" 
        stroke="url(#heroCopperStreak)" 
        stroke-width="1.5" 
        filter="url(#heroGlow)"
      />
      <path 
        d="M 400 460 C 560 280, 780 160, 960 180 C 1100 200, 1260 380, 1420 540" 
        fill="none" 
        stroke="url(#heroCopperStreak)" 
        stroke-width="1" 
        opacity="0.5"
      />
    </svg>
  </div>

  <!-- =========================================================================
       2. MAIN HERO CONTENT (12 COLS: TYPOGRAPHY LEFT, 6 PANELS RIGHT)
       ========================================================================= -->
  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-14 lg:py-16 w-full my-auto">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-8 items-center">
      
      <!-- ---------------------------------------------------------------------
           LEFT COLUMN: EYEBROW + 5-LINE HEADLINE + PARAGRAPH + DUAL CTAS
           --------------------------------------------------------------------- -->
      <div class="lg:col-span-7 xl:col-span-8 space-y-6 sm:space-y-8 max-w-3xl hero-content-left">
        
        <!-- Eyebrow: — INTEGRATED ENGINEERING & TECHNICAL SOLUTIONS — -->
        <div class="inline-flex items-center gap-2.5 text-[#F07842] font-mono text-[11px] sm:text-xs font-bold tracking-[0.2em] uppercase select-none animate-hero-fade-up">
          <span class="w-5 sm:w-7 h-[1.5px] bg-[#F07842]"></span>
          <span>INTEGRATED ENGINEERING &amp; TECHNICAL SOLUTIONS</span>
          <span class="w-5 sm:w-7 h-[1.5px] bg-[#F07842]"></span>
        </div>

        <!-- 5-Line Strict Headline with Metallic Copper Treatment -->
        <h1 class="font-display font-extrabold uppercase tracking-tight text-white text-[2.75rem] sm:text-[3.75rem] md:text-[4.5rem] lg:text-[4.75rem] xl:text-[5.25rem] leading-[0.93] sm:leading-[0.93] animate-hero-fade-up delay-100">
          <span class="block text-white">ENGINEERING</span>
          <span class="block text-white">THE SYSTEMS</span>
          <span class="block text-white">THAT KEEP</span>
          <span class="block text-copper-headline">BUILDINGS</span>
          <span class="block text-copper-headline">RUNNING.</span>
        </h1>

        <!-- Exact Supporting Paragraph -->
        <p class="font-sans text-[#D5D9DF] text-sm sm:text-base leading-relaxed max-w-xl text-left animate-hero-fade-up delay-200">
          Al Manar Tech delivers integrated electromechanical, HVAC, fire detection, IT and telecommunications, security and maintenance solutions for commercial, industrial and residential environments across Abu Dhabi and Al Ain.
        </p>

        <!-- Dual CTA Buttons (Strict Match to Image 2) -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3.5 sm:gap-4 pt-2 animate-hero-fade-up delay-300">
          <!-- Primary CTA: DISCUSS YOUR PROJECT → -->
          <a 
            href="/contact"
            data-magnetic="true"
            class="inline-flex items-center justify-center gap-2.5 px-7 py-3.5 sm:py-4 rounded-xl font-display font-bold text-xs sm:text-sm uppercase tracking-wider bg-[#F07842] text-[#111920] hover:bg-[#D96532] shadow-lg shadow-[#F07842]/25 transition-all duration-200 group/btn shrink-0"
          >
            <span>DISCUSS YOUR PROJECT</span>
            <span class="group-hover/btn:translate-x-1 transition-transform duration-200">→</span>
          </a>

          <!-- Secondary CTA: EXPLORE OUR SERVICES → -->
          <a 
            href="/services"
            data-magnetic="true"
            class="inline-flex items-center justify-center gap-2.5 px-7 py-3.5 sm:py-4 rounded-xl font-display font-bold text-xs sm:text-sm uppercase tracking-wider bg-[#111920]/60 backdrop-blur-md text-white border border-[#F07842]/60 hover:border-[#F07842] hover:bg-[#F07842]/10 transition-all duration-200 group/btn2 shrink-0"
          >
            <span>EXPLORE OUR SERVICES</span>
            <span class="group-hover/btn2:translate-x-1 transition-transform duration-200">→</span>
          </a>
        </div>

      </div>

      <!-- ---------------------------------------------------------------------
           RIGHT COLUMN: SIX VERTICALLY STACKED TRANSLUCENT SERVICE PANELS
           --------------------------------------------------------------------- -->
      <div class="lg:col-span-5 xl:col-span-4 flex justify-start lg:justify-end">
        <div class="w-full sm:max-w-xs space-y-2.5 sm:space-y-3">
          {servicePanels.map((panel, idx) => (
            <a 
              href={panel.href}
              class="glass-panel-copper rounded-2xl px-4 py-3 sm:px-5 sm:py-3.5 flex items-center gap-3.5 group cursor-pointer border border-white/12 hover:border-[#F07842]/60 transition-all duration-300 animate-hero-slide-left"
              style={`animation-delay: ${150 + idx * 75}ms;`}
            >
              <!-- Copper Line Icon -->
              <div class="p-2 rounded-xl bg-[#111920]/70 border border-white/10 group-hover:border-[#F07842]/40 transition-colors shrink-0">
                {panel.iconName === 'fan' && (
                  <svg class="w-5 h-5 text-[#F07842] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 12c-2-2.67-4-4-6-4a4 4 0 1 0 0 8c2 0 4-1.33 6-4z" />
                    <path d="M12 12c2.67-2 4-4 4-6a4 4 0 1 0-8 0c0 2 1.33 4 4 6z" />
                    <path d="M12 12c2 2.67 4 4 6 4a4 4 0 0 0 0-8c-2 0-4 1.33-6 4z" />
                    <path d="M12 12c-2.67 2-4 4-4 6a4 4 0 0 0 8 0c0-2-1.33-4-4-6z" />
                    <circle cx="12" cy="12" r="1.5" fill="currentColor" />
                  </svg>
                )}
                {panel.iconName === 'settings' && (
                  <svg class="w-5 h-5 text-[#F07842] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="3" />
                    <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z" />
                  </svg>
                )}
                {panel.iconName === 'flame' && (
                  <svg class="w-5 h-5 text-[#F07842] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z" />
                  </svg>
                )}
                {panel.iconName === 'network' && (
                  <svg class="w-5 h-5 text-[#F07842] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="2" y="2" width="6" height="6" rx="1" />
                    <rect x="16" y="2" width="6" height="6" rx="1" />
                    <rect x="9" y="16" width="6" height="6" rx="1" />
                    <path d="M5 8v3a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V8" />
                    <path d="M12 12v4" />
                  </svg>
                )}
                {panel.iconName === 'shield-check' && (
                  <svg class="w-5 h-5 text-[#F07842] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                    <path d="m9 12 2 2 4-4" />
                  </svg>
                )}
                {panel.iconName === 'wrench' && (
                  <svg class="w-5 h-5 text-[#F07842] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z" />
                  </svg>
                )}
              </div>

              <!-- Service Title -->
              <div class="flex flex-col">
                <span class="font-display font-bold text-[11px] sm:text-xs tracking-wider text-white uppercase leading-tight group-hover:text-[#FFAB78] transition-colors">
                  {panel.titleLine1}
                </span>
                <span class="font-display font-bold text-[11px] sm:text-xs tracking-wider text-white uppercase leading-tight group-hover:text-[#FFAB78] transition-colors">
                  {panel.titleLine2}
                </span>
              </div>
            </a>
          ))}
        </div>
      </div>

    </div>
  </div>

  <!-- =========================================================================
       3. FULL-WIDTH BOTTOM INFORMATION STRIP (STRICT MATCH TO IMAGE 2)
       ========================================================================= -->
  <div class="relative z-10 w-full border-t border-white/10 bg-[#111920]/85 backdrop-blur-md">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 sm:py-5">
      <div class="flex flex-wrap items-center justify-between gap-y-3 gap-x-6 text-white font-mono text-xs sm:text-[13px] font-bold tracking-wider uppercase">
        
        <!-- ESTABLISHED 2001 -->
        <div class="flex items-center gap-2.5 sm:gap-3 text-slate-200 hover:text-white transition-colors">
          <svg class="w-4 h-4 text-[#F07842] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2" />
            <line x1="16" y1="2" x2="16" y2="6" />
            <line x1="8" y1="2" x2="8" y2="6" />
            <line x1="3" y1="10" x2="21" y2="10" />
          </svg>
          <span>ESTABLISHED 2001</span>
        </div>

        <div class="hidden lg:block w-[1px] h-4 bg-[#F07842]/40"></div>

        <!-- ABU DHABI & AL AIN -->
        <div class="flex items-center gap-2.5 sm:gap-3 text-slate-200 hover:text-white transition-colors">
          <svg class="w-4 h-4 text-[#F07842] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
            <circle cx="12" cy="10" r="3" />
          </svg>
          <span>ABU DHABI &amp; AL AIN</span>
        </div>

        <div class="hidden lg:block w-[1px] h-4 bg-[#F07842]/40"></div>

        <!-- INTEGRATED ENGINEERING -->
        <div class="flex items-center gap-2.5 sm:gap-3 text-slate-200 hover:text-white transition-colors">
          <svg class="w-4 h-4 text-[#F07842] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="12 2 2 7 12 12 22 7 12 2" />
            <polyline points="2 17 12 22 22 17" />
            <polyline points="2 12 12 17 22 12" />
          </svg>
          <span>INTEGRATED ENGINEERING</span>
        </div>

        <div class="hidden lg:block w-[1px] h-4 bg-[#F07842]/40"></div>

        <!-- SIX TECHNICAL SERVICE DIVISIONS -->
        <div class="flex items-center gap-2.5 sm:gap-3 text-slate-200 hover:text-white transition-colors">
          <svg class="w-4 h-4 text-[#F07842] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="3" width="7" height="7" />
            <rect x="14" y="3" width="7" height="7" />
            <rect x="14" y="14" width="7" height="7" />
            <rect x="3" y="14" width="7" height="7" />
          </svg>
          <span>SIX TECHNICAL SERVICE DIVISIONS</span>
        </div>

      </div>
    </div>
  </div>

</section>

<style>
  @keyframes heroFadeUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes heroSlideLeft {
    from {
      opacity: 0;
      transform: translateX(25px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  .animate-hero-fade-up {
    animation: heroFadeUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .animate-hero-slide-left {
    animation: heroSlideLeft 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .delay-100 {
    animation-delay: 100ms;
  }

  .delay-200 {
    animation-delay: 200ms;
  }

  .delay-300 {
    animation-delay: 300ms;
  }

  @media (prefers-reduced-motion: reduce) {
    .animate-hero-fade-up,
    .animate-hero-slide-left {
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
    }
  }
</style>

