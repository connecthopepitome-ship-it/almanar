---
import Icon from './Icon.astro';
import HeroVenetianCarousel from './HeroVenetianCarousel.astro';

// Six technical service divisions matching Image 2 exactly
const servicePanels = [
  {
    id: 'hvac',
    titleLine1: 'HVAC',
    titleLine2: 'INSTALLATIONS',
    href: '/services/hvac',
    iconName: 'fan'
  },
  {
    id: 'mep',
    titleLine1: 'MEP',
    titleLine2: 'CONTRACTING',
    href: '/services/mep-contracting',
    iconName: 'settings'
  },
  {
    id: 'fire',
    titleLine1: 'FIRE',
    titleLine2: 'DETECTION',
    href: '/services/fire-detection',
    iconName: 'flame'
  },
  {
    id: 'telecom',
    titleLine1: 'IT &',
    titleLine2: 'TELECOMMUNICATIONS',
    href: '/services/it-telecom',
    iconName: 'network'
  },
  {
    id: 'security',
    titleLine1: 'SECURITY &',
    titleLine2: 'SURVEILLANCE',
    href: '/services/security',
    iconName: 'shield-check'
  },
  {
    id: 'maintenance',
    titleLine1: 'FACILITY',
    titleLine2: 'MAINTENANCE',
    href: '/services/facility-maintenance',
    iconName: 'wrench'
  }
];

// Bottom information strip items
const infoItems = [
  {
    iconName: 'calendar',
    label: 'ESTABLISHED 2001'
  },
  {
    iconName: 'map-pin',
    label: 'ABU DHABI & AL AIN'
  },
  {
    iconName: 'layers',
    label: 'INTEGRATED ENGINEERING'
  },
  {
    iconName: 'grid',
    label: 'SIX TECHNICAL SERVICE DIVISIONS'
  }
];
---

<section 
  id="homepage-hero"
  class="relative -mt-16 sm:-mt-24 pt-20 sm:pt-28 min-h-[85vh] sm:min-h-[92vh] lg:min-h-[95vh] flex flex-col justify-between bg-[#111920] text-white overflow-hidden border-b border-[#252F38]"
  aria-label="Al Manar Tech Homepage Hero"
>
  <!-- =========================================================================
       1. SEPARATED BACKGROUND LAYER (ISOLATED Z-0 CONTAINER)
       Background carousel & overlays will never affect foreground text composition
       ========================================================================= -->
  <div 
    id="hero-background-layer"
    class="absolute inset-0 z-0 overflow-hidden pointer-events-none select-none"
    style="contain: paint layout;"
    aria-hidden="true"
  >
    <!-- Automatic Background Carousel (Mobile Crossfade / Desktop Venetian) -->
    <HeroVenetianCarousel />

    <!-- Uniform Dark Navy Tint -->
    <div class="absolute inset-0 bg-[#111920]/45 pointer-events-none"></div>

    <!-- Top Gradient (ensures high contrast behind header) -->
    <div 
      class="absolute inset-0 pointer-events-none" 
      style="background: linear-gradient(180deg, rgba(17, 25, 32, 0.85) 0%, rgba(17, 25, 32, 0.40) 25%, transparent 50%);"
    ></div>

    <!-- Left Gradient (guarantees text contrast across all mobile & desktop viewports) -->
    <div 
      class="absolute inset-0 pointer-events-none" 
      style="background: linear-gradient(90deg, rgba(17, 25, 32, 0.98) 0%, rgba(17, 25, 32, 0.92) 40%, rgba(17, 25, 32, 0.60) 70%, rgba(17, 25, 32, 0.25) 100%);"
    ></div>

    <!-- Bottom Gradient -->
    <div 
      class="absolute inset-0 pointer-events-none" 
      style="background: linear-gradient(0deg, rgba(17, 25, 32, 0.95) 0%, rgba(17, 25, 32, 0.50) 15%, transparent 35%);"
    ></div>

    <!-- Warm Copper Ambient Radial Glow -->
    <div 
      class="absolute inset-0 pointer-events-none"
      style="background: radial-gradient(circle at 75% 45%, rgba(240, 120, 66, 0.08) 0%, transparent 60%);"
    ></div>

    <!-- Engineering Coordinate Grid -->
    <div 
      class="absolute inset-0 opacity-[0.05] pointer-events-none"
      style="background-image: linear-gradient(to right, #FFFFFF 1px, transparent 1px), linear-gradient(to bottom, #FFFFFF 1px, transparent 1px); background-size: 80px 80px;"
    ></div>

    <!-- Subtle Copper Vector Curves -->
    <svg 
      class="absolute inset-0 w-full h-full pointer-events-none opacity-30 sm:opacity-40" 
      xmlns="http://www.w3.org/2000/svg"
    >
      <defs>
        <linearGradient id="heroCopperStreak" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#F07842" stop-opacity="0" />
          <stop offset="40%" stop-color="#F07842" stop-opacity="0.8" />
          <stop offset="70%" stop-color="#FFAB78" stop-opacity="0.9" />
          <stop offset="100%" stop-color="#D96532" stop-opacity="0" />
        </linearGradient>
      </defs>
      <path 
        d="M 320 480 C 480 320, 680 180, 880 140 C 980 120, 1140 180, 1320 320" 
        fill="none" 
        stroke="url(#heroCopperStreak)" 
        stroke-width="1.5" 
      />
      <path 
        d="M 400 460 C 560 280, 780 160, 960 180 C 1100 200, 1260 380, 1420 540" 
        fill="none" 
        stroke="url(#heroCopperStreak)" 
        stroke-width="1" 
        opacity="0.5" 
      />
    </svg>
  </div>

  <!-- =========================================================================
       2. ISOLATED FOREGROUND CONTENT LAYER
       Dedicated stacking context (isolation: isolate; z-index: 20)
       Guaranteed 100% visible, stable typography with zero flickering
       ========================================================================= -->
  <div 
    id="hero-foreground-content"
    class="relative z-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-12 lg:py-16 w-full my-auto"
    style="isolation: isolate;"
  >
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-8 items-center">
      
      <!-- LEFT COLUMN: EYEBROW + HEADLINE + DESCRIPTION + CTAS -->
      <div class="lg:col-span-7 xl:col-span-8 max-w-3xl">
        
        <!-- Eyebrow: — INTEGRATED ENGINEERING & TECHNICAL SOLUTIONS — -->
        <div class="inline-flex items-center gap-2 text-[#F07842] font-mono text-[10px] sm:text-xs font-bold tracking-[0.16em] sm:tracking-[0.2em] uppercase select-none mb-3 sm:mb-4">
          <span class="w-4 sm:w-7 h-[1.5px] bg-[#F07842]"></span>
          <span>INTEGRATED ENGINEERING &amp; TECHNICAL SOLUTIONS</span>
          <span class="w-4 sm:w-7 h-[1.5px] bg-[#F07842]"></span>
        </div>

        <!-- Stable Headline with Mobile Contrast Fallback -->
        <h1 class="font-display font-extrabold uppercase tracking-tight text-white text-[2.25rem] xs:text-[2.65rem] sm:text-[3.75rem] md:text-[4.5rem] lg:text-[4.75rem] xl:text-[5.25rem] leading-[0.95] sm:leading-[0.93]">
          <span class="block text-white">ENGINEERING</span>
          <span class="block text-white">THE SYSTEMS</span>
          <span class="block text-white">THAT KEEP</span>
          <span class="block text-[#F07842] sm:text-copper-headline">BUILDINGS</span>
          <span class="block text-[#F07842] sm:text-copper-headline">RUNNING.</span>
        </h1>

        <!-- Supporting Narrative (tightened mobile composition) -->
        <p class="mt-3 sm:mt-5 font-sans text-[#E2E6EC] text-sm sm:text-base leading-relaxed max-w-xl text-left">
          Al Manar Tech delivers integrated electromechanical, HVAC, fire detection, IT and telecommunications, security and maintenance solutions for commercial, industrial and residential environments across Abu Dhabi and Al Ain.
        </p>

        <!-- Dual CTA Buttons (Full width on mobile, inline on tablet/desktop) -->
        <div class="mt-5 sm:mt-7 flex flex-col sm:flex-row items-stretch sm:items-center gap-3 sm:gap-4 w-full sm:w-auto">
          <!-- Primary CTA: DISCUSS YOUR PROJECT → -->
          <a 
            href="/contact"
            class="inline-flex items-center justify-center gap-2.5 px-6 sm:px-7 py-3.5 sm:py-4 rounded-xl font-display font-bold text-xs sm:text-sm uppercase tracking-wider bg-[#F07842] text-[#111920] hover:bg-[#D96532] shadow-lg shadow-[#F07842]/25 active:scale-95 transition-all shrink-0 text-center"
          >
            <span>DISCUSS YOUR PROJECT</span>
            <span>→</span>
          </a>

          <!-- Secondary CTA: EXPLORE OUR SERVICES → -->
          <a 
            href="/services"
            class="inline-flex items-center justify-center gap-2.5 px-6 sm:px-7 py-3.5 sm:py-4 rounded-xl font-display font-bold text-xs sm:text-sm uppercase tracking-wider bg-[#111920]/75 backdrop-blur-md text-white border border-[#F07842]/60 hover:border-[#F07842] hover:bg-[#F07842]/10 active:scale-95 transition-all shrink-0 text-center"
          >
            <span>EXPLORE OUR SERVICES</span>
            <span>→</span>
          </a>
        </div>

      </div>

      <!-- RIGHT COLUMN: SIX SERVICE PANELS (DESKTOP REFERENCE MATCH) -->
      <div class="hidden lg:flex lg:col-span-5 xl:col-span-4 justify-end w-full">
        <div class="w-full max-w-[280px] space-y-2 sm:space-y-2.5">
          {servicePanels.map((panel) => (
            <a 
              href={panel.href}
              class="glass-panel-copper rounded-2xl px-4 py-2.5 sm:px-4.5 sm:py-3 flex items-center gap-3.5 group cursor-pointer border border-white/10 hover:border-[#F07842]/60 transition-all duration-300"
            >
              <!-- Copper Line Icon -->
              <div class="w-6 h-6 flex items-center justify-center shrink-0 text-[#F07842] group-hover:text-[#FFAB78] group-hover:scale-110 transition-all duration-200">
                {panel.iconName === 'fan' && (
                  <svg class="w-5 h-5 text-[#F07842] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 12c-2-2.67-4-4-6-4a4 4 0 1 0 0 8c2 0 4-1.33 6-4z" />
                    <path d="M12 12c2.67-2 4-4 4-6a4 4 0 1 0-8 0c0 2 1.33 4 4 6z" />
                    <path d="M12 12c2 2.67 4 4 6 4a4 4 0 0 0 0-8c-2 0-4 1.33-6 4z" />
                    <path d="M12 12c-2.67 2-4 4-4 6a4 4 0 0 0 8 0c0-2-1.33-4-4-6z" />
                    <circle cx="12" cy="12" r="1.5" fill="currentColor" />
                  </svg>
                )}
                {panel.iconName === 'settings' && (
                  <svg class="w-5 h-5 text-[#F07842] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="3" />
                    <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z" />
                  </svg>
                )}
                {panel.iconName === 'flame' && (
                  <svg class="w-5 h-5 text-[#F07842] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z" />
                  </svg>
                )}
                {panel.iconName === 'network' && (
                  <svg class="w-5 h-5 text-[#F07842] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="2" y="2" width="6" height="6" rx="1" />
                    <rect x="16" y="2" width="6" height="6" rx="1" />
                    <rect x="9" y="16" width="6" height="6" rx="1" />
                    <path d="M5 8v3a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V8" />
                    <path d="M12 12v4" />
                  </svg>
                )}
                {panel.iconName === 'shield-check' && (
                  <svg class="w-5 h-5 text-[#F07842] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                    <path d="m9 12 2 2 4-4" />
                  </svg>
                )}
                {panel.iconName === 'wrench' && (
                  <svg class="w-5 h-5 text-[#F07842] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z" />
                  </svg>
                )}
              </div>

              <!-- Service Title -->
              <div class="flex flex-col justify-center text-left min-w-0">
                <span class="font-display font-bold text-xs sm:text-[12.5px] tracking-wider text-white uppercase leading-none group-hover:text-[#FFAB78] transition-colors">
                  {panel.titleLine1}
                </span>
                <span class="font-mono text-[9.5px] sm:text-[10px] text-slate-300/90 font-medium tracking-widest uppercase leading-none mt-1 group-hover:text-white transition-colors">
                  {panel.titleLine2}
                </span>
              </div>
            </a>
          ))}
        </div>
      </div>

    </div>
  </div>

  <!-- =========================================================================
       3. INFORMATION STRIP (CLEAN RESPONSIVE STRIP)
       ========================================================================= -->
  <div class="relative z-20 w-full border-t border-white/10 bg-[#111920]/90 backdrop-blur-md">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3.5 sm:py-4">
      <div class="grid grid-cols-2 lg:flex lg:flex-wrap items-center justify-between gap-y-2.5 gap-x-4 sm:gap-x-6 text-white font-mono text-[11px] sm:text-xs font-bold tracking-wider uppercase">
        
        <!-- ESTABLISHED 2001 -->
        <div class="flex items-center gap-2 sm:gap-2.5 text-slate-200">
          <Icon name="calendar" class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-[#F07842] shrink-0" />
          <span class="truncate">ESTABLISHED 2001</span>
        </div>

        <div class="hidden lg:block w-[1px] h-3.5 bg-[#F07842]/40"></div>

        <!-- ABU DHABI & AL AIN -->
        <div class="flex items-center gap-2 sm:gap-2.5 text-slate-200">
          <Icon name="map-pin" class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-[#F07842] shrink-0" />
          <span class="truncate">ABU DHABI &amp; AL AIN</span>
        </div>

        <div class="hidden lg:block w-[1px] h-3.5 bg-[#F07842]/40"></div>

        <!-- INTEGRATED ENGINEERING -->
        <div class="flex items-center gap-2 sm:gap-2.5 text-slate-200">
          <Icon name="layers" class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-[#F07842] shrink-0" />
          <span class="truncate">INTEGRATED MEP</span>
        </div>

        <div class="hidden lg:block w-[1px] h-3.5 bg-[#F07842]/40"></div>

        <!-- SIX TECHNICAL SERVICE DIVISIONS -->
        <div class="flex items-center gap-2 sm:gap-2.5 text-slate-200">
          <Icon name="shield-check" class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-[#F07842] shrink-0" />
          <span class="truncate">ADDC LICENSED</span>
        </div>

      </div>
    </div>
  </div>

</section>
