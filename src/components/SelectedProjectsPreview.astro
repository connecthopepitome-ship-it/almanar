---
import Icon from './Icon.astro';
import { VERIFIED_PROJECTS } from '../data/company';

// Select exactly the four representative projects requested
const selectedIds = [
  'yas-waterworld',
  'aldar-academies-hq',
  'puma-outlet-showroom',
  'emirates-nbd-bank'
];

const selectedProjects = selectedIds
  .map(id => VERIFIED_PROJECTS.find(p => p.id === id))
  .filter((p): p is typeof VERIFIED_PROJECTS[0] => Boolean(p));

const [project1, project2, project3, project4] = selectedProjects;
---

<div class="selected-projects-preview-root space-y-12">

  <!-- Asymmetric Editorial Showcase (Row 1: 7 Cols + 5 Cols) -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch">
    
    <!-- Project 1: Yas Waterworld (7 Cols - Hero Photographic Lead) -->
    {project1 && (
      <article 
        class="lg:col-span-7 group bg-[#252A30]/90 rounded-3xl overflow-hidden border border-white/10 hover:border-[#C58461]/60 shadow-2xl transition-all duration-500 flex flex-col justify-between"
        data-cursor="view"
      >
        <!-- Photographic Frame with Reveal -->
        <div class="relative aspect-[16/10] overflow-hidden bg-[#17191D] crosshair-corner">
          <img 
            src={project1.image} 
            alt={`${project1.title} - ${project1.client}`}
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-[#17191D] via-[#17191D]/30 to-transparent"></div>

          <!-- Architectural Telemetry Badges -->
          <div class="absolute top-4 left-4 right-4 flex items-center justify-between text-[11px] font-mono">
            <span class="px-3 py-1 rounded-xl bg-[#17191D]/80 border border-[#B56E4B]/40 text-[#FFAB78] font-bold">
              {project1.category}
            </span>
            <span class="px-3 py-1 rounded-xl bg-[#17191D]/80 border border-white/10 text-slate-300 font-medium">
              {project1.location}
            </span>
          </div>

          <!-- Bottom Title Overlay -->
          <div class="absolute bottom-4 left-5 right-5 text-white">
            <span class="font-mono text-xs uppercase tracking-wider text-[#FFAB78] block mb-1">
              Client: {project1.client}
            </span>
            <h3 class="font-display text-2xl sm:text-3xl font-extrabold text-white tracking-tight leading-tight group-hover:text-[#FFAB78] transition-colors">
              {project1.title}
            </h3>
          </div>
        </div>

        <!-- Descriptive Metadata Body -->
        <div class="p-6 sm:p-8 space-y-4 bg-[#17191D]/90 flex-1 flex flex-col justify-between">
          <div class="space-y-3">
            <div class="flex items-center justify-between font-mono text-xs text-slate-400 pb-3 border-b border-white/5">
              <span>CLIENT: <strong class="text-white">{project1.client}</strong></span>
              <span class="text-emerald-400 font-semibold flex items-center gap-1.5">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                Verified Installation
              </span>
            </div>
            <p class="text-sm text-slate-300 leading-relaxed font-sans">
              {project1.scopeSummary}
            </p>
          </div>

          <div class="pt-4 border-t border-white/5 flex flex-wrap items-center justify-between gap-4">
            <div class="flex flex-wrap gap-1.5 font-mono text-[10px]">
              {project1.sectors.map((sec) => (
                <span class="px-2.5 py-1 rounded-lg bg-[#252A30] text-slate-300 border border-white/10">{sec}</span>
              ))}
            </div>
            <a 
              href={`/projects/${project1.id}`} 
              class="inline-flex items-center gap-2 text-xs font-mono font-bold text-[#F07842] hover:text-white transition-colors group/link"
            >
              <span>View Project Details</span>
              <Icon name="arrow-right" class="w-3.5 h-3.5 group-hover/link:translate-x-1 transition-transform" />
            </a>
          </div>
        </div>
      </article>
    )}

    <!-- Project 2: Aldar Academies Headquarters (5 Cols - Tall Editorial Card) -->
    {project2 && (
      <article 
        class="lg:col-span-5 group bg-[#252A30]/90 rounded-3xl overflow-hidden border border-white/10 hover:border-[#C58461]/60 shadow-2xl transition-all duration-500 flex flex-col justify-between"
        data-cursor="view"
      >
        <div class="relative aspect-[16/11] overflow-hidden bg-[#17191D]">
          <img 
            src={project2.image} 
            alt={`${project2.title} - ${project2.client}`}
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-[#17191D] via-[#17191D]/30 to-transparent"></div>
          
          <div class="absolute top-4 left-4 right-4 flex items-center justify-between text-[11px] font-mono">
            <span class="px-3 py-1 rounded-xl bg-[#17191D]/80 border border-[#B56E4B]/40 text-[#FFAB78] font-bold">
              {project2.category}
            </span>
            <span class="px-3 py-1 rounded-xl bg-[#17191D]/80 border border-white/10 text-slate-300 font-medium">
              {project2.location}
            </span>
          </div>

          <div class="absolute bottom-4 left-5 right-5">
            <span class="font-mono text-xs uppercase tracking-wider text-[#FFAB78] block mb-1">
              Client: {project2.client}
            </span>
            <h3 class="font-display text-xl sm:text-2xl font-extrabold text-white group-hover:text-[#FFAB78] transition-colors leading-tight">
              {project2.title}
            </h3>
          </div>
        </div>

        <div class="p-6 space-y-4 bg-[#17191D]/90 flex-1 flex flex-col justify-between">
          <div class="space-y-3">
            <div class="flex items-center justify-between font-mono text-xs text-slate-400 pb-3 border-b border-white/5">
              <span>CLIENT: <strong class="text-white">{project2.client}</strong></span>
              <span class="text-emerald-400 font-semibold flex items-center gap-1.5">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                Verified Installation
              </span>
            </div>
            <p class="text-xs sm:text-sm text-slate-300 leading-relaxed font-sans line-clamp-3">
              {project2.scopeSummary}
            </p>
          </div>

          <div class="pt-4 border-t border-white/5 flex flex-wrap items-center justify-between gap-4">
            <div class="flex flex-wrap gap-1.5 font-mono text-[10px]">
              {project2.sectors.map((sec) => (
                <span class="px-2.5 py-1 rounded-lg bg-[#252A30] text-slate-300 border border-white/10">{sec}</span>
              ))}
            </div>
            <a 
              href={`/projects/${project2.id}`} 
              class="inline-flex items-center gap-2 text-xs font-mono font-bold text-[#F07842] hover:text-white transition-colors group/link"
            >
              <span>View Project Details</span>
              <Icon name="arrow-right" class="w-3.5 h-3.5 group-hover/link:translate-x-1 transition-transform" />
            </a>
          </div>
        </div>
      </article>
    )}

  </div>

  <!-- Asymmetric Editorial Showcase (Row 2: 5 Cols + 7 Cols) -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch">
    
    <!-- Project 3: Puma Flagship Outlet Showroom (5 Cols) -->
    {project3 && (
      <article 
        class="lg:col-span-5 group bg-[#252A30]/90 rounded-3xl overflow-hidden border border-white/10 hover:border-[#C58461]/60 shadow-2xl transition-all duration-500 flex flex-col justify-between"
        data-cursor="view"
      >
        <div class="relative aspect-[16/11] overflow-hidden bg-[#17191D]">
          <img 
            src={project3.image} 
            alt={`${project3.title} - ${project3.client}`}
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-[#17191D] via-[#17191D]/30 to-transparent"></div>
          
          <div class="absolute top-4 left-4 right-4 flex items-center justify-between text-[11px] font-mono">
            <span class="px-3 py-1 rounded-xl bg-[#17191D]/80 border border-[#B56E4B]/40 text-[#FFAB78] font-bold">
              {project3.category}
            </span>
            <span class="px-3 py-1 rounded-xl bg-[#17191D]/80 border border-white/10 text-slate-300 font-medium">
              {project3.location}
            </span>
          </div>

          <div class="absolute bottom-4 left-5 right-5">
            <span class="font-mono text-xs uppercase tracking-wider text-[#FFAB78] block mb-1">
              Client: {project3.client}
            </span>
            <h3 class="font-display text-xl sm:text-2xl font-extrabold text-white group-hover:text-[#FFAB78] transition-colors leading-tight">
              {project3.title}
            </h3>
          </div>
        </div>

        <div class="p-6 space-y-4 bg-[#17191D]/90 flex-1 flex flex-col justify-between">
          <div class="space-y-3">
            <div class="flex items-center justify-between font-mono text-xs text-slate-400 pb-3 border-b border-white/5">
              <span>CLIENT: <strong class="text-white">{project3.client}</strong></span>
              <span class="text-emerald-400 font-semibold flex items-center gap-1.5">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                Verified Installation
              </span>
            </div>
            <p class="text-xs sm:text-sm text-slate-300 leading-relaxed font-sans line-clamp-3">
              {project3.scopeSummary}
            </p>
          </div>

          <div class="pt-4 border-t border-white/5 flex flex-wrap items-center justify-between gap-4">
            <div class="flex flex-wrap gap-1.5 font-mono text-[10px]">
              {project3.sectors.map((sec) => (
                <span class="px-2.5 py-1 rounded-lg bg-[#252A30] text-slate-300 border border-white/10">{sec}</span>
              ))}
            </div>
            <a 
              href={`/projects/${project3.id}`} 
              class="inline-flex items-center gap-2 text-xs font-mono font-bold text-[#F07842] hover:text-white transition-colors group/link"
            >
              <span>View Project Details</span>
              <Icon name="arrow-right" class="w-3.5 h-3.5 group-hover/link:translate-x-1 transition-transform" />
            </a>
          </div>
        </div>
      </article>
    )}

    <!-- Project 4: Emirates NBD Bank Branch (7 Cols - Wide Editorial Card) -->
    {project4 && (
      <article 
        class="lg:col-span-7 group bg-[#252A30]/90 rounded-3xl overflow-hidden border border-white/10 hover:border-[#C58461]/60 shadow-2xl transition-all duration-500 flex flex-col justify-between"
        data-cursor="view"
      >
        <div class="relative aspect-[16/10] overflow-hidden bg-[#17191D] crosshair-corner">
          <img 
            src={project4.image} 
            alt={`${project4.title} - ${project4.client}`}
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-[#17191D] via-[#17191D]/30 to-transparent"></div>

          <div class="absolute top-4 left-4 right-4 flex items-center justify-between text-[11px] font-mono">
            <span class="px-3 py-1 rounded-xl bg-[#17191D]/80 border border-[#B56E4B]/40 text-[#FFAB78] font-bold">
              {project4.category}
            </span>
            <span class="px-3 py-1 rounded-xl bg-[#17191D]/80 border border-white/10 text-slate-300 font-medium">
              {project4.location}
            </span>
          </div>

          <div class="absolute bottom-4 left-5 right-5 text-white">
            <span class="font-mono text-xs uppercase tracking-wider text-[#FFAB78] block mb-1">
              Client: {project4.client}
            </span>
            <h3 class="font-display text-2xl sm:text-3xl font-extrabold text-white tracking-tight leading-tight group-hover:text-[#FFAB78] transition-colors">
              {project4.title}
            </h3>
          </div>
        </div>

        <div class="p-6 sm:p-8 space-y-4 bg-[#17191D]/90 flex-1 flex flex-col justify-between">
          <div class="space-y-3">
            <div class="flex items-center justify-between font-mono text-xs text-slate-400 pb-3 border-b border-white/5">
              <span>CLIENT: <strong class="text-white">{project4.client}</strong></span>
              <span class="text-emerald-400 font-semibold flex items-center gap-1.5">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                Verified Installation
              </span>
            </div>
            <p class="text-sm text-slate-300 leading-relaxed font-sans">
              {project4.scopeSummary}
            </p>
          </div>

          <div class="pt-4 border-t border-white/5 flex flex-wrap items-center justify-between gap-4">
            <div class="flex flex-wrap gap-1.5 font-mono text-[10px]">
              {project4.sectors.map((sec) => (
                <span class="px-2.5 py-1 rounded-lg bg-[#252A30] text-slate-300 border border-white/10">{sec}</span>
              ))}
            </div>
            <a 
              href={`/projects/${project4.id}`} 
              class="inline-flex items-center gap-2 text-xs font-mono font-bold text-[#F07842] hover:text-white transition-colors group/link"
            >
              <span>View Project Details</span>
              <Icon name="arrow-right" class="w-3.5 h-3.5 group-hover/link:translate-x-1 transition-transform" />
            </a>
          </div>
        </div>
      </article>
    )}

  </div>

  <!-- Prominent CTA: EXPLORE ALL PROJECTS → -->
  <div class="pt-6 sm:pt-10 text-center">
    <a 
      href="/projects" 
      class="inline-flex items-center justify-center gap-3 px-8 sm:px-10 py-4 sm:py-5 rounded-2xl bg-[#252A30] hover:bg-[#343A40] text-white font-display font-bold text-xs sm:text-sm tracking-widest uppercase border border-white/10 hover:border-[#C58461]/60 shadow-2xl transition-all duration-300 group"
    >
      <span>EXPLORE ALL PROJECTS</span>
      <span class="text-[#F07842] group-hover:translate-x-1.5 transition-transform duration-300 text-base font-bold">→</span>
    </a>
  </div>

</div>

