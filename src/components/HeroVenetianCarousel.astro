---
// Three engineering background images matching user specifications
const slides = [
  {
    id: 1,
    number: '01',
    src: '/images/hero-slide-1.jpg',
    title: 'Modern Commercial Building & HVAC Infrastructure',
    alt: 'Modern commercial building with integrated HVAC infrastructure'
  },
  {
    id: 2,
    number: '02',
    src: '/images/hero-slide-2.jpg',
    title: 'Contemporary Glass Commercial & Engineering Building',
    alt: 'Contemporary glass commercial and engineering building'
  },
  {
    id: 3,
    number: '03',
    src: '/images/hero-slide-3.jpg',
    title: 'Industrial Mechanical Plant Room & HVAC Pumps',
    alt: 'Industrial mechanical plant room with HVAC ducting, pumps and engineering infrastructure'
  }
];

const NUM_SLICES = 14;
const DISPLAY_DURATION = 5000; // 5 seconds display hold between transitions
const TRANSITION_DURATION = 2300; // Exactly 2.3 seconds transition duration
const SLICE_DELAY_STEP = 50; // 13 * 50ms = 650ms max delay
const SLICE_ANIM_DURATION = TRANSITION_DURATION - (NUM_SLICES - 1) * SLICE_DELAY_STEP; // 1650ms
---

<div 
  id="hero-venetian-carousel"
  class="absolute inset-0 z-0 overflow-hidden pointer-events-none select-none"
  aria-hidden="true"
>
  <!-- =========================================================================
       1. MOBILE SMOOTH CROSSFADE LAYER (< 768px)
       Guaranteed zero-flicker, lightweight hardware-accelerated opacity crossfade
       ========================================================================= -->
  <div class="mobile-carousel-layer block md:hidden absolute inset-0 w-full h-full pointer-events-none">
    {slides.map((slide, slideIdx) => (
      <div 
        class={`mobile-slide absolute inset-0 w-full h-full transition-opacity duration-1000 ease-in-out ${slideIdx === 0 ? 'opacity-100 z-10' : 'opacity-0 z-0'}`}
        data-mobile-slide-index={slideIdx}
      >
        <img
          src={slide.src}
          alt={slide.alt}
          class="w-full h-full object-cover object-center"
          loading="eager"
          decoding="async"
        />
      </div>
    ))}
  </div>

  <!-- =========================================================================
       2. DESKTOP 14-SLICE VENETIAN CAROUSEL LAYER (>= 768px)
       Retains full architectural cinematic Venetian wiping for desktop
       ========================================================================= -->
  <div class="desktop-carousel-layer hidden md:block absolute inset-0 w-full h-full pointer-events-none">
    {slides.map((slide, slideIdx) => (
      <div 
        class={`venetian-slide absolute inset-0 w-full h-full pointer-events-none ${slideIdx === 0 ? 'is-current' : 'is-idle'}`}
        data-slide-index={slideIdx}
      >
        {Array.from({ length: NUM_SLICES }).map((_, i) => {
          const sliceLeftPct = (i * 100) / NUM_SLICES;
          const sliceWidthPct = 100 / NUM_SLICES;

          return (
            <div
              class="venetian-slice absolute top-0 bottom-0 overflow-hidden pointer-events-none"
              style={`
                left: ${sliceLeftPct}%;
                width: ${sliceWidthPct}%;
                --slice-index: ${i};
                --slice-delay: ${i * SLICE_DELAY_STEP}ms;
                --slice-dur: ${SLICE_ANIM_DURATION}ms;
              `}
            >
              <!-- Masked Image Wrapper -->
              <div class="venetian-img-mask absolute inset-0 overflow-hidden">
                <img
                  class="venetian-slice-img absolute top-0 h-full max-w-none object-cover object-right sm:object-center transform-gpu"
                  src={slide.src}
                  alt={slide.alt}
                  style={`width: ${NUM_SLICES * 100}%; left: -${i * 100}%;`}
                  loading="eager"
                  decoding="async"
                />
              </div>
              <!-- Glowing Copper Shutter Blade -->
              <div class="shutter-blade absolute top-0 bottom-0 pointer-events-none" />
            </div>
          );
        })}
      </div>
    ))}
  </div>

  <!-- Slide Progression Indicator (Interactive & Visual Status) -->
  <div class="absolute bottom-16 sm:bottom-14 right-4 sm:right-12 z-20 pointer-events-auto flex items-center gap-2.5 sm:gap-3 font-mono text-[11px] sm:text-xs text-white/70 bg-[#111920]/80 backdrop-blur-md px-3 sm:px-3.5 py-1.5 rounded-full border border-[#252F38] shadow-lg">
    <span class="text-[#F07842] font-bold" id="carousel-current-num">01</span>
    <span class="text-white/30">/</span>
    <span class="text-white/50">03</span>
    <div class="flex items-center gap-1.5 ml-1">
      <button 
        type="button" 
        class="carousel-dot cursor-pointer p-0.5 group focus:outline-none" 
        data-slide-target="0" 
        aria-label="View slide 1"
      >
        <span class="carousel-dot-bar block w-5 sm:w-6 h-1 rounded-full bg-[#F07842] shadow-[0_0_8px_#F07842] transition-all duration-300"></span>
      </button>
      <button 
        type="button" 
        class="carousel-dot cursor-pointer p-0.5 group focus:outline-none" 
        data-slide-target="1" 
        aria-label="View slide 2"
      >
        <span class="carousel-dot-bar block w-2 h-1 rounded-full bg-white/30 hover:bg-white/60 transition-all duration-300"></span>
      </button>
      <button 
        type="button" 
        class="carousel-dot cursor-pointer p-0.5 group focus:outline-none" 
        data-slide-target="2" 
        aria-label="View slide 3"
      >
        <span class="carousel-dot-bar block w-2 h-1 rounded-full bg-white/30 hover:bg-white/60 transition-all duration-300"></span>
      </button>
    </div>
  </div>
</div>

<style is:global>
  /* Base state of desktop Venetian slides */
  .venetian-slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 1;
    pointer-events: none;
  }

  /* Current resting slide */
  .venetian-slide.is-current {
    z-index: 2;
  }
  .venetian-slide.is-current .venetian-img-mask {
    clip-path: inset(0 0% 0 0);
  }
  .venetian-slide.is-current .shutter-blade {
    opacity: 0;
    display: none;
  }

  /* Idle inactive slide */
  .venetian-slide.is-idle {
    z-index: 1;
  }
  .venetian-slide.is-idle .venetian-img-mask {
    clip-path: inset(0 100% 0 0);
  }
  .venetian-slide.is-idle .shutter-blade {
    opacity: 0;
    display: none;
  }

  /* Entering slide: active Venetian wipe transition (2.3s total) */
  .venetian-slide.is-entering {
    z-index: 10;
  }

  /* 14-Slice Progressive Wipe Keyframes */
  @keyframes venetianMaskReveal {
    0% {
      clip-path: inset(0 100% 0 0);
    }
    100% {
      clip-path: inset(0 0% 0 0);
    }
  }

  /* Copper Shutter Blade Sweep Keyframes */
  @keyframes shutterBladeSweep {
    0% {
      left: 0%;
      opacity: 0;
    }
    6% {
      opacity: 1;
    }
    90% {
      opacity: 1;
    }
    100% {
      left: 100%;
      opacity: 0;
    }
  }

  .venetian-slide.is-entering .venetian-img-mask {
    animation: venetianMaskReveal var(--slice-dur, 1650ms) cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: var(--slice-delay, 0ms);
    will-change: clip-path;
  }

  .venetian-slide.is-entering .shutter-blade {
    display: block;
    position: absolute;
    top: 0;
    bottom: 0;
    width: 3px;
    background: linear-gradient(180deg, rgba(240, 120, 66, 0.2) 0%, #F07842 30%, #FFAB78 50%, #F07842 70%, rgba(240, 120, 66, 0.2) 100%);
    box-shadow: 0 0 16px #F07842, 0 0 6px #FFAB78;
    animation: shutterBladeSweep var(--slice-dur, 1650ms) cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: var(--slice-delay, 0ms);
    will-change: left, opacity;
  }

  @media (prefers-reduced-motion: reduce) {
    .venetian-slide.is-entering .venetian-img-mask {
      animation: none !important;
      clip-path: inset(0 0% 0 0) !important;
    }
    .venetian-slide.is-entering .shutter-blade {
      display: none !important;
    }
    .venetian-slide {
      transition: opacity 0.8s ease;
    }
    .venetian-slide.is-idle {
      opacity: 0 !important;
    }
    .venetian-slide.is-current {
      opacity: 1 !important;
    }
  }
</style>

<script is:inline>
  (function initAlManarHeroCarousel() {
    function setupEngine() {
      const container = document.getElementById('hero-venetian-carousel');
      if (!container) return;

      if (container.__engineRunning) return;
      container.__engineRunning = true;

      const desktopSlides = Array.from(container.querySelectorAll('.venetian-slide'));
      const mobileSlides = Array.from(container.querySelectorAll('.mobile-slide'));

      const DISPLAY_DURATION = 5000; // 5s display duration
      const TRANSITION_DURATION = 2300; // 2.3s transition duration for desktop
      const MOBILE_TRANSITION_DURATION = 1000; // 1s smooth crossfade for mobile

      let currentIndex = 0;
      let isTransitioning = false;
      let timer = null;
      let isTabActive = true;

      const counterEl = document.getElementById('carousel-current-num');
      const dotButtons = Array.from(container.querySelectorAll('.carousel-dot'));

      // Preload images
      ['/images/hero-slide-1.jpg', '/images/hero-slide-2.jpg', '/images/hero-slide-3.jpg'].forEach(function(src) {
        const img = new Image();
        img.src = src;
      });

      function updateIndicators(index) {
        if (counterEl) {
          counterEl.textContent = '0' + (index + 1);
        }
        dotButtons.forEach(function(btn, i) {
          const bar = btn.querySelector('.carousel-dot-bar');
          if (!bar) return;
          if (i === index) {
            bar.className = 'carousel-dot-bar block w-5 sm:w-6 h-1 rounded-full bg-[#F07842] shadow-[0_0_8px_#F07842] transition-all duration-300';
          } else {
            bar.className = 'carousel-dot-bar block w-2 h-1 rounded-full bg-white/30 hover:bg-white/60 transition-all duration-300';
          }
        });
      }

      function transitionTo(nextIndex) {
        if (isTransitioning || nextIndex === currentIndex) return;
        isTransitioning = true;

        const isMobile = window.innerWidth < 768;

        if (isMobile && mobileSlides.length > 0) {
          // --- MOBILE SMOOTH CROSSFADE ---
          // Simple, clean opacity swap without reflows or clip-paths
          const currentMobSlide = mobileSlides[currentIndex];
          const nextMobSlide = mobileSlides[nextIndex];

          if (currentMobSlide && nextMobSlide) {
            nextMobSlide.classList.remove('opacity-0', 'z-0');
            nextMobSlide.classList.add('opacity-100', 'z-10');

            setTimeout(function() {
              currentMobSlide.classList.remove('opacity-100', 'z-10');
              currentMobSlide.classList.add('opacity-0', 'z-0');

              currentIndex = nextIndex;
              isTransitioning = false;
              scheduleNext();
            }, MOBILE_TRANSITION_DURATION);
          } else {
            currentIndex = nextIndex;
            isTransitioning = false;
            scheduleNext();
          }

          updateIndicators(nextIndex);
          return;
        }

        // --- DESKTOP 14-SLICE VENETIAN WIPE ---
        if (desktopSlides.length > 0) {
          const currentSlide = desktopSlides[currentIndex];
          const nextSlide = desktopSlides[nextIndex];

          if (currentSlide && nextSlide) {
            nextSlide.classList.remove('is-idle', 'is-current', 'is-entering');
            void nextSlide.offsetWidth;

            nextSlide.classList.add('is-entering');
            updateIndicators(nextIndex);

            setTimeout(function() {
              nextSlide.classList.remove('is-entering');
              nextSlide.classList.add('is-current');

              currentSlide.classList.remove('is-current', 'is-entering');
              currentSlide.classList.add('is-idle');

              currentIndex = nextIndex;
              isTransitioning = false;
              scheduleNext();
            }, TRANSITION_DURATION);
            return;
          }
        }

        currentIndex = nextIndex;
        isTransitioning = false;
        scheduleNext();
      }

      function advance() {
        if (!isTabActive || isTransitioning) return;
        const total = Math.max(desktopSlides.length, mobileSlides.length, 3);
        const nextIndex = (currentIndex + 1) % total;
        transitionTo(nextIndex);
      }

      function scheduleNext() {
        if (timer) clearTimeout(timer);
        timer = setTimeout(advance, DISPLAY_DURATION);
      }

      // Dot navigation
      dotButtons.forEach(function(btn) {
        btn.addEventListener('click', function(e) {
          e.preventDefault();
          const target = parseInt(btn.getAttribute('data-slide-target'), 10);
          if (!isNaN(target) && target !== currentIndex && !isTransitioning) {
            if (timer) clearTimeout(timer);
            transitionTo(target);
          }
        });
      });

      // Visibility change handler
      document.addEventListener('visibilitychange', function() {
        if (document.hidden) {
          isTabActive = false;
          if (timer) clearTimeout(timer);
        } else {
          isTabActive = true;
          if (!isTransitioning) {
            scheduleNext();
          }
        }
      });

      scheduleNext();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupEngine);
    } else {
      setupEngine();
    }

    document.addEventListener('astro:page-load', setupEngine);
  })();
</script>
