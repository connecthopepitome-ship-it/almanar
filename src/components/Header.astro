---
import Icon from './Icon.astro';
import { COMPANY, SERVICES } from '../data/company';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const navLinks = [
  { name: 'Home', href: '/' },
  { name: 'About Us', href: '/about' },
  { 
    name: 'Services', 
    href: '/services',
    hasDropdown: true,
    children: SERVICES.map(s => ({
      number: s.number,
      name: s.shortTitle,
      fullName: s.title,
      href: `/services/${s.slug}`,
      category: s.category
    }))
  },
  { name: 'Industries', href: '/industries' },
  { name: 'Projects', href: '/projects' },
  { name: 'Our Process', href: '/process' },
  { name: 'Contact', href: '/contact' }
];
---

<!-- Floating Architectural Glass Navigation (Strict Reference Match to Image 2) -->
<div class="sticky top-0 z-50 w-full px-3 sm:px-6 lg:px-8 pt-3 sm:pt-4 pb-2 transition-all duration-300 pointer-events-none" id="header-wrapper">
  <header 
    id="main-glass-header"
    class="max-w-7xl mx-auto glass-nav-copper rounded-2xl sm:rounded-3xl pointer-events-auto transition-all duration-300"
  >
    <div class="px-4 sm:px-6 lg:px-8 flex items-center justify-between h-18 sm:h-20 transition-all duration-300" id="header-inner">
      
      <!-- Brand Identity (Strict Reference Match) -->
      <a href="/" class="flex items-center gap-3.5 group focus:outline-none focus-visible:ring-2 focus-visible:ring-[#F07842] rounded-xl p-1" aria-label="Al Manar Tech Home">
        <div class="w-10 h-10 sm:w-11 sm:h-11 bg-white rounded-xl p-1.5 shadow-sm flex items-center justify-center border border-white/10 group-hover:border-[#F07842]/60 transition-colors">
          <img 
            src="/images/original/Logo-Al-Manar-1-1024x1024.png" 
            alt="Al Manar Tech Official Logo" 
            class="w-full h-full object-contain"
            width="44"
            height="44"
          />
        </div>
        <div class="flex flex-col">
          <span class="text-base sm:text-lg font-extrabold tracking-tight text-white font-display leading-tight group-hover:text-[#F07842] transition-colors">
            AL MANAR <span class="text-[#F07842]">TECH</span>
          </span>
          <span class="text-[9px] font-mono tracking-widest uppercase text-[#A8B0BA] font-semibold">
            INFRASTRUCTURE CONTRACTING
          </span>
        </div>
      </a>

      <!-- Desktop Links (Clean White Typography + Copper Active Underline) -->
      <nav class="hidden lg:flex items-center gap-1 font-display" aria-label="Main Navigation">
        {navLinks.map((link) => {
          const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
          
          if (link.hasDropdown) {
            return (
              <div class="relative group py-2">
                <button 
                  type="button" 
                  class={`inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl text-sm font-semibold tracking-tight transition-all duration-200 ${
                    isActive 
                      ? 'text-[#F07842]' 
                      : 'text-white hover:text-[#FFAB78] hover:bg-white/5'
                  }`}
                  aria-expanded="false"
                >
                  <span>{link.name}</span>
                  <Icon name="chevron-down" class="w-3.5 h-3.5 text-[#A8B0BA] group-hover:text-[#F07842] transition-transform duration-200 group-hover:rotate-180" />
                </button>

                <!-- Glass Dropdown Panel -->
                <div class="absolute left-0 top-full w-88 bg-[#17232D]/95 backdrop-blur-xl border border-white/12 rounded-2xl shadow-2xl py-3 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 translate-y-2 group-hover:translate-y-0 z-50">
                  <div class="px-5 py-2 border-b border-white/10 text-[10px] font-mono font-bold uppercase tracking-widest text-[#F07842] flex items-center justify-between">
                    <span>Engineering Divisions</span>
                    <span class="text-[#A8B0BA]">06 DIVISIONS</span>
                  </div>
                  <div class="py-2">
                    {link.children?.map((child) => (
                      <a 
                        href={child.href}
                        class="flex items-center justify-between px-5 py-2.5 hover:bg-white/5 transition-colors group/item"
                      >
                        <div class="flex items-center gap-3">
                          <span class="font-mono text-xs text-[#A8B0BA] group-hover/item:text-[#F07842] font-bold">
                            {child.number}
                          </span>
                          <span class="text-sm font-bold text-slate-200 group-hover/item:text-white font-display">
                            {child.name}
                          </span>
                        </div>
                        <Icon name="arrow-right" class="w-3 h-3 text-[#A8B0BA] group-hover/item:text-[#F07842] transition-transform group-hover/item:translate-x-1" />
                      </a>
                    ))}
                  </div>
                  <div class="mt-2 pt-2 border-t border-white/10 px-5">
                    <a href="/services" class="font-mono text-xs text-[#F07842] hover:text-[#FFAB78] font-bold flex items-center gap-1.5 py-1">
                      <span>View All Services Breakdown</span>
                      <Icon name="arrow-right" class="w-3.5 h-3.5" />
                    </a>
                  </div>
                </div>
              </div>
            );
          }

          return (
            <a 
              href={link.href}
              class={`px-3.5 py-2 rounded-xl text-sm font-semibold tracking-tight transition-all duration-200 relative group/link ${
                isActive 
                  ? 'text-[#F07842]' 
                  : 'text-white hover:text-[#FFAB78] hover:bg-white/5'
              }`}
            >
              <span>{link.name}</span>
              {isActive && (
                <span class="absolute bottom-1 left-3.5 right-3.5 h-[2px] bg-[#F07842] rounded-full"></span>
              )}
            </a>
          );
        })}
      </nav>

      <!-- Desktop Header Magnetic Copper CTA (Strict Reference Match) -->
      <div class="hidden lg:flex items-center gap-4">
        <a 
          href="/contact" 
          data-magnetic="true"
          class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl text-xs font-display font-bold uppercase tracking-wider bg-[#F07842] text-[#111920] hover:bg-[#D96532] shadow-lg shadow-[#F07842]/25 transition-all duration-200"
        >
          <span>DISCUSS PROJECT</span>
          <Icon name="arrow-right" class="w-3.5 h-3.5" />
        </a>
      </div>

      <!-- Mobile Menu Toggle Button -->
      <div class="flex items-center gap-2 lg:hidden">
        <a 
          href="tel:025829700" 
          class="p-2 rounded-xl bg-[#17232D]/80 text-[#F07842] border border-white/10"
          aria-label="Call Al Manar Tech"
        >
          <Icon name="phone" class="w-5 h-5" />
        </a>
        <button 
          id="mobile-menu-toggle"
          type="button" 
          class="p-2.5 rounded-xl bg-[#17232D]/80 text-slate-200 border border-white/10 hover:text-white focus:outline-none focus:ring-2 focus:ring-[#F07842]"
          aria-label="Toggle Mobile Navigation Menu"
          aria-expanded="false"
        >
          <Icon name="menu" class="w-6 h-6 block menu-open-icon" />
          <Icon name="x" class="w-6 h-6 hidden menu-close-icon" />
        </button>
      </div>

    </div>

    <!-- Mobile Drawer Navigation -->
    <div id="mobile-menu" class="lg:hidden hidden bg-[#17232D]/98 backdrop-blur-xl rounded-b-2xl px-5 pt-3 pb-8 max-h-[85vh] overflow-y-auto border-t border-white/10">
      <div class="space-y-1 font-display">
        {navLinks.map((link) => {
          const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
          
          if (link.hasDropdown) {
            return (
              <div class="py-2 border-b border-white/10">
                <div class="flex items-center justify-between px-2 py-2 text-white font-bold text-base">
                  <span>{link.name}</span>
                  <a href={link.href} class="font-mono text-xs text-[#F07842]">Overview</a>
                </div>
                <div class="pl-3 pr-1 py-1 space-y-1 font-sans">
                  {link.children?.map((child) => (
                    <a 
                      href={child.href}
                      class="block px-3 py-2 rounded-lg text-sm text-[#D5D9DF] hover:text-[#F07842] hover:bg-white/5"
                    >
                      <span class="font-mono text-xs text-[#F07842] mr-2">{child.number}</span>
                      {child.fullName}
                    </a>
                  ))}
                </div>
              </div>
            );
          }

          return (
            <a 
              href={link.href}
              class={`block px-3 py-2.5 rounded-xl text-base font-bold ${
                isActive ? 'text-[#F07842] bg-white/10' : 'text-slate-200 hover:bg-white/5'
              }`}
            >
              {link.name}
            </a>
          );
        })}
      </div>

      <!-- Mobile Drawer Contact & Action -->
      <div class="mt-6 pt-5 border-t border-white/10 space-y-4 font-mono text-xs">
        <div class="space-y-2 text-[#D5D9DF]">
          <div class="flex items-center gap-2">
            <span class="text-[#F07842]">TEL:</span>
            <a href="tel:025829700" class="hover:text-[#F07842] text-white font-bold">02-5829700</a>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-[#F07842]">MAIL:</span>
            <a href="mailto:info@almanartech.com" class="hover:text-[#F07842] text-white">info@almanartech.com</a>
          </div>
        </div>

        <a 
          href="/contact" 
          class="w-full inline-flex items-center justify-center gap-2 px-5 py-3.5 rounded-xl font-display text-sm font-bold bg-[#F07842] text-[#111920] hover:bg-[#D96532] shadow-lg shadow-[#F07842]/20"
        >
          <span>DISCUSS YOUR PROJECT</span>
          <Icon name="arrow-right" class="w-4 h-4" />
        </a>
      </div>
    </div>
  </header>
</div>

<script>
  // Scroll-based compact glass transformation
  const header = document.getElementById('main-glass-header');
  const inner = document.getElementById('header-inner');

  if (header && inner) {
    window.addEventListener('scroll', () => {
      if (window.scrollY > 40) {
        header.classList.add('shadow-2xl');
        inner.classList.remove('h-20');
        inner.classList.add('h-16');
      } else {
        header.classList.remove('shadow-2xl');
        inner.classList.add('h-20');
        inner.classList.remove('h-16');
      }
    }, { passive: true });
  }

  // Mobile menu toggle
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const openIcon = document.querySelector('.menu-open-icon');
  const closeIcon = document.querySelector('.menu-close-icon');

  if (toggleBtn && mobileMenu) {
    toggleBtn.addEventListener('click', () => {
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      toggleBtn.setAttribute('aria-expanded', (!isExpanded).toString());
      mobileMenu.classList.toggle('hidden');
      if (openIcon && closeIcon) {
        openIcon.classList.toggle('hidden');
        closeIcon.classList.toggle('hidden');
      }
    });
  }
</script>
