---
import Icon from './Icon.astro';
import { COMPANY, SERVICES } from '../data/company';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const navLinks = [
  { name: 'Home', href: '/' },
  { name: 'About Us', href: '/about' },
  { 
    name: 'Services', 
    href: '/services',
    hasDropdown: true,
    children: SERVICES.map(s => ({
      name: s.shortTitle,
      fullName: s.title,
      href: `/services/${s.slug}`,
      category: s.category
    }))
  },
  { name: 'Industries', href: '/industries' },
  { name: 'Projects', href: '/projects' },
  { name: 'Our Process', href: '/process' },
  { name: 'Contact', href: '/contact' }
];
---

<!-- Top Contact & Authority Bar -->
<div class="bg-navy-950 border-b border-navy-800 text-slate-custom text-xs py-2 px-4 sm:px-6 lg:px-8">
  <div class="max-w-7xl mx-auto flex flex-col md:flex-row items-center justify-between gap-2">
    <!-- Left: Contact info -->
    <div class="flex flex-wrap items-center justify-center md:justify-start gap-4 sm:gap-6 text-slate-300">
      <a href={`tel:${COMPANY.contact.phone.replace(/[^0-9]/g, '')}`} class="inline-flex items-center gap-1.5 hover:text-gold-500 transition-colors">
        <Icon name="phone" class="w-3.5 h-3.5 text-gold-500" />
        <span class="font-medium">{COMPANY.contact.phone}</span>
      </a>
      <a href={`mailto:${COMPANY.contact.email}`} class="inline-flex items-center gap-1.5 hover:text-gold-500 transition-colors">
        <Icon name="mail" class="w-3.5 h-3.5 text-gold-500" />
        <span>{COMPANY.contact.email}</span>
      </a>
      <span class="hidden lg:inline-flex items-center gap-1.5 text-slate-400">
        <Icon name="map-pin" class="w-3.5 h-3.5 text-gold-500" />
        <span>Musaffah M35, Abu Dhabi, UAE</span>
      </span>
      <span class="hidden xl:inline-flex items-center gap-1.5 text-slate-400">
        <Icon name="clock" class="w-3.5 h-3.5 text-gold-500" />
        <span>Mon–Sat 09:00 – 18:00</span>
      </span>
    </div>

    <!-- Right: Verified Licensures & Accreditations -->
    <div class="flex items-center gap-2 sm:gap-3 text-[11px]">
      <span class="px-2 py-0.5 rounded bg-navy-800 border border-navy-700 text-slate-300 font-medium tracking-wide">
        ADDC Approved
      </span>
      <span class="px-2 py-0.5 rounded bg-navy-800 border border-navy-700 text-slate-300 font-medium tracking-wide">
        ADM Recognized
      </span>
      <span class="hidden sm:inline-block px-2 py-0.5 rounded bg-navy-800 border border-navy-700 text-slate-300 font-medium tracking-wide">
        Est. 2001
      </span>
    </div>
  </div>
</div>

<!-- Main Sticky Header -->
<header id="main-header" class="sticky top-0 z-50 bg-navy-900/95 backdrop-blur-md border-b border-navy-800/80 transition-all duration-300 shadow-md">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Logo Branding -->
      <a href="/" class="flex items-center gap-3 group focus:outline-none focus-visible:ring-2 focus-visible:ring-gold-500 rounded-lg p-1" aria-label="Al Manar Tech Home">
        <div class="w-12 h-12 bg-white rounded-lg p-1.5 shadow-sm flex items-center justify-center border border-navy-700 group-hover:border-gold-500/50 transition-colors">
          <img 
            src="/images/original/Logo-Al-Manar-1-1024x1024.png" 
            alt="Al Manar Tech Official Logo" 
            class="w-full h-full object-contain"
            width="48"
            height="48"
          />
        </div>
        <div class="flex flex-col">
          <span class="text-xl font-extrabold tracking-tight text-white font-heading leading-tight group-hover:text-gold-400 transition-colors">
            AL MANAR <span class="text-gold-500">TECH</span>
          </span>
          <span class="text-[10px] tracking-wider uppercase text-slate-400 font-semibold">
            Engineering & Infrastructure
          </span>
        </div>
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden lg:flex items-center gap-1 xl:gap-2" aria-label="Main Navigation">
        {navLinks.map((link) => {
          const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
          
          if (link.hasDropdown) {
            return (
              <div class="relative group py-2">
                <button 
                  type="button" 
                  class={`inline-flex items-center gap-1.5 px-3 py-2 rounded-md text-sm font-medium transition-colors ${
                    isActive ? 'text-gold-500 bg-navy-800/60' : 'text-slate-200 hover:text-white hover:bg-navy-800/40'
                  }`}
                  aria-expanded="false"
                >
                  <span>{link.name}</span>
                  <Icon name="chevron-down" class="w-4 h-4 text-slate-400 group-hover:text-gold-500 transition-transform duration-200 group-hover:rotate-180" />
                </button>

                <!-- Dropdown Menu -->
                <div class="absolute left-0 top-full w-80 bg-navy-950 border border-navy-700/80 rounded-xl shadow-2xl py-3 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 translate-y-2 group-hover:translate-y-0 z-50">
                  <div class="px-4 py-2 border-b border-navy-800 text-[11px] font-semibold uppercase tracking-wider text-gold-500">
                    Engineering Divisions
                  </div>
                  <div class="py-1">
                    {link.children?.map((child) => (
                      <a 
                        href={child.href}
                        class="flex flex-col px-4 py-2.5 hover:bg-navy-800/70 transition-colors group/item"
                      >
                        <span class="text-sm font-medium text-slate-200 group-hover/item:text-gold-400 flex items-center justify-between">
                          {child.fullName}
                          <Icon name="chevron-right" class="w-3.5 h-3.5 opacity-0 -translate-x-1 group-hover/item:opacity-100 group-hover/item:translate-x-0 transition-all text-gold-500" />
                        </span>
                        <span class="text-[11px] text-slate-400 font-normal">
                          {child.category}
                        </span>
                      </a>
                    ))}
                  </div>
                  <div class="mt-2 pt-2 border-t border-navy-800 px-4">
                    <a href="/services" class="text-xs text-gold-500 hover:text-gold-400 font-semibold flex items-center gap-1">
                      <span>View All Services</span>
                      <Icon name="arrow-right" class="w-3.5 h-3.5" />
                    </a>
                  </div>
                </div>
              </div>
            );
          }

          return (
            <a 
              href={link.href}
              class={`px-3 py-2 rounded-md text-sm font-medium transition-colors ${
                isActive ? 'text-gold-500 bg-navy-800/60 font-semibold' : 'text-slate-200 hover:text-white hover:bg-navy-800/40'
              }`}
            >
              {link.name}
            </a>
          );
        })}
      </nav>

      <!-- Desktop Header CTA -->
      <div class="hidden lg:flex items-center gap-3">
        <a 
          href="/contact" 
          class="inline-flex items-center justify-center px-4 py-2.5 rounded-lg text-sm font-semibold bg-gold-500 text-navy-950 hover:bg-gold-400 shadow-sm transition-all duration-200 hover:shadow-gold-glow"
        >
          <span>Discuss Your Project</span>
          <Icon name="arrow-right" class="w-4 h-4 ml-1.5" />
        </a>
      </div>

      <!-- Mobile Menu Toggle Button -->
      <div class="flex items-center gap-2 lg:hidden">
        <a 
          href="tel:025829700" 
          class="p-2 rounded-lg bg-navy-800 text-gold-500 hover:bg-navy-700"
          aria-label="Call Al Manar Tech"
        >
          <Icon name="phone" class="w-5 h-5" />
        </a>
        <button 
          id="mobile-menu-toggle"
          type="button" 
          class="p-2.5 rounded-lg bg-navy-800 text-slate-200 hover:text-white hover:bg-navy-700 focus:outline-none focus:ring-2 focus:ring-gold-500"
          aria-label="Toggle Mobile Navigation Menu"
          aria-expanded="false"
        >
          <Icon name="menu" class="w-6 h-6 block menu-open-icon" />
          <Icon name="x" class="w-6 h-6 hidden menu-close-icon" />
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Drawer Navigation -->
  <div id="mobile-menu" class="lg:hidden hidden bg-navy-950 border-b border-navy-800 px-4 pt-3 pb-6 max-h-[85vh] overflow-y-auto">
    <div class="space-y-1">
      {navLinks.map((link) => {
        const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
        
        if (link.hasDropdown) {
          return (
            <div class="py-1">
              <div class="flex items-center justify-between px-3 py-2 text-slate-200 font-semibold text-base border-b border-navy-800/60">
                <span>{link.name}</span>
                <a href={link.href} class="text-xs text-gold-500 font-normal">All Overview</a>
              </div>
              <div class="pl-4 pr-2 py-2 space-y-1">
                {link.children?.map((child) => (
                  <a 
                    href={child.href}
                    class="block px-3 py-2 rounded-md text-sm text-slate-300 hover:text-gold-400 hover:bg-navy-900"
                  >
                    {child.fullName}
                  </a>
                ))}
              </div>
            </div>
          );
        }

        return (
          <a 
            href={link.href}
            class={`block px-3 py-2.5 rounded-lg text-base font-medium ${
              isActive ? 'text-gold-500 bg-navy-800/80 font-semibold' : 'text-slate-200 hover:bg-navy-900'
            }`}
          >
            {link.name}
          </a>
        );
      })}
    </div>

    <!-- Mobile Drawer Contact & Action -->
    <div class="mt-6 pt-5 border-t border-navy-800 space-y-4">
      <div class="space-y-2 text-sm text-slate-300">
        <div class="flex items-center gap-2">
          <Icon name="phone" class="w-4 h-4 text-gold-500" />
          <a href="tel:025829700" class="hover:text-gold-400">02-5829700</a>
        </div>
        <div class="flex items-center gap-2">
          <Icon name="mail" class="w-4 h-4 text-gold-500" />
          <a href="mailto:info@almanartech.com" class="hover:text-gold-400">info@almanartech.com</a>
        </div>
        <div class="flex items-start gap-2 text-xs text-slate-400">
          <Icon name="map-pin" class="w-4 h-4 text-gold-500 shrink-0 mt-0.5" />
          <span>Warehouse 2, Al Afou 3St, Musaffah M35, Abu Dhabi</span>
        </div>
      </div>

      <a 
        href="/contact" 
        class="w-full inline-flex items-center justify-center px-5 py-3 rounded-lg text-sm font-bold bg-gold-500 text-navy-950 hover:bg-gold-400 transition-colors shadow-md"
      >
        <span>Request Project Quotation</span>
        <Icon name="arrow-right" class="w-4 h-4 ml-2" />
      </a>
    </div>
  </div>
</header>

<script>
  // Mobile menu toggle handling
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const openIcon = document.querySelector('.menu-open-icon');
  const closeIcon = document.querySelector('.menu-close-icon');

  if (toggleBtn && mobileMenu) {
    toggleBtn.addEventListener('click', () => {
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      toggleBtn.setAttribute('aria-expanded', (!isExpanded).toString());
      mobileMenu.classList.toggle('hidden');
      if (openIcon && closeIcon) {
        openIcon.classList.toggle('hidden');
        closeIcon.classList.toggle('hidden');
      }
    });
  }
</script>
