---
import Icon from './Icon.astro';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const isHome = currentPath === '/';
const isServices = currentPath.startsWith('/services');
const isProjects = currentPath.startsWith('/projects');
---

<!-- =========================================================================
     AL MANAR TECH — NATIVE MOBILE WEB APP FLOATING DOCK (BOTTOM NAVIGATION)
     ========================================================================= -->
<nav 
  class="lg:hidden fixed bottom-3 left-3 right-3 z-40 max-w-md mx-auto pointer-events-auto select-none"
  aria-label="Mobile Bottom App Navigation"
>
  <div class="glass-dock rounded-2xl sm:rounded-3xl p-1.5 px-3 flex items-center justify-between border border-white/12 shadow-[0_12px_40px_rgba(0,0,0,0.7)] backdrop-blur-2xl bg-[#111920]/90">
    
    <!-- 1. Home Tab -->
    <a 
      href="/" 
      class={`flex flex-col items-center justify-center py-1.5 px-3 rounded-xl transition-all active:scale-90 ${
        isHome ? 'text-[#F07842] font-bold' : 'text-slate-400 hover:text-white'
      }`}
      aria-current={isHome ? 'page' : undefined}
    >
      <Icon name="grid" class="w-5 h-5 mb-0.5" />
      <span class="text-[10px] font-sans tracking-tight">Home</span>
      {isHome && <span class="w-1 h-1 rounded-full bg-[#F07842] mt-0.5"></span>}
    </a>

    <!-- 2. Services / Divisions Tab -->
    <a 
      href="/services" 
      class={`flex flex-col items-center justify-center py-1.5 px-3 rounded-xl transition-all active:scale-90 ${
        isServices ? 'text-[#F07842] font-bold' : 'text-slate-400 hover:text-white'
      }`}
      aria-current={isServices ? 'page' : undefined}
    >
      <Icon name="layers" class="w-5 h-5 mb-0.5" />
      <span class="text-[10px] font-sans tracking-tight">Divisions</span>
      {isServices && <span class="w-1 h-1 rounded-full bg-[#F07842] mt-0.5"></span>}
    </a>

    <!-- 3. Projects Tab -->
    <a 
      href="/projects" 
      class={`flex flex-col items-center justify-center py-1.5 px-3 rounded-xl transition-all active:scale-90 ${
        isProjects ? 'text-[#F07842] font-bold' : 'text-slate-400 hover:text-white'
      }`}
      aria-current={isProjects ? 'page' : undefined}
    >
      <Icon name="shield-check" class="w-5 h-5 mb-0.5" />
      <span class="text-[10px] font-sans tracking-tight">Projects</span>
      {isProjects && <span class="w-1 h-1 rounded-full bg-[#F07842] mt-0.5"></span>}
    </a>

    <!-- 4. Direct Call Desk Tab -->
    <a 
      href="tel:025829700" 
      class="flex flex-col items-center justify-center py-1.5 px-3 rounded-xl text-slate-400 hover:text-white transition-all active:scale-90"
      aria-label="Call Estimating Desk directly"
    >
      <Icon name="phone" class="w-5 h-5 mb-0.5 text-emerald-400" />
      <span class="text-[10px] font-sans tracking-tight">Call Desk</span>
    </a>

    <!-- 5. Client Portal / Quick Tender (Featured Elevated Pill) -->
    <button 
      type="button"
      data-open-portal="true"
      data-portal-mode="track"
      class="flex flex-col items-center justify-center py-1.5 px-3 rounded-xl bg-gradient-to-r from-[#F07842] to-[#D96532] text-[#111920] font-display font-bold shadow-md shadow-[#F07842]/25 active:scale-90 transition-all cursor-pointer"
      aria-label="Open Client & Tender Portal"
    >
      <div class="flex items-center gap-1">
        <Icon name="award" class="w-4 h-4 text-[#111920]" />
        <span class="text-[10.5px] tracking-wide uppercase">Portal</span>
      </div>
      <span class="text-[8px] font-mono tracking-tighter uppercase opacity-80 leading-none">Login / Track</span>
    </button>

  </div>
</nav>

<style>
  .glass-dock {
    backdrop-filter: blur(24px) saturate(180%);
    -webkit-backdrop-filter: blur(24px) saturate(180%);
  }
</style>

