---
import Icon from './Icon.astro';
import { VERIFIED_PROJECTS } from '../data/company';

// 5 premier landmark installations with authentic photography
const showcaseProjects = [
  VERIFIED_PROJECTS.find(p => p.id === 'yas-waterworld') || VERIFIED_PROJECTS[1],
  VERIFIED_PROJECTS.find(p => p.id === 'aldar-academies-hq') || VERIFIED_PROJECTS[0],
  VERIFIED_PROJECTS.find(p => p.id === 'emirates-nbd-bank') || VERIFIED_PROJECTS[3],
  VERIFIED_PROJECTS.find(p => p.id === 'puma-outlet-showroom') || VERIFIED_PROJECTS[2],
  VERIFIED_PROJECTS.find(p => p.id === 'katrina-sweets') || VERIFIED_PROJECTS[4],
].filter(Boolean);
---

<section id="featured-projects-showcase" class="relative py-20 lg:py-28 bg-navy-950 text-white border-b border-navy-800">
  
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Header with Designed Composition & Intuitive Navigation Controls -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 pb-8 border-b border-white/5">
      <div class="space-y-3">
        <div class="inline-flex items-center gap-2 font-mono text-xs text-amber-brand font-bold tracking-widest uppercase px-3 py-1 rounded-full glass-panel-amber">
          <span class="w-1.5 h-1.5 rounded-full bg-amber-brand animate-ping"></span>
          <span>04 // FEATURED LANDMARK INSTALLATIONS</span>
        </div>
        <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight">
          Landmark Showcase.<br/>
          <span class="text-metallic-amber">PRECISION AT SCALE.</span>
        </h2>
      </div>

      <!-- Carousel Navigation Controls & Live Counter -->
      <div class="flex items-center gap-4">
        <div class="font-mono text-xs text-slate-400 bg-navy-900 border border-white/10 px-3.5 py-2 rounded-xl flex items-center gap-2">
          <span class="text-amber-brand">SLIDE</span>
          <span id="proj-current-index" class="font-bold text-white">01</span>
          <span class="text-slate-600">/</span>
          <span class="text-slate-400">05</span>
        </div>

        <div class="flex items-center gap-2">
          <button 
            type="button" 
            id="proj-prev-btn" 
            class="w-10 h-10 rounded-xl glass-panel-navy text-slate-300 hover:text-white hover:border-amber-brand/50 flex items-center justify-center transition-all duration-200 active:scale-95"
            aria-label="Previous project slide"
          >
            <Icon name="arrow-left" class="w-4 h-4" />
          </button>
          <button 
            type="button" 
            id="proj-next-btn" 
            class="w-10 h-10 rounded-xl bg-amber-brand text-navy-950 font-bold hover:bg-amber-glow shadow-glass-amber flex items-center justify-center transition-all duration-200 active:scale-95"
            aria-label="Next project slide"
          >
            <Icon name="arrow-right" class="w-4 h-4" />
          </button>
        </div>
      </div>
    </div>

    <!-- Intuitive Horizontal Swipe / Scroll Carousel -->
    <div class="relative mt-10">
      
      <div 
        id="projects-carousel-track" 
        class="flex gap-6 overflow-x-auto scroll-smooth snap-x snap-mandatory pb-6 px-1 scrollbar-none"
        tabindex="0"
        role="region"
        aria-label="Featured Projects Carousel"
      >
        {showcaseProjects.map((proj, idx) => (
          <div 
            class="project-carousel-slide w-[86vw] sm:w-[540px] lg:w-[620px] shrink-0 snap-center group glass-panel-navy rounded-3xl overflow-hidden shadow-glass-floating flex flex-col justify-between border border-white/10 transition-transform duration-300 hover:-translate-y-1"
            data-index={idx + 1}
            data-cursor="view"
          >
            <!-- Photographic Frame (Clean 16:10 Ratio, No Clipping) -->
            <div class="relative aspect-[16/10] overflow-hidden bg-navy-900">
              <img 
                src={proj.image} 
                alt={`${proj.title} - ${proj.client}`}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-navy-950 via-navy-950/25 to-transparent"></div>

              <!-- Top Tags -->
              <div class="absolute top-4 left-4 flex flex-wrap items-center gap-2">
                <span class="px-3 py-1 rounded-xl glass-panel-amber font-mono text-[10px] font-bold text-amber-brand border border-amber-brand/30">
                  LANDMARK // 0{idx + 1}
                </span>
                <span class="px-3 py-1 rounded-xl glass-panel-navy font-mono text-[10px] text-slate-200 border border-white/10">
                  {proj.location}
                </span>
              </div>

              <!-- Bottom Heading on Image -->
              <div class="absolute bottom-4 left-4 right-4 text-white">
                <span class="font-mono text-[10px] uppercase tracking-wider text-amber-brand block mb-1">
                  {proj.category}
                </span>
                <h3 class="font-display text-xl sm:text-2xl font-extrabold text-white tracking-tight leading-tight group-hover:text-amber-brand transition-colors">
                  {proj.title}
                </h3>
              </div>
            </div>

            <!-- Descriptive Metadata HUD -->
            <div class="p-6 sm:p-7 space-y-4 bg-navy-950/90 font-sans flex-1 flex flex-col justify-between">
              <div class="space-y-3">
                <div class="flex items-center justify-between font-mono text-xs text-slate-400 border-b border-white/5 pb-2.5">
                  <div>
                    <span class="text-slate-500">CLIENT:</span>
                    <strong class="text-white ml-1.5">{proj.client}</strong>
                  </div>
                  <div class="text-emerald-400 font-semibold flex items-center gap-1.5 text-[11px]">
                    <Icon name="check-circle" class="w-3.5 h-3.5" />
                    <span>Verified Facility</span>
                  </div>
                </div>

                <p class="text-xs sm:text-sm text-slate-300 leading-relaxed line-clamp-2">
                  {proj.scopeSummary}
                </p>
              </div>

              <div class="pt-3 border-t border-white/5 flex flex-wrap items-center justify-between gap-3 font-mono text-xs">
                <div class="flex flex-wrap gap-1.5">
                  {proj.sectors.map((sec) => (
                    <span class="px-2 py-0.5 rounded bg-navy-900 border border-white/10 text-slate-300 text-[10px]">
                      {sec}
                    </span>
                  ))}
                </div>

                <a 
                  href="/contact" 
                  data-magnetic="true"
                  class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-amber-brand text-navy-950 font-bold hover:bg-amber-glow shadow-glass-amber transition-all text-xs"
                >
                  <span>Request Scope</span>
                  <Icon name="arrow-right" class="w-3.5 h-3.5" />
                </a>
              </div>
            </div>

          </div>
        ))}
      </div>

      <!-- Quick Dot Indicators for Direct Jumps -->
      <div class="flex items-center justify-center gap-2 pt-6">
        {showcaseProjects.map((_, idx) => (
          <button 
            type="button" 
            class={`carousel-dot w-2.5 h-2.5 rounded-full transition-all duration-300 ${
              idx === 0 ? 'w-8 bg-amber-brand' : 'bg-white/20 hover:bg-white/40'
            }`}
            data-target-index={idx}
            aria-label={`Go to slide ${idx + 1}`}
          />
        ))}
      </div>

    </div>

  </div>

</section>

<script>
  function setupProjectsCarousel() {
    const track = document.getElementById('projects-carousel-track');
    const prevBtn = document.getElementById('proj-prev-btn');
    const nextBtn = document.getElementById('proj-next-btn');
    const indexDisplay = document.getElementById('proj-current-index');
    const dots = document.querySelectorAll('.carousel-dot');

    if (!track) return;

    const slides = track.querySelectorAll('.project-carousel-slide');

    const updateActiveIndicator = () => {
      const scrollLeft = track.scrollLeft;
      const slideWidth = slides[0] ? (slides[0] as HTMLElement).offsetWidth + 24 : 500;
      const currentIndex = Math.round(scrollLeft / slideWidth);

      if (indexDisplay) {
        indexDisplay.textContent = `0${Math.min(slides.length, Math.max(1, currentIndex + 1))}`;
      }

      dots.forEach((dot, idx) => {
        if (idx === currentIndex) {
          dot.className = 'carousel-dot w-8 h-2.5 rounded-full bg-amber-brand transition-all duration-300';
        } else {
          dot.className = 'carousel-dot w-2.5 h-2.5 rounded-full bg-white/20 hover:bg-white/40 transition-all duration-300';
        }
      });
    };

    if (prevBtn) {
      prevBtn.addEventListener('click', () => {
        const slideWidth = slides[0] ? (slides[0] as HTMLElement).offsetWidth + 24 : 500;
        track.scrollBy({ left: -slideWidth, behavior: 'smooth' });
      });
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', () => {
        const slideWidth = slides[0] ? (slides[0] as HTMLElement).offsetWidth + 24 : 500;
        track.scrollBy({ left: slideWidth, behavior: 'smooth' });
      });
    }

    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        const targetIdx = parseInt(dot.getAttribute('data-target-index') || '0', 10);
        const slideWidth = slides[0] ? (slides[0] as HTMLElement).offsetWidth + 24 : 500;
        track.scrollTo({ left: targetIdx * slideWidth, behavior: 'smooth' });
      });
    });

    track.addEventListener('scroll', updateActiveIndicator, { passive: true });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupProjectsCarousel);
  } else {
    setupProjectsCarousel();
  }
</script>
