---
import Icon from './Icon.astro';
import { VERIFIED_PROJECTS } from '../data/company';

// 5 premier landmark installations with authentic photography
const showcaseProjects = [
  VERIFIED_PROJECTS.find(p => p.id === 'yas-waterworld') || VERIFIED_PROJECTS[1],
  VERIFIED_PROJECTS.find(p => p.id === 'aldar-academies-hq') || VERIFIED_PROJECTS[0],
  VERIFIED_PROJECTS.find(p => p.id === 'emirates-nbd-bank') || VERIFIED_PROJECTS[3],
  VERIFIED_PROJECTS.find(p => p.id === 'puma-outlet-showroom') || VERIFIED_PROJECTS[2],
  VERIFIED_PROJECTS.find(p => p.id === 'katrina-sweets') || VERIFIED_PROJECTS[4],
].filter(Boolean);

// Duplicate list for infinite, seamless loop
const duplicatedProjects = [...showcaseProjects, ...showcaseProjects];
---

<section id="featured-projects-showcase" class="relative py-14 lg:py-20 bg-navy-950 text-white border-b border-navy-800 overflow-hidden">
  
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-8">
    
    <!-- Compact Header with Continuous Auto-Scroll Indicator -->
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 pb-6 border-b border-white/5">
      <div class="space-y-2">
        <div class="inline-flex items-center gap-2 font-mono text-[11px] text-amber-brand font-bold tracking-widest uppercase px-3 py-1 rounded-full glass-panel-amber">
          <span class="w-1.5 h-1.5 rounded-full bg-amber-brand animate-ping"></span>
          <span>04 // FEATURED LANDMARK INSTALLATIONS</span>
        </div>
        <h2 class="font-display text-2xl sm:text-3xl lg:text-4xl font-extrabold text-white tracking-tight">
          Landmark Showcase.<br/>
          <span class="text-metallic-amber">PRECISION AT SCALE.</span>
        </h2>
      </div>

      <!-- Live Auto-Scroll Status Indicator -->
      <div class="flex items-center gap-3">
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg bg-navy-900/90 border border-white/10 font-mono text-[11px] text-slate-300 shadow-sm">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span class="text-slate-400">AUTO-SCROLLING REEL</span>
          <span class="text-slate-600">•</span>
          <span class="text-amber-brand font-bold">5 LANDMARKS</span>
        </div>
      </div>
    </div>

  </div>

  <!-- Continuous Seamless Auto-Scrolling Track (Zero Browser Scrollbars) -->
  <div class="relative w-full overflow-hidden no-scrollbar py-2">
    
    <!-- Subtle gradient edge fade for editorial finish -->
    <div class="absolute left-0 top-0 bottom-0 w-8 sm:w-16 bg-gradient-to-r from-navy-950 to-transparent z-10 pointer-events-none"></div>
    <div class="absolute right-0 top-0 bottom-0 w-8 sm:w-16 bg-gradient-to-l from-navy-950 to-transparent z-10 pointer-events-none"></div>

    <div class="flex w-max gap-5 sm:gap-6 animate-reel-slow px-4">
      {duplicatedProjects.map((proj, idx) => (
        <div 
          class="project-compact-card w-[310px] sm:w-[350px] lg:w-[380px] shrink-0 group/card glass-panel-navy rounded-2xl overflow-hidden shadow-glass-navy flex flex-col justify-between border border-white/10 transition-all duration-300 hover:border-amber-brand/50 hover:shadow-glass-floating"
          data-cursor="view"
        >
          <!-- Photographic Frame (Clean 16:10 Ratio, No Clipping) -->
          <div class="relative aspect-[16/10] overflow-hidden bg-navy-900">
            <img 
              src={proj.image} 
              alt={`${proj.title} - ${proj.client}`}
              class="w-full h-full object-cover group-hover/card:scale-105 transition-transform duration-700 ease-out"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-navy-950 via-navy-950/20 to-transparent"></div>

            <!-- Top Floating Glass Tags -->
            <div class="absolute top-3 left-3 flex flex-wrap items-center gap-1.5">
              <span class="px-2.5 py-0.5 rounded-md glass-panel-amber font-mono text-[9px] font-bold text-amber-brand border border-amber-brand/30">
                LANDMARK // 0{(idx % 5) + 1}
              </span>
              <span class="px-2.5 py-0.5 rounded-md glass-panel-navy font-mono text-[9px] text-slate-200 border border-white/10">
                {proj.location}
              </span>
            </div>

            <!-- Bottom Heading on Image -->
            <div class="absolute bottom-3 left-3 right-3 text-white">
              <span class="font-mono text-[9px] uppercase tracking-wider text-amber-brand block mb-0.5 font-semibold">
                {proj.category}
              </span>
              <h3 class="font-display text-base sm:text-lg font-bold text-white tracking-tight leading-snug group-hover/card:text-amber-brand transition-colors line-clamp-1">
                {proj.title}
              </h3>
            </div>
          </div>

          <!-- Descriptive Metadata HUD -->
          <div class="p-4 sm:p-5 space-y-3 bg-navy-950/95 font-sans flex-1 flex flex-col justify-between">
            <div class="space-y-2">
              <div class="flex items-center justify-between font-mono text-[11px] text-slate-400 border-b border-white/5 pb-2">
                <div class="truncate pr-2">
                  <span class="text-slate-500">CLIENT:</span>
                  <strong class="text-white ml-1">{proj.client}</strong>
                </div>
                <div class="text-emerald-400 font-semibold flex items-center gap-1 shrink-0 text-[10px]">
                  <Icon name="check-circle" class="w-3 h-3 text-emerald-400" />
                  <span>Verified</span>
                </div>
              </div>

              <p class="text-xs text-slate-300 leading-relaxed line-clamp-2">
                {proj.scopeSummary}
              </p>
            </div>

            <div class="pt-2.5 border-t border-white/5 flex items-center justify-between gap-2 font-mono text-xs">
              <div class="flex flex-wrap gap-1">
                {proj.sectors.slice(0, 2).map((sec) => (
                  <span class="px-2 py-0.5 rounded bg-navy-900 border border-white/10 text-slate-300 text-[9px]">
                    {sec}
                  </span>
                ))}
              </div>

              <a 
                href="/contact" 
                data-magnetic="true"
                class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-amber-brand text-navy-950 font-bold hover:bg-amber-glow shadow-glass-amber transition-all text-[11px]"
              >
                <span>Request Scope</span>
                <Icon name="arrow-right" class="w-3 h-3" />
              </a>
            </div>
          </div>

        </div>
      ))}
    </div>

  </div>

</section>
