---
import Icon from './Icon.astro';
import { VERIFIED_PROJECTS } from '../data/company';

// Select 5 premier landmark installations with authentic photography
const showcaseProjects = [
  VERIFIED_PROJECTS.find(p => p.id === 'yas-waterworld') || VERIFIED_PROJECTS[1],
  VERIFIED_PROJECTS.find(p => p.id === 'aldar-academies-hq') || VERIFIED_PROJECTS[0],
  VERIFIED_PROJECTS.find(p => p.id === 'emirates-nbd-bank') || VERIFIED_PROJECTS[3],
  VERIFIED_PROJECTS.find(p => p.id === 'puma-outlet-showroom') || VERIFIED_PROJECTS[2],
  VERIFIED_PROJECTS.find(p => p.id === 'katrina-sweets') || VERIFIED_PROJECTS[4],
].filter(Boolean);
---

<div id="horizontal-projects-wrapper" class="relative overflow-hidden py-16 lg:py-24 bg-navy-950 text-white border-b border-navy-800">
  
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-10 flex flex-col md:flex-row md:items-end justify-between gap-6">
    <div class="space-y-3">
      <div class="inline-flex items-center gap-2 font-mono text-xs text-amber-brand font-bold tracking-widest uppercase px-3 py-1 rounded-full glass-panel-amber">
        <span class="w-1.5 h-1.5 rounded-full bg-amber-brand animate-ping"></span>
        <span>04 // FEATURED LANDMARK INSTALLATIONS</span>
      </div>
      <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight">
        Kinetic Showcase.<br/>
        <span class="text-metallic-amber">PRECISION AT SCALE.</span>
      </h2>
    </div>

    <div class="hidden lg:flex items-center gap-3 font-mono text-xs text-slate-400">
      <span class="text-amber-brand">↔</span>
      <span>SCROLL VERTICALLY TO GLIDE HORIZONTALLY</span>
      <span class="px-2.5 py-1 rounded bg-navy-900 border border-white/10 text-slate-300">05 LANDMARKS</span>
    </div>
  </div>

  <!-- Horizontal Track -->
  <div class="w-full overflow-x-auto lg:overflow-x-visible pb-8 lg:pb-0 scrollbar-none snap-x snap-mandatory">
    <div 
      id="horizontal-projects-track" 
      class="flex flex-nowrap items-stretch gap-6 sm:gap-8 px-4 sm:px-6 lg:px-12 w-max"
    >
      {showcaseProjects.map((proj, idx) => (
        <div 
          class="horizontal-project-slide w-[86vw] sm:w-[72vw] lg:w-[62vw] max-w-[820px] shrink-0 snap-center group glass-panel-navy rounded-3xl overflow-hidden shadow-glass-floating flex flex-col justify-between border border-white/10 crosshair-corner"
          data-cursor="view"
        >
          <!-- Photographic Visual Area -->
          <div class="relative aspect-[16/9] sm:aspect-[16/10] overflow-hidden bg-navy-900">
            <img 
              src={proj.image} 
              alt={`${proj.title} - ${proj.client}`}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-navy-950 via-navy-950/20 to-transparent"></div>

            <!-- Top Corner Indicators -->
            <div class="absolute top-4 left-4 flex flex-wrap items-center gap-2">
              <span class="px-3 py-1 rounded-xl glass-panel-amber font-mono text-[10px] font-bold text-amber-brand">
                LANDMARK // 0{idx + 1}
              </span>
              <span class="px-3 py-1 rounded-xl glass-panel-navy font-mono text-[10px] text-slate-200">
                {proj.location}
              </span>
            </div>

            <!-- Client & Title Overlay -->
            <div class="absolute bottom-4 left-4 right-4 text-white">
              <span class="font-mono text-[11px] uppercase tracking-wider text-amber-brand block mb-1">
                {proj.category}
              </span>
              <h3 class="font-display text-xl sm:text-2xl lg:text-3xl font-extrabold text-white tracking-tight leading-tight group-hover:text-amber-brand transition-colors">
                {proj.title}
              </h3>
            </div>
          </div>

          <!-- Bottom Telemetry HUD Details -->
          <div class="p-6 sm:p-8 space-y-4 bg-navy-950/90 font-sans">
            <div class="flex items-center justify-between font-mono text-xs text-slate-400 border-b border-white/5 pb-3">
              <div>
                <span class="text-slate-500">CLIENT:</span>
                <strong class="text-white ml-1.5">{proj.client}</strong>
              </div>
              <div class="text-emerald-400 font-semibold flex items-center gap-1.5">
                <Icon name="check-circle" class="w-4 h-4 text-emerald-400" />
                <span>Verified Facility</span>
              </div>
            </div>

            <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
              {proj.scopeSummary}
            </p>

            <div class="pt-2 flex flex-wrap items-center justify-between gap-4 font-mono text-xs">
              <div class="flex flex-wrap gap-2">
                {proj.sectors.map((sec) => (
                  <span class="px-2.5 py-1 rounded bg-navy-900 border border-white/10 text-slate-300 text-[10px]">
                    {sec}
                  </span>
                ))}
              </div>

              <a 
                href="/contact" 
                data-magnetic="true"
                class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-amber-brand text-navy-950 font-bold hover:bg-amber-glow shadow-glass-amber transition-all text-xs"
              >
                <span>Request Project Scope</span>
                <Icon name="arrow-right" class="w-3.5 h-3.5" />
              </a>
            </div>
          </div>

        </div>
      ))}
    </div>
  </div>

</div>

