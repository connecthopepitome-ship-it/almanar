---
import Icon from './Icon.astro';

const credentials = [
  {
    number: "01",
    title: "Established 2001 // Over 2 Decades",
    subtitle: "23+ Years Continuous UAE Track Record",
    description: "Since 2001, Al Manar Tech has operated continuously across Abu Dhabi and Al Ain. Our longevity is built on engineering integrity, repeat institutional clients, and zero abandoned contracts.",
    icon: "award",
    badge: "EST. 2001"
  },
  {
    number: "02",
    title: "Full Statutory Authority Approvals",
    subtitle: "ADDC // ADM // ADQCC // Civil Defence",
    description: "Licensed and pre-approved with Abu Dhabi Distribution Company (ADDC) and Abu Dhabi Municipality. We manage complete inspection filing, load approvals, and meter energization without bureaucratic delays.",
    icon: "shield-check",
    badge: "100% COMPLIANT"
  },
  {
    number: "03",
    title: "Six In-House Technical Divisions",
    subtitle: "Single-Point Turnkey Accountability",
    description: "We execute electrical, HVAC, fire life safety, low current, security, and facilities maintenance through our direct technical workforce—eliminating the finger-pointing of fragmented subcontractors.",
    icon: "layers",
    badge: "6 DIVISIONS"
  },
  {
    number: "04",
    title: "Musaffah M35 Logistics & Staging Hub",
    subtitle: "Warehouse 2, Al Afou 3 St, Musaffah",
    description: "Our dedicated headquarters, inventory warehouse, and staging depot in Musaffah M35 ensure rapid equipment mobilization, genuine spares availability, and on-time site supply across Abu Dhabi.",
    icon: "map-pin",
    badge: "CENTRAL HUB"
  },
  {
    number: "05",
    title: "Lifecycle AMC & 24/7 Response",
    subtitle: "Planned Preventive & On-Call Repair",
    description: "We don't just hand over projects and leave. Our Facility Maintenance division manages structured AMCs, calibrated switchgear thermography, filter replacements, and 24/7 emergency repair teams.",
    icon: "wrench",
    badge: "24/7 ON-CALL"
  },
  {
    number: "06",
    title: "Strict HSE & Quality Engineering",
    subtitle: "BS 7671, NFPA & UAE Fire Code Compliant",
    description: "Every installation is inspected against international standards and UAE ministerial codes. Megger insulation testing, airflow balancing, and loop checks are certified prior to final handover.",
    icon: "check-circle",
    badge: "VERIFIED SAFE"
  }
];
---

<section 
  id="why-choose-al-manar" 
  class="py-24 lg:py-32 bg-navy-950 text-white border-b border-navy-800 relative overflow-hidden"
  aria-label="Why Choose Al Manar Tech"
>
  <!-- Background Technical Grid & Subtle Copper Radial Glow -->
  <div class="absolute inset-0 opacity-[0.04] pointer-events-none" style="background-image: linear-gradient(to right, #FFFFFF 1px, transparent 1px), linear-gradient(to bottom, #FFFFFF 1px, transparent 1px); background-size: 64px 64px;"></div>
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[500px] rounded-full blur-[180px] pointer-events-none bg-[#F07842]/5" aria-hidden="true"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 space-y-16">
    
    <!-- Header Composition -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 pb-6 border-b border-white/5 scroll-reveal-up">
      <div class="space-y-3 max-w-2xl">
        <div class="inline-flex items-center gap-2 font-mono text-xs text-[#F07842] font-bold tracking-widest uppercase px-3 py-1 rounded-full glass-panel-copper">
          <span>06 // TRUST &amp; CAPABILITY</span>
        </div>
        <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-tight">
          Why Leading Developers &amp;<br/>
          <span class="text-copper-headline">CONTRACTORS CHOOSE AL MANAR.</span>
        </h2>
      </div>

      <p class="text-slate-400 font-mono text-xs max-w-md">
        VERIFIED ABU DHABI CONTRACTOR CREDENTIALS. ZERO COMPROMISE ON STATUTORY CODES, MATERIALS, OR TIMELINES.
      </p>
    </div>

    <!-- 6 Credential Pillars Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
      {credentials.map((cred, idx) => (
        <div 
          class={`glass-panel-navy p-7 sm:p-8 rounded-3xl border border-white/10 flex flex-col justify-between space-y-6 hover:border-[#F07842]/50 hover:shadow-lg hover:shadow-[#F07842]/10 transition-all duration-300 group scroll-reveal-up stagger-${idx + 1}`}
        >
          <!-- Top Row: Number & Badge -->
          <div class="flex items-center justify-between">
            <span class="font-mono text-xs font-bold text-[#F07842] px-2.5 py-1 rounded-lg bg-[#F07842]/10 border border-[#F07842]/30">
              PILLAR_{cred.number}
            </span>
            <span class="font-mono text-[10px] text-slate-400 uppercase tracking-widest px-2.5 py-0.5 rounded bg-white/5 border border-white/5">
              {cred.badge}
            </span>
          </div>

          <!-- Middle Content: Icon, Title & Subtitle -->
          <div class="space-y-3">
            <div class="w-12 h-12 rounded-2xl bg-[#17232D] border border-white/10 flex items-center justify-center text-[#F07842] group-hover:scale-110 group-hover:border-[#F07842]/60 transition-all duration-300">
              <Icon name={cred.icon} class="w-6 h-6" />
            </div>

            <h3 class="font-display text-xl font-bold text-white group-hover:text-[#FFAB78] transition-colors leading-snug">
              {cred.title}
            </h3>

            <p class="font-mono text-xs text-[#F07842] font-semibold">
              {cred.subtitle}
            </p>

            <p class="font-sans text-xs sm:text-sm text-slate-300 leading-relaxed pt-1">
              {cred.description}
            </p>
          </div>

          <!-- Bottom Assurance Strip -->
          <div class="pt-4 border-t border-white/5 font-mono text-[11px] text-slate-400 flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-[#F07842]"></span>
            <span>VERIFIED CAPABILITY</span>
          </div>
        </div>
      ))}
    </div>

    <!-- Bottom Stat Summary Banner -->
    <div class="p-6 sm:p-8 rounded-3xl bg-[#17232D]/80 border border-white/10 backdrop-blur-xl flex flex-col sm:flex-row items-center justify-between gap-6 text-center sm:text-left scroll-reveal-up">
      <div class="space-y-1">
        <h4 class="font-display text-lg font-bold text-white">
          Ready to review your drawings or tender schedule with our engineers?
        </h4>
        <p class="font-sans text-xs sm:text-sm text-slate-300">
          We provide transparent load assessments, BOQ pricing, and statutory feasibility within 24 working hours.
        </p>
      </div>

      <div class="flex items-center gap-3 shrink-0">
        <a 
          href="#contact" 
          class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl bg-[#F07842] text-[#111920] font-display text-xs font-bold uppercase tracking-wider hover:bg-[#D96532] transition-colors shadow-md shadow-[#F07842]/20"
        >
          <span>Request Quote</span>
          <Icon name="arrow-right" class="w-4 h-4" />
        </a>

        <a 
          href="tel:025829700" 
          class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl bg-white/5 border border-white/10 text-white font-mono text-xs font-semibold hover:bg-white/10 transition-colors"
        >
          <Icon name="phone" class="w-3.5 h-3.5 text-[#F07842]" />
          <span>02-5829700</span>
        </a>
      </div>
    </div>

  </div>
</section>
