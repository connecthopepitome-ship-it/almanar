---
import Icon from './Icon.astro';
---

<!-- =========================================================================
     AL MANAR TECH — CLIENT & TENDER PORTAL (MOBILE-OPTIMIZED WEB APP SHEET)
     ========================================================================= -->
<div 
  id="client-portal-modal" 
  class="fixed inset-0 z-[120] flex items-end sm:items-center justify-center p-0 sm:p-4 opacity-0 pointer-events-none transition-all duration-300"
  role="dialog"
  aria-modal="true"
  aria-hidden="true"
>
  <!-- Backdrop Blur Overlay -->
  <div id="portal-modal-backdrop" class="absolute inset-0 bg-[#0B1117]/80 backdrop-blur-xl transition-opacity"></div>

  <!-- Modal / Bottom Sheet Window -->
  <div class="relative w-full max-w-xl max-h-[92vh] sm:max-h-[85vh] bg-[#111920] border-t sm:border border-[#B56E4B]/40 rounded-t-3xl sm:rounded-3xl shadow-2xl overflow-hidden flex flex-col z-10 glass-panel-navy">
    
    <!-- Mobile Pull / Drag Indicator Handle -->
    <div class="pt-3 pb-1 flex justify-center sm:hidden">
      <div class="w-12 h-1.5 rounded-full bg-white/20"></div>
    </div>

    <!-- Header Bar -->
    <div class="px-5 sm:px-6 py-3.5 border-b border-white/10 flex items-center justify-between bg-[#162029]/95 sticky top-0 z-20">
      <div class="flex items-center gap-2.5">
        <div class="w-8 h-8 rounded-lg bg-[#F07842]/10 border border-[#F07842]/30 flex items-center justify-center text-[#F07842]">
          <Icon name="shield-check" class="w-4 h-4" />
        </div>
        <div>
          <span class="font-display text-sm font-bold text-white block leading-tight">
            Client &amp; Tender Portal
          </span>
          <span class="font-mono text-[10px] text-slate-400 block">
            Al Manar Technical Contracting • Abu Dhabi
          </span>
        </div>
      </div>

      <button 
        id="close-portal-modal-btn"
        type="button"
        class="p-2 rounded-xl text-slate-400 hover:text-white hover:bg-white/10 transition-colors cursor-pointer"
        aria-label="Close client portal modal"
      >
        <Icon name="x" class="w-5 h-5" />
      </button>
    </div>

    <!-- Tab Switcher (Track Status vs Client Sign In) -->
    <div class="px-5 sm:px-6 pt-4 pb-2 border-b border-white/5 bg-[#141C24]">
      <div class="grid grid-cols-2 p-1 rounded-xl bg-[#0E151C] border border-white/5 text-xs font-mono">
        <button 
          type="button" 
          id="portal-tab-track" 
          class="portal-tab-btn py-2 px-3 rounded-lg font-bold transition-all text-[#111920] bg-[#F07842] shadow-sm cursor-pointer text-center"
        >
          Track Project Status
        </button>
        <button 
          type="button" 
          id="portal-tab-auth" 
          class="portal-tab-btn py-2 px-3 rounded-lg font-semibold transition-all text-slate-400 hover:text-white cursor-pointer text-center"
        >
          Client Sign In
        </button>
      </div>
    </div>

    <!-- Scrollable Sheet Content -->
    <div class="p-5 sm:p-6 overflow-y-auto space-y-5 max-h-[calc(90vh-160px)] font-sans">
      
      <!-- =====================================================================
           TAB 1: TRACK PROJECT / TENDER STATUS (LIVE LOOKUP & DEMO)
           ===================================================================== -->
      <div id="portal-content-track" class="space-y-4">
        <div class="space-y-1.5">
          <label for="portal-proj-input" class="block font-mono text-[11px] font-bold uppercase tracking-wider text-slate-300">
            Enter Project Reference or Tender ID
          </label>
          <div class="flex gap-2">
            <input 
              type="text" 
              id="portal-proj-input" 
              placeholder="e.g. AMT-2024-ALDAR or YAS" 
              value="AMT-2024-ALDAR"
              class="flex-1 px-3.5 py-2.5 rounded-xl bg-[#17232D] border border-white/10 text-white placeholder-slate-500 text-xs font-mono focus:outline-none focus:border-[#F07842]"
            />
            <button 
              type="button" 
              id="portal-track-btn" 
              class="px-4 py-2.5 rounded-xl bg-[#F07842] text-[#111920] text-xs font-display font-bold uppercase tracking-wider hover:bg-[#D96532] transition-colors cursor-pointer shrink-0"
            >
              Track
            </button>
          </div>
        </div>

        <!-- Quick Demo Chips -->
        <div class="space-y-1.5">
          <span class="text-[10px] font-mono text-slate-400 uppercase tracking-wider block">
            Instant Demo Queries:
          </span>
          <div class="flex flex-wrap gap-1.5 text-[11px] font-mono">
            <button type="button" class="portal-demo-chip px-2.5 py-1 rounded-lg bg-white/5 border border-white/10 text-slate-300 hover:text-white hover:border-[#F07842]/50 transition-colors" data-ref="AMT-2024-ALDAR">
              Aldar Academies HQ
            </button>
            <button type="button" class="portal-demo-chip px-2.5 py-1 rounded-lg bg-white/5 border border-white/10 text-slate-300 hover:text-white hover:border-[#F07842]/50 transition-colors" data-ref="AMT-2024-YAS">
              Yas Waterworld
            </button>
            <button type="button" class="portal-demo-chip px-2.5 py-1 rounded-lg bg-white/5 border border-white/10 text-slate-300 hover:text-white hover:border-[#F07842]/50 transition-colors" data-ref="AMT-2024-PUMA">
              Puma Flagship Outlet
            </button>
          </div>
        </div>

        <!-- Project Status Display Card -->
        <div id="portal-status-card" class="p-4 sm:p-5 rounded-2xl bg-[#141C24] border border-white/10 space-y-4">
          <div class="flex items-center justify-between pb-3 border-b border-white/10">
            <div>
              <span id="proj-card-title" class="font-display text-sm sm:text-base font-bold text-white block">
                Aldar Academies Headquarters
              </span>
              <span id="proj-card-sub" class="font-mono text-[10px] text-slate-400">
                Client: Aldar Education • Ref: AMT-2024-ALDAR
              </span>
            </div>
            <span class="px-2.5 py-0.5 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-[10px] font-mono text-emerald-400 font-bold shrink-0">
              Verified Complete
            </span>
          </div>

          <!-- Progress Milestones -->
          <div class="space-y-2 text-xs font-mono">
            <div class="flex items-center justify-between text-[11px] text-slate-300">
              <span>Execution &amp; Approvals Progress</span>
              <span class="text-[#F07842] font-bold">100%</span>
            </div>
            <div class="w-full h-2 rounded-full bg-navy-950 overflow-hidden">
              <div class="h-full bg-gradient-to-r from-[#F07842] to-emerald-400 rounded-full w-full"></div>
            </div>
          </div>

          <!-- Milestones Checklist -->
          <div class="space-y-2 text-xs font-sans">
            <div class="flex items-center gap-2 text-slate-200">
              <span class="w-4 h-4 rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center text-[10px] font-bold">✓</span>
              <span>ADDC Electrical Single-Line Diagrams: Approved</span>
            </div>
            <div class="flex items-center gap-2 text-slate-200">
              <span class="w-4 h-4 rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center text-[10px] font-bold">✓</span>
              <span>HVAC Chilled Water &amp; FCU Installation: Commissioned</span>
            </div>
            <div class="flex items-center gap-2 text-slate-200">
              <span class="w-4 h-4 rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center text-[10px] font-bold">✓</span>
              <span>Civil Defence Fire Alarm &amp; Notification: Certified</span>
            </div>
            <div class="flex items-center gap-2 text-slate-200">
              <span class="w-4 h-4 rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center text-[10px] font-bold">✓</span>
              <span>Final Handover, As-Built Drawings &amp; O&amp;M Dossier: Delivered</span>
            </div>
          </div>

          <!-- Direct Engineer Contact Action -->
          <div class="pt-3 border-t border-white/10 flex flex-wrap items-center justify-between gap-2 font-mono text-[11px]">
            <span class="text-slate-400">Assigned Desk: Musaffah M35</span>
            <div class="flex items-center gap-2">
              <a 
                href="https://wa.me/97125829700?text=Hello%20Al%20Manar%20Tech%2C%20inquiry%20regarding%20project%20status." 
                class="px-3 py-1.5 rounded-lg bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 font-bold hover:bg-emerald-500/20 flex items-center gap-1.5"
              >
                <span>WhatsApp Engineer</span>
              </a>
              <a 
                href="tel:025829700" 
                class="px-3 py-1.5 rounded-lg bg-white/5 border border-white/10 text-white font-bold hover:bg-white/10 flex items-center gap-1.5"
              >
                <span>Call Desk</span>
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- =====================================================================
           TAB 2: CLIENT & CONSULTANT SIGN IN (MOBILE WEB APP AUTH)
           ===================================================================== -->
      <div id="portal-content-auth" class="hidden space-y-4">
        <div class="p-3.5 rounded-xl bg-[#F07842]/10 border border-[#F07842]/20 text-xs text-[#FFAB78] leading-relaxed">
          Authorized access for project owners, consulting engineers, and main contractors with active Al Manar Tech tenders or contracts.
        </div>

        <form id="portal-login-form" class="space-y-3.5" onsubmit="event.preventDefault();">
          <div class="space-y-1">
            <label for="portal-email" class="block font-mono text-[11px] font-bold uppercase tracking-wider text-slate-300">
              Corporate Email or Client ID
            </label>
            <input 
              type="text" 
              id="portal-email" 
              placeholder="e.g. consultant@aldar.com" 
              class="w-full px-3.5 py-2.5 rounded-xl bg-[#17232D] border border-white/10 text-white placeholder-slate-500 text-xs font-mono focus:outline-none focus:border-[#F07842]"
            />
          </div>

          <div class="space-y-1">
            <label for="portal-pass" class="block font-mono text-[11px] font-bold uppercase tracking-wider text-slate-300">
              Access PIN / Password
            </label>
            <input 
              type="password" 
              id="portal-pass" 
              placeholder="••••••••" 
              class="w-full px-3.5 py-2.5 rounded-xl bg-[#17232D] border border-white/10 text-white placeholder-slate-500 text-xs font-mono focus:outline-none focus:border-[#F07842]"
            />
          </div>

          <div class="flex items-center justify-between text-[11px] font-mono text-slate-400 pt-1">
            <label class="flex items-center gap-1.5 cursor-pointer">
              <input type="checkbox" checked class="rounded border-white/20 bg-[#17232D] text-[#F07842] focus:ring-0" />
              <span>Remember Device</span>
            </label>
            <a href="tel:025829700" class="text-[#F07842] hover:underline">Forgot PIN?</a>
          </div>

          <button 
            type="submit" 
            id="portal-submit-btn"
            class="w-full py-3 rounded-xl bg-[#F07842] text-[#111920] font-display text-xs font-bold uppercase tracking-wider hover:bg-[#D96532] shadow-lg shadow-[#F07842]/20 transition-all cursor-pointer flex items-center justify-center gap-2 mt-2"
          >
            <span>Secure Client Sign In</span>
            <Icon name="arrow-right" class="w-3.5 h-3.5" />
          </button>
        </form>

        <div id="portal-login-feedback" class="hidden p-3 rounded-xl bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-xs font-mono text-center">
          ✓ Credentials verified. Loading your project repository...
        </div>

        <div class="pt-3 border-t border-white/10 text-center">
          <p class="text-xs text-slate-400">
            Need contractor prequalification or new tender access?
          </p>
          <a href="/contact" class="font-mono text-xs text-[#F07842] hover:underline font-bold mt-1 inline-block">
            Request Prequalification Dossier →
          </a>
        </div>
      </div>

    </div>

    <!-- Bottom Status Bar -->
    <div class="px-5 sm:px-6 py-2.5 border-t border-white/5 bg-[#0E151C] text-[10px] font-mono text-slate-500 flex items-center justify-between">
      <span>256-BIT SSL ENCRYPTED</span>
      <span>ISO 9001:2015 CERTIFIED</span>
    </div>

  </div>
</div>

<script>
  // Client Portal Dialog Interactions
  const portalModal = document.getElementById('client-portal-modal');
  const portalBackdrop = document.getElementById('portal-modal-backdrop');
  const closePortalBtn = document.getElementById('close-portal-modal-btn');
  const tabTrack = document.getElementById('portal-tab-track');
  const tabAuth = document.getElementById('portal-tab-auth');
  const contentTrack = document.getElementById('portal-content-track');
  const contentAuth = document.getElementById('portal-content-auth');
  const trackBtn = document.getElementById('portal-track-btn');
  const projInput = document.getElementById('portal-proj-input') as HTMLInputElement | null;
  const cardTitle = document.getElementById('proj-card-title');
  const cardSub = document.getElementById('proj-card-sub');
  const demoChips = document.querySelectorAll('.portal-demo-chip');
  const loginForm = document.getElementById('portal-login-form');
  const loginFeedback = document.getElementById('portal-login-feedback');
  const submitBtn = document.getElementById('portal-submit-btn');

  // Open Portal Function
  window.openClientPortal = function(mode = 'track') {
    if (!portalModal) return;
    if (mode === 'auth') {
      switchTab('auth');
    } else {
      switchTab('track');
    }
    portalModal.classList.remove('opacity-0', 'pointer-events-none');
    portalModal.classList.add('opacity-100', 'pointer-events-auto');
    portalModal.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  };

  function closePortal() {
    if (!portalModal) return;
    portalModal.classList.add('opacity-0', 'pointer-events-none');
    portalModal.classList.remove('opacity-100', 'pointer-events-auto');
    portalModal.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  function switchTab(tab: 'track' | 'auth') {
    if (!tabTrack || !tabAuth || !contentTrack || !contentAuth) return;
    if (tab === 'track') {
      tabTrack.classList.add('text-[#111920]', 'bg-[#F07842]', 'font-bold');
      tabTrack.classList.remove('text-slate-400');
      tabAuth.classList.remove('text-[#111920]', 'bg-[#F07842]', 'font-bold');
      tabAuth.classList.add('text-slate-400');
      contentTrack.classList.remove('hidden');
      contentAuth.classList.add('hidden');
    } else {
      tabAuth.classList.add('text-[#111920]', 'bg-[#F07842]', 'font-bold');
      tabAuth.classList.remove('text-slate-400');
      tabTrack.classList.remove('text-[#111920]', 'bg-[#F07842]', 'font-bold');
      tabTrack.classList.add('text-slate-400');
      contentAuth.classList.remove('hidden');
      contentTrack.classList.add('hidden');
    }
  }

  tabTrack?.addEventListener('click', () => switchTab('track'));
  tabAuth?.addEventListener('click', () => switchTab('auth'));
  closePortalBtn?.addEventListener('click', closePortal);
  portalBackdrop?.addEventListener('click', closePortal);

  // Esc key closes
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closePortal();
  });

  // Global triggers
  document.querySelectorAll('[data-open-portal]').forEach((el) => {
    el.addEventListener('click', (e) => {
      e.preventDefault();
      const mode = el.getAttribute('data-portal-mode') || 'track';
      window.openClientPortal(mode);
    });
  });

  // Track Demo Chips
  const projectDatabase: Record<string, { title: string; client: string; ref: string }> = {
    'AMT-2024-ALDAR': {
      title: 'Aldar Academies Headquarters',
      client: 'Aldar Education',
      ref: 'AMT-2024-ALDAR'
    },
    'AMT-2024-YAS': {
      title: 'Yas Waterworld Leisure Complex',
      client: 'Miral Asset Management',
      ref: 'AMT-2024-YAS'
    },
    'AMT-2024-PUMA': {
      title: 'Puma Flagship Retail Showroom',
      client: 'Puma Middle East',
      ref: 'AMT-2024-PUMA'
    }
  };

  demoChips.forEach((chip) => {
    chip.addEventListener('click', () => {
      const ref = chip.getAttribute('data-ref') || 'AMT-2024-ALDAR';
      if (projInput) projInput.value = ref;
      updateProjectCard(ref);
    });
  });

  trackBtn?.addEventListener('click', () => {
    const val = (projInput?.value || '').trim().toUpperCase();
    updateProjectCard(val);
  });

  function updateProjectCard(ref: string) {
    if (!cardTitle || !cardSub) return;
    const match = projectDatabase[ref] || {
      title: `${ref} Technical Milestone Dossier`,
      client: 'Abu Dhabi Commercial Authority',
      ref: ref
    };
    cardTitle.textContent = match.title;
    cardSub.textContent = `Client: ${match.client} • Ref: ${match.ref}`;
  }

  // Simulated Login
  loginForm?.addEventListener('submit', () => {
    if (loginFeedback && submitBtn) {
      submitBtn.setAttribute('disabled', 'true');
      submitBtn.innerHTML = `<span>Authenticating...</span>`;
      setTimeout(() => {
        loginFeedback.classList.remove('hidden');
        submitBtn.removeAttribute('disabled');
        submitBtn.innerHTML = `<span>Portal Open</span>`;
      }, 700);
    }
  });
</script>

