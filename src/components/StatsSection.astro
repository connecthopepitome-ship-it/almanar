---
import Icon from './Icon.astro';
import { COMPANY } from '../data/company';

interface Props {
  variant?: 'light' | 'dark';
}

const { variant = 'dark' } = Astro.props;

const isDark = variant === 'dark';
---

<section class={`py-20 border-y ${
  isDark 
    ? 'bg-navy-950 text-white border-navy-800' 
    : 'bg-ivory-100 text-navy-950 border-ivory-300'
}`}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
    <div id="stats-section-grid" class="grid grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-12">
      
      {COMPANY.stats.map((stat, idx) => (
        <div class="flex flex-col items-start space-y-2.5 border-l-2 border-amber-brand/60 pl-4 group">
          <div class="flex items-center gap-2">
            <div class={`w-6 h-6 rounded-lg flex items-center justify-center shrink-0 transition-transform duration-300 group-hover:scale-110 ${
              idx === 0 
                ? 'bg-[#F07842]/20 border border-[#F07842]/50 text-[#F07842] shadow-sm shadow-[#F07842]/30' 
                : 'bg-white/5 border border-white/10 text-slate-300 group-hover:text-[#F07842]'
            }`}>
              <Icon name={stat.icon || 'award'} class="w-3.5 h-3.5" />
            </div>
            <span class="font-mono text-[10px] uppercase tracking-widest text-slate-400 font-semibold">
              {stat.label}
            </span>
          </div>
          <div class="flex items-baseline gap-0.5">
            <span 
              class={`stats-section-counter font-display text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tighter transition-all duration-300 ${
                isDark ? 'text-metallic-amber' : 'text-navy-950'
              }`}
              data-target={stat.target}
              data-start={stat.start}
              data-suffix={stat.suffix}
              data-pad={stat.padZero ? 'true' : 'false'}
            >
              {stat.value}
            </span>
          </div>
          <p class="text-xs text-slate-300 font-sans leading-relaxed">
            {stat.detail}
          </p>
        </div>
      ))}

    </div>

    <!-- Accreditations Banner within Stats -->
    <div class="pt-8 border-t border-navy-800 flex flex-wrap items-center justify-between gap-6 font-mono text-xs">
      <div class="flex items-center gap-2 text-slate-400">
        <Icon name="shield-check" class="w-4 h-4 text-amber-brand" />
        <span class="uppercase tracking-wider">Official UAE Regulatory Authorities:</span>
      </div>

      <div class="flex flex-wrap items-center gap-6 text-slate-300">
        <div class="flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
          <span>Abu Dhabi Distribution Co. (ADDC)</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
          <span>Abu Dhabi Municipality (ADM)</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
          <span>Quality & Conformity (ADQCC)</span>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  function initStatsSectionCounter() {
    const counterElements = document.querySelectorAll<HTMLElement>('.stats-section-counter');
    if (!counterElements.length) return;

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const animateNumber = (el: HTMLElement) => {
      const target = parseInt(el.getAttribute('data-target') || '0', 10);
      const start = parseInt(el.getAttribute('data-start') || '0', 10);
      const suffix = el.getAttribute('data-suffix') || '';
      const padZero = el.getAttribute('data-pad') === 'true';
      const duration = 1800;

      if (prefersReducedMotion) {
        let finalVal = target.toString();
        if (padZero && target < 10) finalVal = '0' + target;
        el.textContent = finalVal + suffix;
        return;
      }

      let startTime: number | null = null;

      function step(timestamp: number) {
        if (!startTime) startTime = timestamp;
        const progress = Math.min((timestamp - startTime) / duration, 1);
        const easeProgress = 1 - Math.pow(1 - progress, 4);
        const current = Math.floor(start + (target - start) * easeProgress);

        let formatted = current.toString();
        if (padZero && current < 10) {
          formatted = '0' + current;
        }

        el.textContent = formatted + suffix;

        if (progress < 1) {
          requestAnimationFrame(step);
        } else {
          let finalVal = target.toString();
          if (padZero && target < 10) finalVal = '0' + target;
          el.textContent = finalVal + suffix;
        }
      }

      requestAnimationFrame(step);
    };

    const statsGrid = document.getElementById('stats-section-grid');
    if (statsGrid && 'IntersectionObserver' in window) {
      let hasRun = false;
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting && !hasRun) {
              hasRun = true;
              counterElements.forEach(animateNumber);
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.25 }
      );
      observer.observe(statsGrid);
    } else {
      counterElements.forEach(animateNumber);
    }
  }

  initStatsSectionCounter();
  document.addEventListener('astro:page-load', initStatsSectionCounter);
</script>
