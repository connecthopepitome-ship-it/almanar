---
import Icon from './Icon.astro';
import { COMPANY } from '../data/company';

interface Props {
  variant?: 'light' | 'dark';
}

const { variant = 'dark' } = Astro.props;

const isDark = variant === 'dark';
---

<section class={`py-20 border-y ${
  isDark 
    ? 'bg-navy-950 text-white border-navy-800' 
    : 'bg-ivory-100 text-navy-950 border-ivory-300'
}`}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-12">
      
      {COMPANY.stats.map((stat) => (
        <div class="flex flex-col items-start space-y-2 border-l-2 border-amber-brand/60 pl-4">
          <span class="font-mono text-[10px] uppercase tracking-widest text-slate-400">
            {stat.label}
          </span>
          <div class="flex items-baseline gap-1">
            <span class={`font-display text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tighter ${
              isDark ? 'text-metallic-amber' : 'text-navy-950'
            }`}>
              {stat.value}
            </span>
          </div>
          <p class="text-xs text-slate-300 font-sans leading-relaxed">
            {stat.detail}
          </p>
        </div>
      ))}

    </div>

    <!-- Accreditations Banner within Stats -->
    <div class="pt-8 border-t border-navy-800 flex flex-wrap items-center justify-between gap-6 font-mono text-xs">
      <div class="flex items-center gap-2 text-slate-400">
        <Icon name="shield-check" class="w-4 h-4 text-amber-brand" />
        <span class="uppercase tracking-wider">Official UAE Regulatory Authorities:</span>
      </div>

      <div class="flex flex-wrap items-center gap-6 text-slate-300">
        <div class="flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
          <span>Abu Dhabi Distribution Co. (ADDC)</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
          <span>Abu Dhabi Municipality (ADM)</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
          <span>Quality & Conformity (ADQCC)</span>
        </div>
      </div>
    </div>
  </div>
</section>
