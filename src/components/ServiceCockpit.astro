---
import Icon from './Icon.astro';
import { SERVICES } from '../data/company';
---

<div class="service-cockpit-root w-full">
  <!-- Desktop Cockpit View (Hidden on mobile) -->
  <div class="hidden lg:grid grid-cols-12 gap-8 items-stretch">
    
    <!-- Left Column: Numbered Vertical Service List (5 cols) -->
    <div class="col-span-5 flex flex-col justify-between space-y-2">
      <div class="space-y-1" role="tablist" aria-label="Al Manar Tech Engineering Divisions">
        {SERVICES.map((s, idx) => (
          <button 
            type="button" 
            role="tab"
            aria-selected={idx === 0 ? "true" : "false"}
            aria-controls={`cockpit-panel-${s.id}`}
            id={`tab-${s.id}`}
            data-index={idx}
            class={`service-tab-btn w-full text-left p-4 rounded-xl transition-all duration-300 flex items-center justify-between group border ${
              idx === 0 
                ? 'bg-navy-850 border-amber-brand/50 text-white shadow-card-dark' 
                : 'bg-transparent border-transparent text-slate-400 hover:text-white hover:bg-navy-900/60'
            }`}
          >
            <div class="flex items-center gap-4">
              <span class={`font-mono text-xs font-bold transition-colors ${
                idx === 0 ? 'text-amber-brand' : 'text-slate-500 group-hover:text-amber-brand'
              }`}>
                {s.number}
              </span>
              <span class="font-display text-base font-bold tracking-tight">
                {s.shortTitle}
              </span>
            </div>

            <div class="flex items-center gap-2">
              <span class="font-mono text-[10px] uppercase tracking-wider text-slate-500 opacity-0 group-hover:opacity-100 transition-opacity">
                {s.category}
              </span>
              <Icon name="chevron-right" class={`w-4 h-4 transition-transform duration-300 ${
                idx === 0 ? 'text-amber-brand translate-x-1' : 'text-slate-600 group-hover:text-slate-300'
              }`} />
            </div>
          </button>
        ))}
      </div>

      <!-- Quick Indicator Footer -->
      <div class="p-4 rounded-xl bg-navy-900/60 border border-navy-800 text-xs font-mono text-slate-400 flex items-center justify-between">
        <span>TOTAL DIVISIONS: 06</span>
        <span class="text-amber-brand">ADDC / CIVIL DEFENCE ALIGNED</span>
      </div>
    </div>

    <!-- Right Column: Large Visual & Technical Deck (7 cols) -->
    <div class="col-span-7 relative bg-navy-900 border border-navy-800 rounded-2xl overflow-hidden crosshair-corner flex flex-col justify-between shadow-editorial min-h-[580px]">
      
      <!-- Panels for each service -->
      {SERVICES.map((s, idx) => (
        <div 
          id={`cockpit-panel-${s.id}`}
          role="tabpanel"
          aria-labelledby={`tab-${s.id}`}
          class={`cockpit-panel absolute inset-0 p-8 flex flex-col justify-between transition-all duration-500 ${
            idx === 0 ? 'opacity-100 z-10' : 'opacity-0 pointer-events-none z-0'
          }`}
        >
          <!-- Top Telemetry & Image Preview Strip -->
          <div class="space-y-6">
            <div class="flex items-center justify-between pb-4 border-b border-navy-800 font-mono text-xs text-slate-400">
              <div class="flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-amber-brand animate-ping"></span>
                <span class="text-white font-bold tracking-wider">DIVISION_{s.number} // {s.category.toUpperCase()}</span>
              </div>
              <span class="text-amber-brand tracking-widest">{s.specs[1]?.value}</span>
            </div>

            <!-- Image Container with HUD Frame -->
            <div class="relative aspect-[16/8] rounded-xl overflow-hidden bg-navy-950 border border-navy-800 group" data-cursor="view">
              <img 
                src={s.heroImage} 
                alt={`${s.title} Engineering Execution in Abu Dhabi`}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-navy-950/90 via-navy-950/20 to-transparent"></div>
              
              <div class="absolute bottom-3 left-4 right-4 flex items-center justify-between text-xs text-white">
                <span class="font-mono text-[11px] text-amber-brand font-semibold">
                  SITE ID: AMT-AUH-{s.number}
                </span>
                <span class="text-[11px] text-slate-300">
                  {s.specs[0]?.label}: <strong class="text-white">{s.specs[0]?.value}</strong>
                </span>
              </div>
            </div>

            <!-- Text & Technical Scope -->
            <div class="space-y-3">
              <h3 class="text-2xl font-extrabold text-white font-display tracking-tight">
                {s.title}
              </h3>
              <p class="text-xs font-mono text-amber-brand">
                {s.tagline}
              </p>
              <p class="text-sm text-slate-300 leading-relaxed line-clamp-3">
                {s.description}
              </p>
            </div>

            <!-- Technical Specifications Grid -->
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 pt-2">
              {s.specs.map((sp) => (
                <div class="p-2.5 rounded-lg bg-navy-950/80 border border-navy-800/80 font-mono text-[11px]">
                  <span class="text-slate-500 block text-[9px] uppercase tracking-wider">{sp.label}</span>
                  <span class="text-white font-semibold truncate block mt-0.5">{sp.value}</span>
                </div>
              ))}
            </div>
          </div>

          <!-- Bottom Action Bar -->
          <div class="pt-6 border-t border-navy-800 flex items-center justify-between mt-4">
            <a 
              href={`/services/${s.slug}`}
              class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-amber-brand text-navy-950 font-display text-xs font-bold hover:bg-amber-glow transition-all shadow-amber-sm"
            >
              <span>View Full Technical Scope</span>
              <Icon name="arrow-right" class="w-3.5 h-3.5" />
            </a>

            <a 
              href="/contact" 
              class="text-xs font-mono text-slate-400 hover:text-white transition-colors flex items-center gap-1.5"
            >
              <span>Request BOQ Estimating</span>
              <Icon name="chevron-right" class="w-3.5 h-3.5 text-amber-brand" />
            </a>
          </div>
        </div>
      ))}

    </div>
  </div>

  <!-- Mobile View: Clean Expandable Accordion -->
  <div class="lg:hidden space-y-4">
    {SERVICES.map((s, idx) => (
      <div class="bg-navy-900 border border-navy-800 rounded-xl overflow-hidden">
        <button 
          type="button" 
          class="mobile-service-toggle w-full p-4 flex items-center justify-between text-left text-white font-display font-bold text-base"
          aria-expanded={idx === 0 ? "true" : "false"}
          data-target={`mob-panel-${s.id}`}
        >
          <div class="flex items-center gap-3">
            <span class="font-mono text-xs text-amber-brand font-bold">{s.number}</span>
            <span>{s.shortTitle}</span>
          </div>
          <Icon name="chevron-down" class={`w-4 h-4 text-slate-400 transition-transform ${idx === 0 ? 'rotate-180 text-amber-brand' : ''}`} />
        </button>

        <div id={`mob-panel-${s.id}`} class={`mobile-service-panel p-4 pt-0 space-y-4 border-t border-navy-800/60 ${idx === 0 ? '' : 'hidden'}`}>
          <div class="aspect-video rounded-lg overflow-hidden bg-navy-950 mt-3">
            <img src={s.heroImage} alt={s.title} class="w-full h-full object-cover" loading="lazy" />
          </div>
          <p class="text-xs text-slate-300 leading-relaxed">{s.description}</p>
          <div class="pt-2">
            <a 
              href={`/services/${s.slug}`} 
              class="w-full inline-flex items-center justify-center gap-2 py-2.5 rounded-lg bg-amber-brand text-navy-950 font-display text-xs font-bold"
            >
              <span>Explore {s.shortTitle} Details</span>
              <Icon name="arrow-right" class="w-3.5 h-3.5" />
            </a>
          </div>
        </div>
      </div>
    ))}
  </div>
</div>

<script>
  // Desktop Tab switching logic
  const tabBtns = document.querySelectorAll('.service-tab-btn');
  const panels = document.querySelectorAll('.cockpit-panel');

  if (tabBtns.length > 0 && panels.length > 0) {
    tabBtns.forEach((btn) => {
      const activate = () => {
        const index = btn.getAttribute('data-index');

        tabBtns.forEach((b, i) => {
          const numberSpan = b.querySelector('span:first-child');
          const chevron = b.querySelector('svg');
          b.setAttribute('aria-selected', 'false');
          b.className = 'service-tab-btn w-full text-left p-4 rounded-xl transition-all duration-300 flex items-center justify-between group border bg-transparent border-transparent text-slate-400 hover:text-white hover:bg-navy-900/60';
          if (numberSpan) numberSpan.className = 'font-mono text-xs font-bold transition-colors text-slate-500 group-hover:text-amber-brand';
          if (chevron) chevron.className = 'w-4 h-4 transition-transform duration-300 text-slate-600 group-hover:text-slate-300';
        });

        btn.setAttribute('aria-selected', 'true');
        btn.className = 'service-tab-btn w-full text-left p-4 rounded-xl transition-all duration-300 flex items-center justify-between group border bg-navy-850 border-amber-brand/50 text-white shadow-card-dark';
        const activeNumber = btn.querySelector('span:first-child');
        const activeChevron = btn.querySelector('svg');
        if (activeNumber) activeNumber.className = 'font-mono text-xs font-bold transition-colors text-amber-brand';
        if (activeChevron) activeChevron.className = 'w-4 h-4 transition-transform duration-300 text-amber-brand translate-x-1';

        panels.forEach((p, i) => {
          if (i.toString() === index) {
            p.classList.remove('opacity-0', 'pointer-events-none', 'z-0');
            p.classList.add('opacity-100', 'z-10');
          } else {
            p.classList.add('opacity-0', 'pointer-events-none', 'z-0');
            p.classList.remove('opacity-100', 'z-10');
          }
        });
      };

      btn.addEventListener('mouseenter', activate);
      btn.addEventListener('click', activate);
    });
  }

  // Mobile accordion toggle
  const mobileToggles = document.querySelectorAll('.mobile-service-toggle');
  mobileToggles.forEach((t) => {
    t.addEventListener('click', () => {
      const targetId = t.getAttribute('data-target');
      const panel = document.getElementById(targetId || '');
      const icon = t.querySelector('svg');
      if (panel) {
        const isHidden = panel.classList.contains('hidden');
        panel.classList.toggle('hidden');
        t.setAttribute('aria-expanded', isHidden ? 'true' : 'false');
        if (icon) {
          icon.classList.toggle('rotate-180', isHidden);
          icon.classList.toggle('text-amber-brand', isHidden);
        }
      }
    });
  });
</script>
