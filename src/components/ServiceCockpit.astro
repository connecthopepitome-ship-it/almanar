---
import Icon from './Icon.astro';
import { SERVICES } from '../data/company';
---

<div class="service-cockpit-root w-full">
  <!-- Desktop Cockpit View (Hidden on mobile) -->
  <div class="hidden lg:grid grid-cols-12 gap-8 items-stretch">
    
    <!-- Left Column: Numbered Vertical Service List (5 cols, Sticky on Desktop) -->
    <div class="col-span-5 flex flex-col justify-between space-y-2 sticky top-28 self-start">
      <div class="space-y-1.5" role="tablist" aria-label="Al Manar Tech Engineering Divisions">
        {SERVICES.map((s, idx) => (
          <button 
            type="button" 
            role="tab"
            aria-selected={idx === 0 ? "true" : "false"}
            aria-controls={`cockpit-panel-${s.id}`}
            id={`tab-${s.id}`}
            data-index={idx}
            data-service-id={s.id}
            class={`service-tab-btn w-full text-left p-4 rounded-2xl transition-all duration-300 flex items-center justify-between group border cursor-pointer ${
              idx === 0 
                ? 'is-active glass-panel-navy border-amber-brand/40 text-white shadow-glass-floating' 
                : 'bg-transparent border-transparent text-slate-400 hover:text-white hover:bg-white/5'
            }`}
          >
            <div class="flex items-center gap-4">
              <span class={`tab-number font-mono text-xs font-bold transition-colors ${
                idx === 0 ? 'text-amber-brand' : 'text-slate-500 group-hover:text-amber-brand'
              }`}>
                {s.number}
              </span>
              <span class="font-display text-base font-bold tracking-tight">
                {s.shortTitle}
              </span>
            </div>

            <div class="flex items-center gap-2">
              <span class="font-mono text-[10px] uppercase tracking-wider text-slate-500 opacity-0 group-hover:opacity-100 transition-opacity">
                {s.category}
              </span>
              <Icon name="chevron-right" class={`tab-chevron w-4 h-4 transition-transform duration-300 ${
                idx === 0 ? 'text-amber-brand translate-x-1' : 'text-slate-600 group-hover:text-slate-300'
              }`} />
            </div>
          </button>
        ))}
      </div>

      <!-- Quick Indicator Footer -->
      <div class="p-4 rounded-2xl glass-panel-navy text-xs font-mono text-slate-400 flex items-center justify-between">
        <span>Certified Engineering Workforce</span>
        <span class="text-amber-brand font-semibold">ADDC &amp; Civil Defence Approved</span>
      </div>
    </div>

    <!-- Right Column: Large Glass Visual Deck (7 cols) -->
    <div class="col-span-7 relative glass-panel-navy rounded-3xl overflow-hidden crosshair-corner flex flex-col justify-between shadow-glass-floating min-h-[620px]">
      
      <!-- Panels for each service -->
      {SERVICES.map((s, idx) => (
        <div 
          id={`cockpit-panel-${s.id}`}
          role="tabpanel"
          aria-labelledby={`tab-${s.id}`}
          class={`cockpit-panel absolute inset-0 p-8 flex flex-col justify-between transition-all duration-500 ${
            idx === 0 ? 'opacity-100 z-10 pointer-events-auto' : 'opacity-0 pointer-events-none z-0'
          }`}
        >
          <!-- Top Telemetry & Image Preview Strip -->
          <div class="space-y-6">
            <div class="flex items-center justify-between pb-4 border-b border-white/5 font-mono text-xs text-slate-400">
              <div class="flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-amber-brand animate-ping"></span>
                <span class="text-white font-bold tracking-wider">Division {s.number} • {s.category}</span>
              </div>
              <span class="text-amber-brand tracking-widest">{s.specs[1]?.value}</span>
            </div>

            <!-- Image Container with Glass HUD Frame -->
            <div 
              class="service-popup-trigger relative aspect-[16/8] rounded-2xl overflow-hidden bg-navy-950 border border-white/10 group cursor-pointer" 
              data-service-id={s.id}
              data-cursor="view"
            >
              <img 
                src={s.heroImage} 
                alt={`${s.title} Engineering Execution in Abu Dhabi`}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-navy-950/95 via-navy-950/20 to-transparent"></div>
              
              <div class="absolute top-3 right-3 px-3 py-1 rounded-lg bg-navy-950/80 border border-white/10 text-[10px] font-mono text-amber-brand font-bold flex items-center gap-1.5 opacity-90 group-hover:opacity-100 transition-opacity">
                <span>VIEW SPECIFICATIONS</span>
                <Icon name="arrow-right" class="w-3 h-3 group-hover:translate-x-0.5 transition-transform" />
              </div>

              <div class="absolute bottom-3 left-4 right-4 flex items-center justify-between text-xs text-white">
                <span class="font-mono text-[11px] text-amber-brand font-semibold px-2.5 py-1 rounded-lg glass-panel-navy">
                  Division {s.number} • ADDC Approved
                </span>
                <span class="text-[11px] text-slate-300 font-mono">
                  {s.specs[0]?.label}: <strong class="text-white">{s.specs[0]?.value}</strong>
                </span>
              </div>
            </div>

            <!-- Text & Technical Scope -->
            <div class="space-y-2">
              <h3 class="text-2xl font-extrabold text-white font-display tracking-tight">
                {s.title}
              </h3>
              <p class="text-xs font-mono text-amber-brand font-semibold">
                {s.tagline}
              </p>
              <p class="text-sm text-slate-300 leading-relaxed line-clamp-3 font-sans">
                {s.description}
              </p>
            </div>

            <!-- Technical Specifications Grid -->
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5 pt-2">
              {s.specs.map((sp) => (
                <div class="p-3 rounded-xl glass-panel-navy border border-white/5 font-mono text-[11px]">
                  <span class="text-slate-400 block text-[9px] uppercase tracking-wider">{sp.label}</span>
                  <span class="text-white font-semibold truncate block mt-0.5">{sp.value}</span>
                </div>
              ))}
            </div>
          </div>

          <!-- Bottom Action Bar -->
          <div class="pt-6 border-t border-white/5 flex flex-wrap items-center justify-between gap-4 mt-4 font-display">
            <!-- Pop-Up Detail Trigger Button -->
            <button 
              type="button"
              class="service-popup-trigger inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-[#F07842] text-[#111920] text-xs font-bold uppercase tracking-wider hover:bg-[#D96532] transition-all shadow-md shadow-[#F07842]/20 cursor-pointer"
              data-service-id={s.id}
            >
              <span>View Full Technical Scope</span>
              <Icon name="arrow-right" class="w-3.5 h-3.5" />
            </button>

            <a 
              href="#contact" 
              data-service-select={s.title}
              class="quote-select-trigger text-xs font-mono text-[#F07842] hover:text-white transition-colors flex items-center gap-1.5 font-bold cursor-pointer"
            >
              <span>Request a Quote</span>
              <Icon name="chevron-right" class="w-3.5 h-3.5" />
            </a>
          </div>
        </div>
      ))}

    </div>
  </div>

  <!-- Mobile View: Clean Expandable Accordion with Popup Trigger -->
  <div class="lg:hidden space-y-4">
    {SERVICES.map((s, idx) => (
      <div class="glass-panel-navy rounded-2xl overflow-hidden border border-white/10">
        <button 
          type="button" 
          class="mobile-service-toggle w-full p-4 flex items-center justify-between text-left text-white font-display font-bold text-base cursor-pointer"
          aria-expanded={idx === 0 ? "true" : "false"}
          data-target={`mob-panel-${s.id}`}
        >
          <div class="flex items-center gap-3">
            <span class="font-mono text-xs text-amber-brand font-bold">{s.number}</span>
            <span>{s.shortTitle}</span>
          </div>
          <Icon name="chevron-down" class={`w-4 h-4 text-slate-400 transition-transform duration-300 ${idx === 0 ? 'rotate-180 text-amber-brand' : ''}`} />
        </button>

        <div id={`mob-panel-${s.id}`} class={`mobile-service-panel p-4 pt-0 space-y-4 border-t border-white/5 ${idx === 0 ? '' : 'hidden'}`}>
          <div 
            class="service-popup-trigger aspect-video rounded-xl overflow-hidden bg-navy-950 mt-3 relative group cursor-pointer"
            data-service-id={s.id}
          >
            <img src={s.heroImage} alt={s.title} class="w-full h-full object-cover" loading="lazy" />
            <div class="absolute inset-0 bg-gradient-to-t from-navy-950/80 to-transparent flex items-end p-3">
              <span class="text-[10px] font-mono text-amber-brand font-bold">TAP TO VIEW FULL SPECIFICATIONS →</span>
            </div>
          </div>
          <p class="text-xs text-slate-300 leading-relaxed font-sans">{s.description}</p>
          <div class="pt-2 flex items-center gap-3">
            <button 
              type="button"
              class="service-popup-trigger flex-1 inline-flex items-center justify-center gap-2 py-3 rounded-xl bg-white/5 border border-white/10 text-white font-display text-xs font-bold uppercase tracking-wider hover:bg-white/10 transition-colors cursor-pointer"
              data-service-id={s.id}
            >
              <span>View Specifications</span>
              <Icon name="arrow-right" class="w-3.5 h-3.5" />
            </button>
            <a 
              href="#contact" 
              data-service-select={s.title}
              class="quote-select-trigger flex-1 inline-flex items-center justify-center gap-2 py-3 rounded-xl bg-[#F07842] text-[#111920] font-display text-xs font-bold uppercase tracking-wider hover:bg-[#D96532] transition-colors"
            >
              <span>Request Quote</span>
            </a>
          </div>
        </div>
      </div>
    ))}
  </div>

  <!-- =========================================================================
       ENGINEERING DIVISION SPECIFICATION MODAL POPUP
       ========================================================================= -->
  <div 
    id="service-cockpit-modal" 
    class="fixed inset-0 z-[100] flex items-end sm:items-center justify-center p-0 sm:p-6 opacity-0 pointer-events-none transition-all duration-300"
    role="dialog"
    aria-modal="true"
    aria-hidden="true"
  >
    <!-- Dark Backdrop with Obsidian Blur -->
    <div id="service-modal-backdrop" class="absolute inset-0 bg-[#0B1117]/85 backdrop-blur-xl transition-opacity"></div>

    <!-- Modal Dialog Window / Mobile Native Bottom Sheet -->
    <div class="relative w-full max-w-3xl max-h-[92vh] sm:max-h-[90vh] bg-[#111920] border-t sm:border border-amber-brand/40 rounded-t-3xl sm:rounded-3xl shadow-2xl overflow-hidden flex flex-col z-10 glass-panel-navy">
      
      <!-- Mobile Drag Handle -->
      <div class="pt-3 pb-1 flex justify-center sm:hidden">
        <div class="w-12 h-1.5 rounded-full bg-white/20"></div>
      </div>

      <!-- Modal Top Header Bar -->
      <div class="px-6 py-4 border-b border-white/10 flex items-center justify-between bg-navy-950/90 sticky top-0 z-20">
        <div class="flex items-center gap-3">
          <span class="w-2.5 h-2.5 rounded-full bg-amber-brand animate-ping"></span>
          <span id="modal-eyebrow-text" class="font-mono text-xs font-bold text-amber-brand uppercase tracking-wider">
            DIVISION SPECIFICATION
          </span>
        </div>
        <button 
          id="close-service-modal-btn"
          type="button"
          class="p-2 rounded-xl text-slate-400 hover:text-white hover:bg-white/10 transition-colors cursor-pointer"
          aria-label="Close division specifications modal"
        >
          <Icon name="x" class="w-5 h-5" />
        </button>
      </div>

      <!-- Modal Body (Scrollable panels for each service) -->
      <div class="p-6 sm:p-8 overflow-y-auto space-y-6 max-h-[calc(90vh-140px)]">
        {SERVICES.map((s) => (
          <div id={`modal-detail-${s.id}`} class="service-modal-content hidden space-y-6">
            
            <!-- Hero Title & Tags -->
            <div class="space-y-2">
              <div class="flex flex-wrap items-center justify-between gap-2 font-mono text-[11px]">
                <span class="px-2.5 py-0.5 rounded-lg bg-amber-brand/10 border border-amber-brand/30 text-amber-brand font-bold uppercase tracking-widest">
                  Division {s.number} • {s.category}
                </span>
                <span class="px-2.5 py-0.5 rounded-lg bg-white/5 border border-white/10 text-slate-300 font-semibold uppercase tracking-wider">
                  ADDC &amp; Civil Defence Approved
                </span>
              </div>

              <h2 class="text-2xl sm:text-3xl font-extrabold text-white font-display tracking-tight pt-1">
                {s.title}
              </h2>
              <p class="font-mono text-xs sm:text-sm text-amber-brand font-semibold">
                {s.tagline}
              </p>
            </div>

            <!-- Photorealistic Installation Frame -->
            <div class="relative aspect-[16/9] sm:aspect-[21/9] rounded-2xl overflow-hidden bg-navy-950 border border-white/10">
              <img 
                src={s.heroImage} 
                alt={`${s.title} Engineering Execution in Abu Dhabi`}
                class="w-full h-full object-cover"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-navy-950/90 via-navy-950/20 to-transparent"></div>
              <div class="absolute bottom-3 left-4 right-4 flex items-center justify-between text-xs font-mono">
                <span class="text-amber-brand font-bold px-2 py-0.5 rounded bg-navy-950/80 border border-amber-brand/30">
                  Division {s.number} • Licensed Execution
                </span>
                <span class="text-slate-300 px-2 py-0.5 rounded bg-navy-950/80 border border-white/10">
                  {s.specs[0]?.label}: <strong class="text-white">{s.specs[0]?.value}</strong>
                </span>
              </div>
            </div>

            <!-- Overview Description -->
            <div class="space-y-2">
              <h4 class="font-mono text-xs uppercase tracking-widest text-slate-400 font-bold">
                DIVISION OVERVIEW &amp; CAPABILITIES
              </h4>
              <p class="text-sm text-slate-300 leading-relaxed font-sans">
                {s.description}
              </p>
            </div>

            <!-- Technical Specifications Grid -->
            <div class="space-y-2">
              <h4 class="font-mono text-xs uppercase tracking-widest text-slate-400 font-bold">
                ENGINEERING METRICS &amp; STANDARDS
              </h4>
              <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
                {s.specs.map((sp) => (
                  <div class="p-3.5 rounded-xl bg-navy-950/70 border border-white/10 font-mono">
                    <span class="text-slate-400 block text-[10px] uppercase tracking-wider">{sp.label}</span>
                    <span class="text-white font-bold text-xs truncate block mt-1">{sp.value}</span>
                  </div>
                ))}
              </div>
            </div>

            <!-- Technical Scope of Work / Highlights -->
            {s.technicalHighlights && s.technicalHighlights.length > 0 && (
              <div class="space-y-3 pt-2">
                <h4 class="font-mono text-xs uppercase tracking-widest text-slate-400 font-bold">
                  CORE TECHNICAL SCOPE OF WORK
                </h4>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
                  {s.technicalHighlights.map((hl) => (
                    <div class="p-3 rounded-xl bg-navy-950/40 border border-white/5 flex items-start gap-2.5 text-xs text-slate-300 font-sans">
                      <span class="text-amber-brand shrink-0 mt-0.5">✔</span>
                      <span class="leading-relaxed">{hl}</span>
                    </div>
                  ))}
                </div>
              </div>
            )}

            <!-- Regulatory Standards & Approvals -->
            {s.regulations && s.regulations.length > 0 && (
              <div class="space-y-2 pt-1">
                <h4 class="font-mono text-xs uppercase tracking-widest text-slate-400 font-bold">
                  APPLICABLE UAE STATUTORY STANDARDS
                </h4>
                <div class="flex flex-wrap gap-2">
                  {s.regulations.map((reg) => (
                    <span class="px-3 py-1 rounded-lg bg-white/5 border border-white/10 font-mono text-[11px] text-slate-300">
                      {reg}
                    </span>
                  ))}
                </div>
              </div>
            )}

            <!-- Modal Action Buttons -->
            <div class="pt-6 border-t border-white/10 flex flex-wrap items-center justify-between gap-4 font-display">
              <a 
                href="#contact" 
                data-service-select={s.title}
                class="modal-quote-btn flex-1 sm:flex-initial inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-[#F07842] text-[#111920] text-xs font-bold uppercase tracking-wider hover:bg-[#D96532] transition-all shadow-lg shadow-[#F07842]/25 cursor-pointer"
              >
                <span>Request Quotation for {s.shortTitle}</span>
                <Icon name="arrow-right" class="w-3.5 h-3.5" />
              </a>

              <a 
                href={`/services/${s.slug}`}
                class="flex-1 sm:flex-initial inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-white/5 border border-white/10 text-white text-xs font-bold uppercase tracking-wider hover:bg-white/10 hover:border-white/20 transition-all"
              >
                <span>Full Division Page</span>
                <Icon name="arrow-right" class="w-3.5 h-3.5" />
              </a>
            </div>

          </div>
        ))}
      </div>

    </div>
  </div>

</div>

<script>
  // Tab Switching Logic
  const tabBtns = document.querySelectorAll('.service-tab-btn');
  const panels = document.querySelectorAll('.cockpit-panel');

  function activateTab(indexStr: string | null) {
    if (!indexStr) return;

    tabBtns.forEach((b) => {
      const idx = b.getAttribute('data-index');
      const isSelected = idx === indexStr;
      const num = b.querySelector('.tab-number');
      const chev = b.querySelector('.tab-chevron');

      b.setAttribute('aria-selected', isSelected ? 'true' : 'false');
      
      if (isSelected) {
        b.classList.add('is-active', 'glass-panel-navy', 'border-amber-brand/40', 'text-white', 'shadow-glass-floating');
        b.classList.remove('bg-transparent', 'border-transparent', 'text-slate-400');
        if (num) {
          num.classList.add('text-amber-brand');
          num.classList.remove('text-slate-500');
        }
        if (chev) {
          chev.classList.add('text-amber-brand', 'translate-x-1');
          chev.classList.remove('text-slate-600');
        }
      } else {
        b.classList.remove('is-active', 'glass-panel-navy', 'border-amber-brand/40', 'text-white', 'shadow-glass-floating');
        b.classList.add('bg-transparent', 'border-transparent', 'text-slate-400');
        if (num) {
          num.classList.remove('text-amber-brand');
          num.classList.add('text-slate-500');
        }
        if (chev) {
          chev.classList.remove('text-amber-brand', 'translate-x-1');
          chev.classList.add('text-slate-600');
        }
      }
    });

    panels.forEach((p, i) => {
      if (i.toString() === indexStr) {
        p.classList.remove('opacity-0', 'pointer-events-none', 'z-0');
        p.classList.add('opacity-100', 'z-10', 'pointer-events-auto');
      } else {
        p.classList.add('opacity-0', 'pointer-events-none', 'z-0');
        p.classList.remove('opacity-100', 'z-10', 'pointer-events-auto');
      }
    });
  }

  // Set up tab events
  tabBtns.forEach((btn) => {
    btn.addEventListener('mouseenter', () => {
      activateTab(btn.getAttribute('data-index'));
    });

    btn.addEventListener('click', () => {
      const serviceId = btn.getAttribute('data-service-id');
      activateTab(btn.getAttribute('data-index'));
      if (serviceId) {
        openServiceModal(serviceId);
      }
    });
  });

  // Modal Functionality
  const modal = document.getElementById('service-cockpit-modal');
  const modalBackdrop = document.getElementById('service-modal-backdrop');
  const closeModalBtn = document.getElementById('close-service-modal-btn');
  const modalPanels = document.querySelectorAll('.service-modal-content');
  const modalEyebrow = document.getElementById('modal-eyebrow-text');

  function openServiceModal(serviceId: string) {
    if (!modal) return;

    // Show matching panel, hide others
    modalPanels.forEach((panel) => {
      if (panel.id === `modal-detail-${serviceId}`) {
        panel.classList.remove('hidden');
      } else {
        panel.classList.add('hidden');
      }
    });

    if (modalEyebrow) {
      modalEyebrow.textContent = `Division Technical Scope • ${serviceId.toUpperCase()}`;
    }

    // Show modal dialog
    modal.classList.remove('opacity-0', 'pointer-events-none');
    modal.classList.add('opacity-100', 'pointer-events-auto');
    modal.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }

  function closeServiceModal() {
    if (!modal) return;
    modal.classList.add('opacity-0', 'pointer-events-none');
    modal.classList.remove('opacity-100', 'pointer-events-auto');
    modal.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  // Triggers for opening the modal
  const popupTriggers = document.querySelectorAll('.service-popup-trigger');
  popupTriggers.forEach((trigger) => {
    trigger.addEventListener('click', (e) => {
      e.stopPropagation();
      const serviceId = trigger.getAttribute('data-service-id');
      if (serviceId) {
        openServiceModal(serviceId);
      }
    });
  });

  // Close triggers
  if (closeModalBtn) {
    closeModalBtn.addEventListener('click', closeServiceModal);
  }
  if (modalBackdrop) {
    modalBackdrop.addEventListener('click', closeServiceModal);
  }

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal && !modal.classList.contains('pointer-events-none')) {
      closeServiceModal();
    }
  });

  // Pre-select service in Contact Form on Request a Quote click
  const quoteTriggers = document.querySelectorAll('.quote-select-trigger, .modal-quote-btn');
  quoteTriggers.forEach((trigger) => {
    trigger.addEventListener('click', () => {
      closeServiceModal();
      const targetService = trigger.getAttribute('data-service-select');
      const selectElem = document.getElementById('service') as HTMLSelectElement | null;
      if (selectElem && targetService) {
        for (let i = 0; i < selectElem.options.length; i++) {
          if (selectElem.options[i].value === targetService || selectElem.options[i].text.includes(targetService)) {
            selectElem.selectedIndex = i;
            break;
          }
        }
      }
    });
  });

  // Mobile accordion toggle
  const mobileToggles = document.querySelectorAll('.mobile-service-toggle');
  mobileToggles.forEach((t) => {
    t.addEventListener('click', () => {
      const targetId = t.getAttribute('data-target');
      const panel = document.getElementById(targetId || '');
      const icon = t.querySelector('svg');
      if (panel) {
        const isHidden = panel.classList.contains('hidden');
        panel.classList.toggle('hidden');
        t.setAttribute('aria-expanded', isHidden ? 'true' : 'false');
        if (icon) {
          icon.classList.toggle('rotate-180', isHidden);
          icon.classList.toggle('text-amber-brand', isHidden);
        }
      }
    });
  });
</script>
