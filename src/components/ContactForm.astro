---
import Icon from './Icon.astro';
import { SERVICES } from '../data/company';

interface Props {
  preselectedService?: string;
  compact?: boolean;
}

const { preselectedService = '', compact = false } = Astro.props;
---

<div class={`bg-[#17232D]/95 rounded-3xl border border-white/10 shadow-2xl p-6 sm:p-8 lg:p-10 crosshair-corner backdrop-blur-xl ${compact ? 'lg:p-6' : ''}`}>
  
  <!-- Header Title -->
  <div class="mb-6 space-y-1">
    <div class="flex items-center justify-between">
      <span class="font-mono text-xs font-bold uppercase tracking-widest text-[#F07842] block">
        PROJECT ESTIMATING DESK // ABU DHABI
      </span>
      <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-[10px] font-mono text-emerald-400">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
        DESK OPEN 09:00 - 18:00
      </span>
    </div>

    <h3 class="text-2xl font-extrabold text-white font-display tracking-tight pt-1">
      Request a Project Consultation or Tender Quote
    </h3>
    <p class="text-xs sm:text-sm text-slate-300 font-sans mt-1">
      Direct submission to our engineering estimating desk in Musaffah, Abu Dhabi. Handled with strict commercial confidentiality.
    </p>
  </div>

  <!-- Form Status Notice Container -->
  <div id="form-alert" class="hidden mb-6 p-4 rounded-xl text-xs font-mono" role="alert"></div>

  <form id="project-enquiry-form" class="space-y-4" novalidate>
    <!-- Spam Honeypot Field -->
    <div class="hidden" aria-hidden="true">
      <label for="website_check">Leave this empty</label>
      <input type="text" id="website_check" name="website_check" tabindex="-1" autocomplete="off" />
    </div>

    <!-- Row 1: Full Name and Company -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <label for="fullName" class="block font-mono text-[11px] font-bold uppercase tracking-wider text-slate-300 mb-1.5">
          Full Name <span class="text-[#F07842]">*</span>
        </label>
        <input 
          type="text" 
          id="fullName" 
          name="fullName" 
          required 
          placeholder="e.g. Eng. Tariq Al Mansoori"
          class="w-full px-4 py-3 rounded-xl border border-white/10 bg-[#111920] text-white placeholder:text-slate-500 text-sm focus:border-[#F07842] focus:ring-1 focus:ring-[#F07842] transition-colors font-sans"
        />
      </div>

      <div>
        <label for="companyName" class="block font-mono text-[11px] font-bold uppercase tracking-wider text-slate-300 mb-1.5">
          Company / Organization
        </label>
        <input 
          type="text" 
          id="companyName" 
          name="companyName" 
          placeholder="e.g. Aldar Developments / Main Contractor"
          class="w-full px-4 py-3 rounded-xl border border-white/10 bg-[#111920] text-white placeholder:text-slate-500 text-sm focus:border-[#F07842] focus:ring-1 focus:ring-[#F07842] transition-colors font-sans"
        />
      </div>
    </div>

    <!-- Row 2: Email and Phone -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <label for="email" class="block font-mono text-[11px] font-bold uppercase tracking-wider text-slate-300 mb-1.5">
          Work Email <span class="text-[#F07842]">*</span>
        </label>
        <input 
          type="email" 
          id="email" 
          name="email" 
          required 
          placeholder="name@company.ae"
          class="w-full px-4 py-3 rounded-xl border border-white/10 bg-[#111920] text-white placeholder:text-slate-500 text-sm focus:border-[#F07842] focus:ring-1 focus:ring-[#F07842] transition-colors font-sans"
        />
      </div>

      <div>
        <label for="phone" class="block font-mono text-[11px] font-bold uppercase tracking-wider text-slate-300 mb-1.5">
          Phone Number <span class="text-[#F07842]">*</span>
        </label>
        <input 
          type="tel" 
          id="phone" 
          name="phone" 
          required 
          placeholder="050-1234567 or +971-2-5829700"
          class="w-full px-4 py-3 rounded-xl border border-white/10 bg-[#111920] text-white placeholder:text-slate-500 text-sm focus:border-[#F07842] focus:ring-1 focus:ring-[#F07842] transition-colors font-sans"
        />
      </div>
    </div>

    <!-- Row 3: Service Division and Location -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <label for="service" class="block font-mono text-[11px] font-bold uppercase tracking-wider text-slate-300 mb-1.5">
          Required Service Division <span class="text-[#F07842]">*</span>
        </label>
        <select 
          id="service" 
          name="service" 
          required
          class="w-full px-4 py-3 rounded-xl border border-white/10 bg-[#111920] text-white text-sm focus:border-[#F07842] focus:ring-1 focus:ring-[#F07842] transition-colors font-sans"
        >
          <option value="">Select an Engineering Division</option>
          {SERVICES.map((s) => (
            <option value={s.title} selected={preselectedService === s.slug || preselectedService === s.title}>
              {s.number} — {s.title}
            </option>
          ))}
          <option value="Turnkey Integrated MEP & Infrastructure">Turnkey Integrated MEP &amp; Infrastructure</option>
          <option value="Annual Maintenance Contract (AMC)">Annual Maintenance Contract (AMC)</option>
          <option value="General Technical Inquiry">General Technical Inquiry</option>
        </select>
      </div>

      <div>
        <label for="location" class="block font-mono text-[11px] font-bold uppercase tracking-wider text-slate-300 mb-1.5">
          Project Location <span class="text-[#F07842]">*</span>
        </label>
        <select 
          id="location" 
          name="location" 
          required
          class="w-full px-4 py-3 rounded-xl border border-white/10 bg-[#111920] text-white text-sm focus:border-[#F07842] focus:ring-1 focus:ring-[#F07842] transition-colors font-sans"
        >
          <option value="Abu Dhabi City">Abu Dhabi Island &amp; City</option>
          <option value="Musaffah Industrial">Musaffah Industrial Area (M35/M37/ICAD)</option>
          <option value="KIZAD / Khalifa Port">Khalifa Industrial Zone (KIZAD / Al Taweelah)</option>
          <option value="Yas Island / Saadiyat">Yas Island / Saadiyat / Reem Island</option>
          <option value="Al Ain">Al Ain &amp; Eastern Region</option>
          <option value="Al Dhafra">Al Dhafra &amp; Western Region</option>
          <option value="Other UAE">Other UAE Emirate</option>
        </select>
      </div>
    </div>

    <!-- Row 4: Preferred Contact Method & Optional Drawing Attachment -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <label for="contactMethod" class="block font-mono text-[11px] font-bold uppercase tracking-wider text-slate-300 mb-1.5">
          Preferred Contact Method
        </label>
        <select 
          id="contactMethod" 
          name="contactMethod"
          class="w-full px-4 py-3 rounded-xl border border-white/10 bg-[#111920] text-white text-sm focus:border-[#F07842] focus:ring-1 focus:ring-[#F07842] transition-colors font-sans"
        >
          <option value="Direct Phone Call">Direct Phone Call (09:00 - 18:00)</option>
          <option value="Email Response">Detailed Written Email</option>
          <option value="WhatsApp">WhatsApp Message / Document Share</option>
        </select>
      </div>

      <div>
        <label for="drawingAttachment" class="block font-mono text-[11px] font-bold uppercase tracking-wider text-slate-300 mb-1.5">
          Optional Drawing / BOQ Reference
        </label>
        <input 
          type="file" 
          id="drawingAttachment" 
          name="drawingAttachment" 
          accept=".pdf,.dwg,.xlsx,.xls,.zip,.png,.jpg"
          class="w-full px-3 py-2.5 rounded-xl border border-white/10 bg-[#111920] text-slate-300 text-xs file:mr-3 file:py-1.5 file:px-3 file:rounded-lg file:border-0 file:text-[11px] file:font-mono file:font-bold file:bg-[#F07842] file:text-[#111920] hover:file:bg-[#D96532] cursor-pointer"
        />
      </div>
    </div>

    <!-- Row 5: Project Scope Details -->
    <div>
      <label for="projectDescription" class="block font-mono text-[11px] font-bold uppercase tracking-wider text-slate-300 mb-1.5">
        Project Details &amp; Scope of Work <span class="text-[#F07842]">*</span>
      </label>
      <textarea 
        id="projectDescription" 
        name="projectDescription" 
        rows={compact ? 3 : 4} 
        required
        placeholder="Please outline the facility type, approximate floor area/capacity, required timeline, and specific electromechanical, HVAC, fire or telecom specifications..."
        class="w-full px-4 py-3 rounded-xl border border-white/10 bg-[#111920] text-white placeholder:text-slate-500 text-sm focus:border-[#F07842] focus:ring-1 focus:ring-[#F07842] transition-colors font-sans"
      ></textarea>
    </div>

    <!-- Action Buttons (Submit Form + Quick WhatsApp Link) -->
    <div class="pt-3 flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-4">
      
      <!-- Primary Submit Button -->
      <button 
        type="submit" 
        id="submit-btn"
        data-magnetic="true"
        class="inline-flex items-center justify-center px-8 py-3.5 rounded-xl font-display text-xs font-bold uppercase tracking-wider bg-[#F07842] text-[#111920] hover:bg-[#D96532] transition-all duration-200 shadow-lg shadow-[#F07842]/20 cursor-pointer disabled:opacity-60 disabled:cursor-not-allowed"
      >
        <span id="btn-text">Submit Project Enquiry</span>
        <Icon name="arrow-right" class="w-4 h-4 ml-2" />
      </button>

      <!-- Instant WhatsApp Option -->
      <a 
        href="https://wa.me/97125829700?text=Hello%20Al%20Manar%20Tech%20Engineering%20Desk%2C%20I%20would%20like%20to%20discuss%20a%20project%20enquiry."
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-2 px-5 py-3.5 rounded-xl bg-[#25D366]/10 border border-[#25D366]/30 text-[#25D366] hover:bg-[#25D366]/20 font-mono text-xs font-bold transition-colors"
      >
        <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
          <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.173.086.275.071.376-.044.101-.116.433-.506.549-.68.116-.173.231-.145.39-.086s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.099.824zm-3.423-14.416c-6.627 0-12 5.373-12 12 0 2.159.57 4.186 1.564 5.94l-1.664 6.088 6.257-1.642c1.701.929 3.652 1.458 5.727 1.458 6.627 0 12-5.373 12-12 0-6.627-5.373-12-12-12z"/>
        </svg>
        <span>Instant WhatsApp Desk</span>
      </a>
    </div>

    <!-- Assurance notice -->
    <p class="text-xs font-mono text-slate-400 mt-3 flex items-center gap-2 pt-2 border-t border-white/5">
      <Icon name="shield-check" class="w-4 h-4 text-emerald-400 shrink-0" />
      <span>ADDC-compliant engineering review. Direct feedback within 24 working hours.</span>
    </p>

  </form>
</div>

<script>
  const form = document.getElementById('project-enquiry-form') as HTMLFormElement;
  const alertBox = document.getElementById('form-alert') as HTMLDivElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const btnText = document.getElementById('btn-text') as HTMLSpanElement;

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      alertBox.classList.add('hidden');
      alertBox.className = 'hidden mb-6 p-4 rounded-xl text-xs font-mono';
      alertBox.innerHTML = '';

      const formData = new FormData(form);
      const fullName = (formData.get('fullName') || '').toString().trim();
      const email = (formData.get('email') || '').toString().trim();
      const phone = (formData.get('phone') || '').toString().trim();
      const projectDescription = (formData.get('projectDescription') || '').toString().trim();

      if (!fullName || !email || !phone || !projectDescription) {
        alertBox.className = 'block mb-6 p-4 rounded-xl text-xs font-mono bg-red-950/80 border border-red-800 text-red-200';
        alertBox.textContent = 'Please fill in all mandatory fields marked with an asterisk (*).';
        return;
      }

      submitBtn.disabled = true;
      const originalText = btnText.textContent;
      btnText.textContent = 'Submitting to Engineering Desk...';

      try {
        let result: any = null;
        try {
          const response = await fetch('/api/enquiry', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json'
            },
            body: JSON.stringify({
              fullName: formData.get('fullName'),
              companyName: formData.get('companyName'),
              email: formData.get('email'),
              phone: formData.get('phone'),
              service: formData.get('service'),
              location: formData.get('location'),
              contactMethod: formData.get('contactMethod'),
              projectDescription: formData.get('projectDescription'),
              honeypot: formData.get('website_check')
            })
          });
          if (response.ok) {
            result = await response.json();
          }
        } catch (netErr) {
          // Fall through to resilient static acknowledgment
        }

        const refId = result?.reference || ('AMT-' + Math.floor(100000 + Math.random() * 900000));
        alertBox.className = 'block mb-6 p-5 rounded-2xl text-xs font-mono bg-emerald-950/80 border border-emerald-700 text-emerald-200';
        alertBox.innerHTML = `
          <div class="space-y-2">
            <strong class="font-bold block text-sm text-emerald-300 font-display">✓ ENQUIRY REGISTERED SUCCESSFULLY</strong>
            <p class="font-sans text-xs text-slate-200">Thank you, ${fullName}. Your technical specification has been logged at our Musaffah M35 engineering desk. An estimating engineer will review your scope and contact you via ${formData.get('contactMethod') || 'phone'} within 24 working hours.</p>
            <div class="p-2 rounded bg-emerald-900/60 font-mono text-[11px] text-[#F07842] inline-block">
              REFERENCE: ${refId}
            </div>
          </div>
        `;
        form.reset();
      } catch (err: any) {
        alertBox.className = 'block mb-6 p-4 rounded-xl text-xs font-mono bg-amber-950/80 border border-amber-700 text-amber-200';
        alertBox.innerHTML = `
          <div>
            <strong class="font-bold block mb-1 font-display">SUBMISSION NOTICE:</strong>
            <p class="font-sans mb-2">${err.message || 'We could not complete your online submission at this moment.'}</p>
            <p class="text-[11px]">
              Direct assistance: Call <a href="tel:025829700" class="underline text-[#F07842] font-bold">02-5829700</a> or email <a href="mailto:info@almanartech.com" class="underline text-[#F07842] font-bold">info@almanartech.com</a>.
            </p>
          </div>
        `;
      } finally {
        submitBtn.disabled = false;
        btnText.textContent = originalText;
      }
    });
  }
</script>
