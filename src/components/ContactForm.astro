---
import Icon from './Icon.astro';
import { SERVICES } from '../data/company';

interface Props {
  preselectedService?: string;
  compact?: boolean;
}

const { preselectedService = '', compact = false } = Astro.props;
---

<div class={`bg-white rounded-2xl border border-cloud-200 shadow-premium p-6 sm:p-8 lg:p-10 ${compact ? 'lg:p-6' : ''}`}>
  <div class="mb-6">
    <span class="text-xs font-bold uppercase tracking-wider text-gold-600 block mb-1">
      Official Engineering Desk
    </span>
    <h3 class="text-2xl font-bold text-navy-900 font-heading">
      Request a Project Consultation or Tender Quote
    </h3>
    <p class="text-sm text-slate-custom mt-1">
      Direct submission to our engineering estimating desk in Abu Dhabi. All project scopes are handled with strict commercial confidentiality.
    </p>
  </div>

  <!-- Form Status Notice Container -->
  <div id="form-alert" class="hidden mb-6 p-4 rounded-xl text-sm" role="alert"></div>

  <form id="project-enquiry-form" class="space-y-4" novalidate>
    <!-- Spam Honeypot Field (Hidden from humans) -->
    <div class="hidden" aria-hidden="true">
      <label for="website_check">Leave this empty</label>
      <input type="text" id="website_check" name="website_check" tabindex="-1" autocomplete="off" />
    </div>

    <!-- Row 1: Name and Company -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <label for="fullName" class="block text-xs font-semibold uppercase tracking-wider text-navy-900 mb-1.5">
          Full Name <span class="text-red-500">*</span>
        </label>
        <input 
          type="text" 
          id="fullName" 
          name="fullName" 
          required 
          placeholder="e.g. Eng. Tariq Al Mansoori"
          class="w-full px-4 py-3 rounded-lg border border-cloud-300 text-navy-900 placeholder:text-slate-400 text-sm focus:border-gold-500 focus:ring-1 focus:ring-gold-500 transition-colors"
        />
      </div>

      <div>
        <label for="companyName" class="block text-xs font-semibold uppercase tracking-wider text-navy-900 mb-1.5">
          Company / Organization
        </label>
        <input 
          type="text" 
          id="companyName" 
          name="companyName" 
          placeholder="e.g. Al Dar Developments"
          class="w-full px-4 py-3 rounded-lg border border-cloud-300 text-navy-900 placeholder:text-slate-400 text-sm focus:border-gold-500 focus:ring-1 focus:ring-gold-500 transition-colors"
        />
      </div>
    </div>

    <!-- Row 2: Email and Phone -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <label for="email" class="block text-xs font-semibold uppercase tracking-wider text-navy-900 mb-1.5">
          Work Email <span class="text-red-500">*</span>
        </label>
        <input 
          type="email" 
          id="email" 
          name="email" 
          required 
          placeholder="name@company.ae"
          class="w-full px-4 py-3 rounded-lg border border-cloud-300 text-navy-900 placeholder:text-slate-400 text-sm focus:border-gold-500 focus:ring-1 focus:ring-gold-500 transition-colors"
        />
      </div>

      <div>
        <label for="phone" class="block text-xs font-semibold uppercase tracking-wider text-navy-900 mb-1.5">
          Phone Number <span class="text-red-500">*</span>
        </label>
        <input 
          type="tel" 
          id="phone" 
          name="phone" 
          required 
          placeholder="050-1234567 or 02-5829700"
          class="w-full px-4 py-3 rounded-lg border border-cloud-300 text-navy-900 placeholder:text-slate-400 text-sm focus:border-gold-500 focus:ring-1 focus:ring-gold-500 transition-colors"
        />
      </div>
    </div>

    <!-- Row 3: Service Division and Location -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <label for="service" class="block text-xs font-semibold uppercase tracking-wider text-navy-900 mb-1.5">
          Required Service Division <span class="text-red-500">*</span>
        </label>
        <select 
          id="service" 
          name="service" 
          required
          class="w-full px-4 py-3 rounded-lg border border-cloud-300 text-navy-900 text-sm focus:border-gold-500 focus:ring-1 focus:ring-gold-500 transition-colors bg-white"
        >
          <option value="">Select an Engineering Division</option>
          {SERVICES.map((s) => (
            <option value={s.title} selected={preselectedService === s.slug || preselectedService === s.title}>
              {s.title}
            </option>
          ))}
          <option value="Turnkey Integrated MEP & Infrastructure">Turnkey Integrated MEP & Infrastructure</option>
          <option value="Annual Maintenance Contract (AMC)">Annual Maintenance Contract (AMC)</option>
          <option value="General Technical Inquiry">General Technical Inquiry</option>
        </select>
      </div>

      <div>
        <label for="location" class="block text-xs font-semibold uppercase tracking-wider text-navy-900 mb-1.5">
          Project Location <span class="text-red-500">*</span>
        </label>
        <select 
          id="location" 
          name="location" 
          required
          class="w-full px-4 py-3 rounded-lg border border-cloud-300 text-navy-900 text-sm focus:border-gold-500 focus:ring-1 focus:ring-gold-500 transition-colors bg-white"
        >
          <option value="Abu Dhabi City">Abu Dhabi Island & City</option>
          <option value="Musaffah Industrial">Musaffah Industrial Area (M35/M37/ICAD)</option>
          <option value="KIZAD / Khalifa Port">Khalifa Industrial Zone (KIZAD / Al Taweelah)</option>
          <option value="Yas Island / Saadiyat">Yas Island / Saadiyat / Reem Island</option>
          <option value="Al Ain">Al Ain & Eastern Region</option>
          <option value="Al Dhafra">Al Dhafra & Western Region</option>
          <option value="Other UAE">Other UAE Emirate</option>
        </select>
      </div>
    </div>

    <!-- Row 4: Project Scope Description -->
    <div>
      <label for="projectDescription" class="block text-xs font-semibold uppercase tracking-wider text-navy-900 mb-1.5">
        Project Details & Scope of Work <span class="text-red-500">*</span>
      </label>
      <textarea 
        id="projectDescription" 
        name="projectDescription" 
        rows={compact ? 3 : 4} 
        required
        placeholder="Please outline the type of facility, approximate floor area/capacity, required timeline, and specific electromechanical, HVAC, fire or telecom specifications..."
        class="w-full px-4 py-3 rounded-lg border border-cloud-300 text-navy-900 placeholder:text-slate-400 text-sm focus:border-gold-500 focus:ring-1 focus:ring-gold-500 transition-colors"
      ></textarea>
    </div>

    <!-- Submit Button & Assurances -->
    <div class="pt-2">
      <button 
        type="submit" 
        id="submit-btn"
        class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-3.5 rounded-lg text-sm font-bold bg-gold-500 text-navy-950 hover:bg-gold-400 transition-all duration-200 shadow-md hover:shadow-gold-glow cursor-pointer disabled:opacity-60 disabled:cursor-not-allowed"
      >
        <span id="btn-text">Submit Project Enquiry</span>
        <Icon name="arrow-right" class="w-4 h-4 ml-2" />
      </button>
      <p class="text-xs text-slate-custom mt-3 flex items-center gap-2">
        <Icon name="shield-check" class="w-4 h-4 text-emerald-600 shrink-0" />
        <span>ADDC-compliant engineering review. Direct feedback within 24 working hours.</span>
      </p>
    </div>
  </form>
</div>

<script>
  const form = document.getElementById('project-enquiry-form') as HTMLFormElement;
  const alertBox = document.getElementById('form-alert') as HTMLDivElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const btnText = document.getElementById('btn-text') as HTMLSpanElement;

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      // Clear previous alerts
      alertBox.classList.add('hidden');
      alertBox.className = 'hidden mb-6 p-4 rounded-xl text-sm';
      alertBox.innerHTML = '';

      const formData = new FormData(form);
      const fullName = (formData.get('fullName') || '').toString().trim();
      const email = (formData.get('email') || '').toString().trim();
      const phone = (formData.get('phone') || '').toString().trim();
      const projectDescription = (formData.get('projectDescription') || '').toString().trim();

      // Simple client-side validation
      if (!fullName || !email || !phone || !projectDescription) {
        alertBox.className = 'block mb-6 p-4 rounded-xl text-sm bg-red-50 border border-red-200 text-red-800';
        alertBox.textContent = 'Please fill in all mandatory fields marked with an asterisk (*).';
        return;
      }

      // Enter loading state
      submitBtn.disabled = true;
      const originalText = btnText.textContent;
      btnText.textContent = 'Submitting to Engineering Desk...';

      try {
        const response = await fetch('/api/enquiry', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            fullName: formData.get('fullName'),
            companyName: formData.get('companyName'),
            email: formData.get('email'),
            phone: formData.get('phone'),
            service: formData.get('service'),
            location: formData.get('location'),
            projectDescription: formData.get('projectDescription'),
            honeypot: formData.get('website_check')
          })
        });

        const result = await response.json();

        if (response.ok && result.success) {
          alertBox.className = 'block mb-6 p-5 rounded-xl text-sm bg-emerald-50 border border-emerald-200 text-emerald-900';
          alertBox.innerHTML = `
            <div class="flex items-start gap-3">
              <svg class="w-5 h-5 text-emerald-600 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
              <div>
                <strong class="font-bold block text-base text-emerald-950 mb-1">Enquiry Successfully Registered!</strong>
                <p class="mb-2">${result.message}</p>
                <div class="inline-block px-3 py-1 rounded bg-emerald-100 font-mono text-xs font-semibold text-emerald-800">
                  Tracking Reference: ${result.reference || 'AMT-CONFIRMED'}
                </div>
              </div>
            </div>
          `;
          form.reset();
        } else {
          throw new Error(result.error || 'Failed to submit enquiry. Please try again.');
        }
      } catch (err: any) {
        alertBox.className = 'block mb-6 p-4 rounded-xl text-sm bg-amber-50 border border-amber-200 text-amber-900';
        alertBox.innerHTML = `
          <div class="flex items-start gap-3">
            <svg class="w-5 h-5 text-amber-600 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
            </svg>
            <div>
              <strong class="font-bold block mb-1">Submission Notice:</strong>
              <p class="mb-2">${err.message || 'We could not complete your online submission at this moment.'}</p>
              <p class="text-xs">
                You can also connect immediately with our engineering team by phone at 
                <a href="tel:025829700" class="underline font-semibold text-navy-900">02-5829700</a> 
                or email <a href="mailto:info@almanartech.com" class="underline font-semibold text-navy-900">info@almanartech.com</a>.
              </p>
            </div>
          </div>
        `;
      } finally {
        submitBtn.disabled = false;
        btnText.textContent = originalText;
      }
    });
  }
</script>
