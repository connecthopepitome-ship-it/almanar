---
import Icon from './Icon.astro';
import { SERVICES } from '../data/company';

interface Props {
  preselectedService?: string;
  compact?: boolean;
}

const { preselectedService = '', compact = false } = Astro.props;
---

<div class={`bg-navy-900 rounded-3xl border border-navy-800 shadow-editorial p-6 sm:p-8 lg:p-10 crosshair-corner ${compact ? 'lg:p-6' : ''}`}>
  <div class="mb-6 space-y-1">
    <span class="font-mono text-xs font-bold uppercase tracking-widest text-amber-brand block">
      PROJECT ESTIMATING DESK // ABU DHABI
    </span>
    <h3 class="text-2xl font-extrabold text-white font-display tracking-tight">
      Request a Project Consultation or Tender Quote
    </h3>
    <p class="text-xs sm:text-sm text-slate-300 font-sans mt-1">
      Direct submission to our engineering estimating desk in Musaffah, Abu Dhabi. Handled with strict commercial confidentiality.
    </p>
  </div>

  <!-- Form Status Notice Container -->
  <div id="form-alert" class="hidden mb-6 p-4 rounded-xl text-xs font-mono" role="alert"></div>

  <form id="project-enquiry-form" class="space-y-4" novalidate>
    <!-- Spam Honeypot Field -->
    <div class="hidden" aria-hidden="true">
      <label for="website_check">Leave this empty</label>
      <input type="text" id="website_check" name="website_check" tabindex="-1" autocomplete="off" />
    </div>

    <!-- Row 1: Name and Company -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <label for="fullName" class="block font-mono text-[11px] font-bold uppercase tracking-wider text-slate-300 mb-1.5">
          Full Name <span class="text-amber-brand">*</span>
        </label>
        <input 
          type="text" 
          id="fullName" 
          name="fullName" 
          required 
          placeholder="e.g. Eng. Tariq Al Mansoori"
          class="w-full px-4 py-3 rounded-xl border border-navy-700 bg-navy-950 text-white placeholder:text-slate-500 text-sm focus:border-amber-brand focus:ring-1 focus:ring-amber-brand transition-colors font-sans"
        />
      </div>

      <div>
        <label for="companyName" class="block font-mono text-[11px] font-bold uppercase tracking-wider text-slate-300 mb-1.5">
          Company / Organization
        </label>
        <input 
          type="text" 
          id="companyName" 
          name="companyName" 
          placeholder="e.g. Aldar Developments"
          class="w-full px-4 py-3 rounded-xl border border-navy-700 bg-navy-950 text-white placeholder:text-slate-500 text-sm focus:border-amber-brand focus:ring-1 focus:ring-amber-brand transition-colors font-sans"
        />
      </div>
    </div>

    <!-- Row 2: Email and Phone -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <label for="email" class="block font-mono text-[11px] font-bold uppercase tracking-wider text-slate-300 mb-1.5">
          Work Email <span class="text-amber-brand">*</span>
        </label>
        <input 
          type="email" 
          id="email" 
          name="email" 
          required 
          placeholder="name@company.ae"
          class="w-full px-4 py-3 rounded-xl border border-navy-700 bg-navy-950 text-white placeholder:text-slate-500 text-sm focus:border-amber-brand focus:ring-1 focus:ring-amber-brand transition-colors font-sans"
        />
      </div>

      <div>
        <label for="phone" class="block font-mono text-[11px] font-bold uppercase tracking-wider text-slate-300 mb-1.5">
          Phone Number <span class="text-amber-brand">*</span>
        </label>
        <input 
          type="tel" 
          id="phone" 
          name="phone" 
          required 
          placeholder="050-1234567 or 02-5829700"
          class="w-full px-4 py-3 rounded-xl border border-navy-700 bg-navy-950 text-white placeholder:text-slate-500 text-sm focus:border-amber-brand focus:ring-1 focus:ring-amber-brand transition-colors font-sans"
        />
      </div>
    </div>

    <!-- Row 3: Service Division and Location -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <label for="service" class="block font-mono text-[11px] font-bold uppercase tracking-wider text-slate-300 mb-1.5">
          Required Service Division <span class="text-amber-brand">*</span>
        </label>
        <select 
          id="service" 
          name="service" 
          required
          class="w-full px-4 py-3 rounded-xl border border-navy-700 bg-navy-950 text-white text-sm focus:border-amber-brand focus:ring-1 focus:ring-amber-brand transition-colors font-sans"
        >
          <option value="">Select an Engineering Division</option>
          {SERVICES.map((s) => (
            <option value={s.title} selected={preselectedService === s.slug || preselectedService === s.title}>
              {s.number} — {s.title}
            </option>
          ))}
          <option value="Turnkey Integrated MEP & Infrastructure">Turnkey Integrated MEP & Infrastructure</option>
          <option value="Annual Maintenance Contract (AMC)">Annual Maintenance Contract (AMC)</option>
          <option value="General Technical Inquiry">General Technical Inquiry</option>
        </select>
      </div>

      <div>
        <label for="location" class="block font-mono text-[11px] font-bold uppercase tracking-wider text-slate-300 mb-1.5">
          Project Location <span class="text-amber-brand">*</span>
        </label>
        <select 
          id="location" 
          name="location" 
          required
          class="w-full px-4 py-3 rounded-xl border border-navy-700 bg-navy-950 text-white text-sm focus:border-amber-brand focus:ring-1 focus:ring-amber-brand transition-colors font-sans"
        >
          <option value="Abu Dhabi City">Abu Dhabi Island & City</option>
          <option value="Musaffah Industrial">Musaffah Industrial Area (M35/M37/ICAD)</option>
          <option value="KIZAD / Khalifa Port">Khalifa Industrial Zone (KIZAD / Al Taweelah)</option>
          <option value="Yas Island / Saadiyat">Yas Island / Saadiyat / Reem Island</option>
          <option value="Al Ain">Al Ain & Eastern Region</option>
          <option value="Al Dhafra">Al Dhafra & Western Region</option>
          <option value="Other UAE">Other UAE Emirate</option>
        </select>
      </div>
    </div>

    <!-- Row 4: Project Scope Description -->
    <div>
      <label for="projectDescription" class="block font-mono text-[11px] font-bold uppercase tracking-wider text-slate-300 mb-1.5">
        Project Details & Scope of Work <span class="text-amber-brand">*</span>
      </label>
      <textarea 
        id="projectDescription" 
        name="projectDescription" 
        rows={compact ? 3 : 4} 
        required
        placeholder="Please outline the type of facility, approximate floor area/capacity, required timeline, and specific electromechanical, HVAC, fire or telecom specifications..."
        class="w-full px-4 py-3 rounded-xl border border-navy-700 bg-navy-950 text-white placeholder:text-slate-500 text-sm focus:border-amber-brand focus:ring-1 focus:ring-amber-brand transition-colors font-sans"
      ></textarea>
    </div>

    <!-- Submit Button & Assurances -->
    <div class="pt-2">
      <button 
        type="submit" 
        id="submit-btn"
        data-magnetic="true"
        class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-3.5 rounded-xl font-display text-xs font-bold uppercase tracking-wider bg-amber-brand text-navy-950 hover:bg-amber-glow transition-all duration-200 shadow-amber-glow cursor-pointer disabled:opacity-60 disabled:cursor-not-allowed"
      >
        <span id="btn-text">Submit Project Enquiry</span>
        <Icon name="arrow-right" class="w-4 h-4 ml-2" />
      </button>
      <p class="text-xs font-mono text-slate-400 mt-3 flex items-center gap-2">
        <Icon name="shield-check" class="w-4 h-4 text-emerald-400 shrink-0" />
        <span>ADDC-compliant engineering review. Direct feedback within 24 working hours.</span>
      </p>
    </div>
  </form>
</div>

<script>
  const form = document.getElementById('project-enquiry-form') as HTMLFormElement;
  const alertBox = document.getElementById('form-alert') as HTMLDivElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const btnText = document.getElementById('btn-text') as HTMLSpanElement;

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      alertBox.classList.add('hidden');
      alertBox.className = 'hidden mb-6 p-4 rounded-xl text-xs font-mono';
      alertBox.innerHTML = '';

      const formData = new FormData(form);
      const fullName = (formData.get('fullName') || '').toString().trim();
      const email = (formData.get('email') || '').toString().trim();
      const phone = (formData.get('phone') || '').toString().trim();
      const projectDescription = (formData.get('projectDescription') || '').toString().trim();

      if (!fullName || !email || !phone || !projectDescription) {
        alertBox.className = 'block mb-6 p-4 rounded-xl text-xs font-mono bg-red-950/80 border border-red-800 text-red-200';
        alertBox.textContent = 'Please fill in all mandatory fields marked with an asterisk (*).';
        return;
      }

      submitBtn.disabled = true;
      const originalText = btnText.textContent;
      btnText.textContent = 'Submitting to Engineering Desk...';

      try {
        const response = await fetch('/api/enquiry', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            fullName: formData.get('fullName'),
            companyName: formData.get('companyName'),
            email: formData.get('email'),
            phone: formData.get('phone'),
            service: formData.get('service'),
            location: formData.get('location'),
            projectDescription: formData.get('projectDescription'),
            honeypot: formData.get('website_check')
          })
        });

        const result = await response.json();

        if (response.ok && result.success) {
          alertBox.className = 'block mb-6 p-5 rounded-2xl text-xs font-mono bg-emerald-950/80 border border-emerald-700 text-emerald-200';
          alertBox.innerHTML = `
            <div class="space-y-2">
              <strong class="font-bold block text-sm text-emerald-300 font-display">✓ ENQUIRY REGISTERED SUCCESSFULLY</strong>
              <p class="font-sans text-xs text-slate-200">${result.message}</p>
              <div class="p-2 rounded bg-emerald-900/60 font-mono text-[11px] text-amber-brand inline-block">
                REFERENCE: ${result.reference || 'AMT-CONFIRMED'}
              </div>
            </div>
          `;
          form.reset();
        } else {
          throw new Error(result.error || 'Failed to submit enquiry. Please try again.');
        }
      } catch (err: any) {
        alertBox.className = 'block mb-6 p-4 rounded-xl text-xs font-mono bg-amber-950/80 border border-amber-700 text-amber-200';
        alertBox.innerHTML = `
          <div>
            <strong class="font-bold block mb-1 font-display">SUBMISSION NOTICE:</strong>
            <p class="font-sans mb-2">${err.message || 'We could not complete your online submission at this moment.'}</p>
            <p class="text-[11px]">
              Direct assistance: Call <a href="tel:025829700" class="underline text-amber-brand font-bold">02-5829700</a> or email <a href="mailto:info@almanartech.com" class="underline text-amber-brand font-bold">info@almanartech.com</a>.
            </p>
          </div>
        `;
      } finally {
        submitBtn.disabled = false;
        btnText.textContent = originalText;
      }
    });
  }
</script>
