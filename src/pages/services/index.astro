---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import { SERVICES } from '../../data/company';

const pageTitle = "Engineering Services Overview | MEP, HVAC, Fire & IT Telecom Abu Dhabi";
const pageDescription = "Explore Al Manar Tech's six core engineering divisions: Electromechanical & MEP, IT & Telecom, Fire Detection, HVAC, Security & Surveillance, and Facility Maintenance in Abu Dhabi.";
---

<Layout title={pageTitle} description={pageDescription}>

  <!-- Services Hero Header -->
  <section class="bg-navy-950 text-white py-16 lg:py-24 engineering-grid-dark relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="max-w-3xl space-y-4">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded bg-navy-800 border border-gold-500/40 text-gold-400 text-xs font-semibold">
          <Icon name="layers" class="w-4 h-4 text-gold-500" />
          <span>Engineering Capabilities</span>
        </div>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold font-heading text-white tracking-tight">
          Comprehensive Building Infrastructure & Electromechanical Engineering
        </h1>
        <p class="text-base sm:text-lg text-slate-300 leading-relaxed">
          From high-voltage distribution and industrial chillers to sensitive fiber optic data backbones and Civil Defence-approved fire alarm networks, Al Manar Tech provides integrated execution under a single accountable engineering contractor.
        </p>
      </div>
    </div>
  </section>

  <!-- Detailed Service Divisions Grid -->
  <section class="py-20 bg-cloud-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
      
      {SERVICES.map((service, index) => (
        <div id={service.slug} class="bg-white rounded-3xl border border-cloud-200 shadow-premium p-8 lg:p-12 transition-all hover:shadow-premium-lg">
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
            
            <!-- Left Info (7 Cols) -->
            <div class="lg:col-span-7 space-y-6">
              <div class="flex items-center gap-3">
                <div class="w-12 h-12 rounded-xl bg-navy-900 text-gold-500 flex items-center justify-center shrink-0">
                  <Icon name={service.icon.toLowerCase()} class="w-6 h-6" />
                </div>
                <div>
                  <span class="text-xs uppercase tracking-wider font-bold text-gold-600">
                    {service.category}
                  </span>
                  <h2 class="text-2xl sm:text-3xl font-extrabold text-navy-900 font-heading">
                    {service.title}
                  </h2>
                </div>
              </div>

              <p class="text-xs font-semibold text-gold-700 bg-gold-400/10 px-3 py-1.5 rounded-lg border border-gold-400/20 inline-block">
                {service.tagline}
              </p>

              <p class="text-sm sm:text-base text-slate-custom leading-relaxed">
                {service.description}
              </p>

              <!-- Detailed Scopes Breakdown -->
              <div class="space-y-4 pt-2">
                <h3 class="text-xs font-bold uppercase tracking-wider text-navy-900">
                  Confirmed Technical Scope:
                </h3>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                  {service.technicalHighlights.map((highlight) => (
                    <div class="flex items-start gap-2 text-xs text-slate-700 p-2.5 rounded-lg bg-cloud-100">
                      <Icon name="check-circle" class="w-4 h-4 text-emerald-600 shrink-0 mt-0.5" />
                      <span>{highlight}</span>
                    </div>
                  ))}
                </div>
              </div>

              <!-- Button to Detailed Page -->
              <div class="pt-4 flex flex-wrap items-center gap-4">
                <a 
                  href={`/services/${service.slug}`} 
                  class="inline-flex items-center gap-2 px-6 py-3 rounded-xl text-sm font-bold bg-navy-900 text-white hover:bg-gold-500 hover:text-navy-950 transition-all shadow-sm"
                >
                  <span>Explore {service.shortTitle} Full Page</span>
                  <Icon name="arrow-right" class="w-4 h-4" />
                </a>

                <a 
                  href="/contact" 
                  class="inline-flex items-center gap-1.5 text-xs font-bold text-slate-600 hover:text-navy-900 px-4 py-3"
                >
                  <span>Request Specific Quotation</span>
                  <Icon name="chevron-right" class="w-3.5 h-3.5" />
                </a>
              </div>
            </div>

            <!-- Right: Technical Authority & Codes Box (5 Cols) -->
            <div class="lg:col-span-5 bg-navy-950 text-white rounded-2xl p-6 sm:p-8 space-y-6 border border-navy-800">
              <div>
                <span class="text-xs font-bold uppercase tracking-wider text-gold-500 block mb-1">
                  Compliance & Standards
                </span>
                <h3 class="text-lg font-bold font-heading text-white">
                  Regulatory Framework
                </h3>
              </div>

              <div class="space-y-2">
                {service.regulations.map((reg) => (
                  <div class="flex items-center gap-2 text-xs text-slate-300 py-1.5 border-b border-navy-800/80">
                    <Icon name="shield-check" class="w-4 h-4 text-gold-500 shrink-0" />
                    <span>{reg}</span>
                  </div>
                ))}
              </div>

              <div>
                <span class="text-xs font-bold uppercase tracking-wider text-slate-400 block mb-2">
                  Suitable For Industries:
                </span>
                <div class="flex flex-wrap gap-1.5">
                  {service.industryApplications.map((app) => (
                    <span class="px-2.5 py-1 rounded bg-navy-900 border border-navy-800 text-[11px] text-slate-300">
                      {app}
                    </span>
                  ))}
                </div>
              </div>

              <div class="pt-2 text-xs text-slate-400">
                <p>All work executed under certified engineer supervision with full warranty and handover test records.</p>
              </div>
            </div>

          </div>
        </div>
      ))}

    </div>
  </section>

  <!-- Bottom CTA Strip -->
  <section class="py-16 bg-white border-t border-cloud-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-6">
      <h2 class="text-2xl sm:text-3xl font-extrabold text-navy-900 font-heading">
        Require a Multi-Disciplinary MEP Package?
      </h2>
      <p class="text-slate-custom text-base max-w-2xl mx-auto">
        Combining electrical, HVAC, fire life safety, and telecom services under Al Manar Tech eliminates subcontractor disputes, streamlines authority approvals, and reduces project overhead.
      </p>
      <div>
        <a href="/contact" class="inline-flex items-center gap-2 px-8 py-4 rounded-xl text-sm font-bold bg-gold-500 text-navy-950 hover:bg-gold-400 shadow-md">
          <span>Submit Tender Specifications</span>
          <Icon name="arrow-right" class="w-4 h-4" />
        </a>
      </div>
    </div>
  </section>

</Layout>
