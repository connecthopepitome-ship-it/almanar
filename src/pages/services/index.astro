---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import ServiceCockpit from '../../components/ServiceCockpit.astro';
import MarqueeTicker from '../../components/MarqueeTicker.astro';
import { SERVICES } from '../../data/company';

const pageTitle = "Engineering Services Overview | MEP, HVAC, Fire & IT Telecom Abu Dhabi";
const pageDescription = "Explore Al Manar Tech's six core engineering divisions: Electromechanical & MEP, IT & Telecom, Fire Detection, HVAC, Security & Surveillance, and Facility Maintenance in Abu Dhabi.";
---

<Layout title={pageTitle} description={pageDescription}>

  <!-- Services Hero Header -->
  <section class="bg-navy-950 text-white py-16 lg:py-24 hud-grid relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="max-w-3xl space-y-4">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-navy-900 border border-amber-brand/40 text-amber-brand text-xs font-mono">
          <span>02 // ENGINEERING DIVISIONS</span>
        </div>
        <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-extrabold text-white tracking-tight">
          Comprehensive Building Infrastructure & Electromechanical Engineering
        </h1>
        <p class="font-sans text-base sm:text-lg text-slate-300 leading-relaxed">
          From high-voltage distribution and industrial chillers to sensitive fiber optic data backbones and Civil Defence-approved fire alarm networks, Al Manar Tech provides integrated execution under a single accountable engineering contractor.
        </p>
      </div>
    </div>
  </section>

  <MarqueeTicker variant="navy" />

  <!-- Interactive Cockpit Section (Navy) -->
  <section class="py-24 bg-navy-950 text-white border-b border-navy-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      <div class="space-y-2">
        <span class="font-mono text-xs font-bold uppercase tracking-widest text-amber-brand">
          INTERACTIVE COCKPIT
        </span>
        <h2 class="font-display text-3xl font-extrabold text-white">
          Inspect Real-Time Technical Specifications
        </h2>
      </div>

      <ServiceCockpit />
    </div>
  </section>

  <!-- Detailed Service Divisions Grid (Warm Ivory) -->
  <section class="py-24 bg-ivory-100 text-navy-950 border-b border-ivory-300 hud-grid-ivory">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
      
      {SERVICES.map((service) => (
        <div id={service.slug} class="bg-white rounded-3xl border border-ivory-300 shadow-editorial p-8 lg:p-12 transition-all hover:border-amber-dark/40">
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
            
            <!-- Left Info (7 Cols) -->
            <div class="lg:col-span-7 space-y-6">
              <div class="flex items-center gap-3 font-mono text-xs text-amber-dark font-bold">
                <span>DIV_{service.number} // {service.category.toUpperCase()}</span>
              </div>

              <div>
                <h2 class="font-display text-2xl sm:text-3xl font-extrabold text-navy-900">
                  {service.title}
                </h2>
                <p class="font-sans text-xs font-semibold text-slate-600 mt-1">
                  {service.tagline}
                </p>
              </div>

              <p class="font-sans text-sm sm:text-base text-slate-700 leading-relaxed">
                {service.description}
              </p>

              <!-- Detailed Scopes Breakdown -->
              <div class="space-y-4 pt-2 font-sans">
                <h3 class="font-mono text-xs font-bold uppercase tracking-wider text-navy-900">
                  Confirmed Technical Scope:
                </h3>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                  {service.technicalHighlights.map((highlight) => (
                    <div class="flex items-start gap-2 text-xs text-slate-800 p-3 rounded-xl bg-ivory-50 border border-ivory-300">
                      <Icon name="check-circle" class="w-4 h-4 text-emerald-600 shrink-0 mt-0.5" />
                      <span>{highlight}</span>
                    </div>
                  ))}
                </div>
              </div>

              <!-- Button to Detailed Page -->
              <div class="pt-4 flex flex-wrap items-center gap-4 font-display">
                <a 
                  href={`/services/${service.slug}`} 
                  data-magnetic="true"
                  class="inline-flex items-center gap-2 px-6 py-3 rounded-xl text-xs font-bold uppercase tracking-wider bg-navy-950 text-white hover:bg-amber-dark transition-all shadow-sm"
                >
                  <span>Explore {service.shortTitle} Dedicated Page</span>
                  <Icon name="arrow-right" class="w-4 h-4" />
                </a>

                <a 
                  href="/contact" 
                  class="inline-flex items-center gap-1.5 font-mono text-xs font-bold text-slate-600 hover:text-navy-900 px-4 py-3"
                >
                  <span>Request Specific BOQ</span>
                  <Icon name="chevron-right" class="w-3.5 h-3.5 text-amber-dark" />
                </a>
              </div>
            </div>

            <!-- Right: Technical Authority & Codes Box (5 Cols) -->
            <div class="lg:col-span-5 bg-navy-950 text-white rounded-3xl p-6 sm:p-8 space-y-6 border border-navy-800 shadow-card-dark font-mono text-xs">
              <div>
                <span class="font-mono text-[10px] font-bold uppercase tracking-widest text-amber-brand block mb-1">
                  COMPLIANCE & STANDARDS
                </span>
                <h3 class="font-display text-lg font-bold text-white">
                  Regulatory Framework
                </h3>
              </div>

              <div class="space-y-2 font-sans text-xs">
                {service.regulations.map((reg) => (
                  <div class="flex items-center gap-2 text-slate-300 py-1.5 border-b border-navy-800">
                    <Icon name="shield-check" class="w-4 h-4 text-amber-brand shrink-0" />
                    <span>{reg}</span>
                  </div>
                ))}
              </div>

              <div>
                <span class="font-mono text-[10px] font-bold uppercase tracking-widest text-slate-400 block mb-2">
                  SUITABLE SECTOR DEPLOYMENTS:
                </span>
                <div class="flex flex-wrap gap-1.5">
                  {service.industryApplications.map((app) => (
                    <span class="px-2.5 py-1 rounded bg-navy-900 border border-navy-800 text-[11px] text-slate-300">
                      {app}
                    </span>
                  ))}
                </div>
              </div>
            </div>

          </div>
        </div>
      ))}

    </div>
  </section>

</Layout>
