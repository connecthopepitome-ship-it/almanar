---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import ContactForm from '../../components/ContactForm.astro';
import { SERVICES, VERIFIED_PROJECTS, COMPANY } from '../../data/company';

export function getStaticPaths() {
  return SERVICES.map((service) => ({
    params: { slug: service.slug },
    props: { service }
  }));
}

const { service } = Astro.props;

// Filter related services (excluding current)
const relatedServices = SERVICES.filter((s) => s.slug !== service.slug).slice(0, 3);

// Filter related projects
const relatedProjects = VERIFIED_PROJECTS.filter((p) => 
  p.sectors.some((s) => 
    s.toLowerCase().includes(service.category.toLowerCase()) || 
    s.toLowerCase().includes(service.shortTitle.toLowerCase()) ||
    service.shortTitle.toLowerCase().includes(s.toLowerCase())
  )
).slice(0, 3);

const pageTitle = `${service.title} in Abu Dhabi | Al Manar Tech`;
const pageDescription = `${service.tagline}. Al Manar Tech provides code-compliant ${service.title.toLowerCase()} across Abu Dhabi and Al Ain. ADDC, ADM & Civil Defence aligned.`;
---

<Layout title={pageTitle} description={pageDescription}>

  <!-- 1. Strong Service-Specific Hero -->
  <section class="bg-navy-950 text-white py-16 lg:py-24 engineering-grid-dark relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        
        <div class="lg:col-span-8 space-y-5">
          <!-- Breadcrumb Navigation -->
          <nav class="flex items-center gap-2 text-xs text-slate-400" aria-label="Breadcrumb">
            <a href="/" class="hover:text-gold-400">Home</a>
            <Icon name="chevron-right" class="w-3 h-3 text-slate-600" />
            <a href="/services" class="hover:text-gold-400">Services</a>
            <Icon name="chevron-right" class="w-3 h-3 text-slate-600" />
            <span class="text-gold-500 font-semibold">{service.shortTitle}</span>
          </nav>

          <div class="inline-flex items-center gap-2 px-3 py-1 rounded bg-navy-800 border border-gold-500/40 text-gold-400 text-xs font-semibold">
            <Icon name={service.icon.toLowerCase()} class="w-4 h-4 text-gold-500" />
            <span>Division: {service.category}</span>
          </div>

          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold font-heading text-white tracking-tight leading-tight">
            {service.title}
          </h1>

          <p class="text-base sm:text-lg text-slate-300 leading-relaxed max-w-2xl">
            {service.tagline}
          </p>

          <div class="flex flex-wrap items-center gap-4 pt-2">
            <a 
              href="#quotation" 
              class="inline-flex items-center gap-2 px-6 py-3.5 rounded-xl text-sm font-bold bg-gold-500 text-navy-950 hover:bg-gold-400 transition-all shadow-md"
            >
              <span>Request a Quotation</span>
              <Icon name="arrow-right" class="w-4 h-4" />
            </a>
            <a 
              href="#scope" 
              class="inline-flex items-center gap-2 px-6 py-3.5 rounded-xl text-sm font-semibold bg-navy-800 text-white hover:bg-navy-700 border border-navy-700 transition-colors"
            >
              <span>View Technical Scope</span>
              <Icon name="chevron-down" class="w-4 h-4 text-gold-500" />
            </a>
          </div>
        </div>

        <!-- Right: Authority & Quick Stats Card -->
        <div class="lg:col-span-4 bg-navy-900 border border-navy-800 rounded-2xl p-6 sm:p-7 space-y-5">
          <span class="text-xs font-bold uppercase tracking-wider text-gold-500 block">
            Abu Dhabi Authority Aligned
          </span>
          <div class="space-y-3 text-xs text-slate-300">
            <div class="flex items-start gap-2.5">
              <Icon name="check-circle" class="w-4 h-4 text-emerald-500 shrink-0 mt-0.5" />
              <span>Full load schedules, shop drawings, and authority approvals.</span>
            </div>
            <div class="flex items-start gap-2.5">
              <Icon name="check-circle" class="w-4 h-4 text-emerald-500 shrink-0 mt-0.5" />
              <span>ADQCC compliant materials & testing protocols.</span>
            </div>
            <div class="flex items-start gap-2.5">
              <Icon name="check-circle" class="w-4 h-4 text-emerald-500 shrink-0 mt-0.5" />
              <span>Dedicated project engineer on-site supervision.</span>
            </div>
          </div>

          <div class="pt-4 border-t border-navy-800 text-xs">
            <span class="text-slate-400 block mb-1">Direct Engineering Contact:</span>
            <a href="tel:025829700" class="text-sm font-bold text-white hover:text-gold-400 block">02-5829700</a>
            <a href="mailto:info@almanartech.com" class="text-xs text-slate-300 hover:text-gold-400 block mt-0.5">info@almanartech.com</a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- 2. Detailed Service Overview & Technical Imagery -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        
        <div class="lg:col-span-7 space-y-6">
          <span class="text-xs font-bold uppercase tracking-wider text-gold-600">
            Technical Engineering Overview
          </span>
          <h2 class="text-3xl font-extrabold text-navy-900 font-heading tracking-tight">
            Code-Compliant, Energy-Efficient Installation
          </h2>
          <p class="text-base text-slate-custom leading-relaxed">
            {service.description}
          </p>
          <p class="text-sm text-slate-custom leading-relaxed">
            Our certified engineering teams carry out installations in strict compliance with Abu Dhabi Distribution Company (ADDC) guidelines, the Abu Dhabi International Building Code, and relevant national safety frameworks. Every project undergoes thorough quality inspections, insulation resistance and continuity testing, and systematic commissioning prior to final authority handover.
          </p>

          <!-- Core Technical Bullet Points -->
          <div class="pt-2">
            <span class="text-xs font-bold uppercase tracking-wider text-navy-900 block mb-3">
              Core Technical Capabilities:
            </span>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
              {service.technicalHighlights.map((hl) => (
                <div class="flex items-start gap-2 text-xs text-slate-700 p-2.5 rounded-lg bg-cloud-100">
                  <Icon name="check" class="w-4 h-4 text-gold-600 shrink-0 mt-0.5" />
                  <span>{hl}</span>
                </div>
              ))}
            </div>
          </div>
        </div>

        <div class="lg:col-span-5">
          <div class="rounded-2xl overflow-hidden shadow-2xl border border-cloud-300 aspect-[4/3] bg-navy-900">
            <img 
              src={service.heroImage} 
              alt={`${service.title} by Al Manar Tech in Abu Dhabi`}
              class="w-full h-full object-cover"
              loading="lazy"
            />
          </div>
          <div class="mt-3 text-center">
            <span class="text-xs text-slate-500 font-medium">
              Al Manar Tech Technical Operations — Abu Dhabi, UAE
            </span>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- 3. Actual Confirmed Scope of Services -->
  <section id="scope" class="py-20 bg-cloud-100 border-y border-cloud-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="max-w-3xl space-y-4 mb-14">
        <span class="text-xs font-bold uppercase tracking-wider text-gold-600">
          Work Breakdown Structure
        </span>
        <h2 class="text-3xl font-extrabold text-navy-900 font-heading tracking-tight">
          Confirmed Scope of Works & Deliverables
        </h2>
        <p class="text-slate-custom text-base">
          All engineering deliverables are planned and executed to ensure seamless integration with structural and architectural elements.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {service.detailedScope.map((scopeGroup, idx) => (
          <div class="bg-white rounded-2xl p-7 border border-cloud-200 shadow-premium flex flex-col justify-between space-y-4">
            <div>
              <div class="text-xs font-bold font-mono text-gold-600 mb-2">
                SCOPE 0{idx + 1}
              </div>
              <h3 class="text-lg font-bold text-navy-900 font-heading mb-4 pb-2 border-b border-cloud-100">
                {scopeGroup.title}
              </h3>
              <ul class="space-y-2.5 text-xs text-slate-custom">
                {scopeGroup.items.map((item) => (
                  <li class="flex items-start gap-2">
                    <Icon name="check-circle" class="w-3.5 h-3.5 text-emerald-600 shrink-0 mt-0.5" />
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
            <div class="pt-4 border-t border-cloud-100 text-[11px] text-slate-400">
              Tested & Commissioned
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- 4. Suitable Industry Applications & Regulations -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
        
        <!-- Suitable Applications -->
        <div class="lg:col-span-6 space-y-6">
          <span class="text-xs font-bold uppercase tracking-wider text-gold-600">
            Sector Deployments
          </span>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-navy-900 font-heading tracking-tight">
            Typical Industry Applications
          </h2>
          <p class="text-sm text-slate-custom leading-relaxed">
            {service.shortTitle} solutions by Al Manar Tech are engineered to adapt to diverse operational criteria across the UAE:
          </p>

          <div class="space-y-3">
            {service.industryApplications.map((app) => (
              <div class="flex items-center gap-3 p-3.5 rounded-xl bg-cloud-100 border border-cloud-200 text-sm font-semibold text-navy-900">
                <Icon name="building" class="w-4 h-4 text-gold-600 shrink-0" />
                <span>{app}</span>
              </div>
            ))}
          </div>
        </div>

        <!-- Applicable Regulations & Standards -->
        <div class="lg:col-span-6 space-y-6">
          <span class="text-xs font-bold uppercase tracking-wider text-gold-600">
            Statutory Framework
          </span>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-navy-900 font-heading tracking-tight">
            Standards & Conformity Codes
          </h2>
          <p class="text-sm text-slate-custom leading-relaxed">
            We ensure full conformity with all relevant Abu Dhabi and international engineering benchmarks:
          </p>

          <div class="space-y-3">
            {service.regulations.map((reg) => (
              <div class="flex items-center gap-3 p-3.5 rounded-xl bg-navy-900 text-white text-sm font-medium border border-navy-800">
                <Icon name="shield-check" class="w-4 h-4 text-gold-500 shrink-0" />
                <span>{reg}</span>
              </div>
            ))}
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- 5. Relevant Project References -->
  {relatedProjects.length > 0 && (
    <section class="py-16 bg-cloud-100 border-y border-cloud-200">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-gold-600">
            Case References
          </span>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-navy-900 font-heading tracking-tight">
            Relevant Verified Projects
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {relatedProjects.map((p) => (
            <div class="bg-white rounded-xl border border-cloud-200 overflow-hidden shadow-sm hover:shadow-md transition-shadow">
              <div class="aspect-[16/10] bg-navy-900">
                <img src={p.image} alt={p.title} class="w-full h-full object-cover" loading="lazy" />
              </div>
              <div class="p-5 space-y-2">
                <span class="text-[11px] font-bold text-gold-600 uppercase">{p.category}</span>
                <h3 class="text-base font-bold text-navy-900 font-heading">{p.title}</h3>
                <p class="text-xs text-slate-custom line-clamp-2">{p.scopeSummary}</p>
                <div class="pt-2 text-[11px] text-slate-400 flex items-center gap-1">
                  <Icon name="map-pin" class="w-3 h-3 text-gold-500" />
                  <span>{p.location}</span>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- 6. Frequently Asked Questions -->
  <section class="py-20 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
      <div class="text-center space-y-3">
        <span class="text-xs font-bold uppercase tracking-wider text-gold-600">
          Technical Inquiries
        </span>
        <h2 class="text-3xl font-extrabold text-navy-900 font-heading tracking-tight">
          Frequently Asked Questions
        </h2>
        <p class="text-slate-custom text-sm">
          Common queries regarding {service.title} engineering, permits, and execution.
        </p>
      </div>

      <FaqAccordion faqs={service.faqs} />
    </div>
  </section>

  <!-- 7. Quotation & Inquiry Form Section -->
  <section id="quotation" class="py-20 bg-navy-950 text-white engineering-grid-dark">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        
        <div class="lg:col-span-5 space-y-6">
          <span class="text-xs font-bold uppercase tracking-wider text-gold-500">
            Direct Estimating Desk
          </span>
          <h2 class="text-3xl sm:text-4xl font-extrabold text-white font-heading tracking-tight leading-tight">
            Request a Dedicated Quote for {service.shortTitle}
          </h2>
          <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
            Submit your project blueprints, load schedules, or tender documents for an official commercial and engineering evaluation.
          </p>

          <div class="space-y-4 pt-2 text-xs text-slate-300">
            <div class="flex items-center gap-3">
              <Icon name="phone" class="w-4 h-4 text-gold-500 shrink-0" />
              <span>Call directly: 02-5829700</span>
            </div>
            <div class="flex items-center gap-3">
              <Icon name="mail" class="w-4 h-4 text-gold-500 shrink-0" />
              <span>Email: info@almanartech.com</span>
            </div>
            <div class="flex items-center gap-3">
              <Icon name="clock" class="w-4 h-4 text-gold-500 shrink-0" />
              <span>Turnaround: 24-48 working hours</span>
            </div>
          </div>
        </div>

        <div class="lg:col-span-7">
          <ContactForm preselectedService={service.title} compact={true} />
        </div>

      </div>
    </div>
  </section>

  <!-- 8. Related Services Navigation -->
  <section class="py-16 bg-cloud-100 border-t border-cloud-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
      <h3 class="text-xl font-bold text-navy-900 font-heading">
        Explore Complementary Services
      </h3>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
        {relatedServices.map((rel) => (
          <a 
            href={`/services/${rel.slug}`} 
            class="p-6 rounded-2xl bg-white border border-cloud-200 shadow-sm hover:shadow-md hover:border-gold-500 transition-all flex items-center justify-between group"
          >
            <div>
              <span class="text-[10px] font-bold uppercase tracking-wider text-gold-600 block mb-1">
                {rel.category}
              </span>
              <h4 class="text-sm font-bold text-navy-900 font-heading group-hover:text-gold-600 transition-colors">
                {rel.title}
              </h4>
            </div>
            <Icon name="arrow-right" class="w-4 h-4 text-slate-400 group-hover:text-gold-600 group-hover:translate-x-1 transition-all" />
          </a>
        ))}
      </div>
    </div>
  </section>

</Layout>
