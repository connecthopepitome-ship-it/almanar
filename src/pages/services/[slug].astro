---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import ContactForm from '../../components/ContactForm.astro';
import MarqueeTicker from '../../components/MarqueeTicker.astro';
import { SERVICES, VERIFIED_PROJECTS, COMPANY } from '../../data/company';

export function getStaticPaths() {
  return SERVICES.map((service) => ({
    params: { slug: service.slug },
    props: { service }
  }));
}

const { service } = Astro.props;

// Filter related services (excluding current)
const relatedServices = SERVICES.filter((s) => s.slug !== service.slug).slice(0, 3);

// Filter related projects
const relatedProjects = VERIFIED_PROJECTS.filter((p) => 
  p.sectors.some((s) => 
    s.toLowerCase().includes(service.category.toLowerCase()) || 
    s.toLowerCase().includes(service.shortTitle.toLowerCase()) ||
    service.shortTitle.toLowerCase().includes(s.toLowerCase())
  )
).slice(0, 3);

const pageTitle = `${service.title} in Abu Dhabi | Al Manar Tech`;
const pageDescription = `${service.tagline}. Al Manar Tech provides code-compliant ${service.title.toLowerCase()} across Abu Dhabi and Al Ain. ADDC, ADM & Civil Defence aligned.`;
---

<Layout title={pageTitle} description={pageDescription}>

  <!-- 1. Strong Service-Specific Hero -->
  <section class="bg-navy-950 text-white py-16 lg:py-24 hud-grid relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        
        <div class="lg:col-span-8 space-y-5">
          <!-- Breadcrumb Navigation -->
          <nav class="flex items-center gap-2 text-xs font-mono text-slate-400" aria-label="Breadcrumb">
            <a href="/" class="hover:text-amber-brand">HOME</a>
            <Icon name="chevron-right" class="w-3 h-3 text-slate-600" />
            <a href="/services" class="hover:text-amber-brand">SERVICES</a>
            <Icon name="chevron-right" class="w-3 h-3 text-slate-600" />
            <span class="text-amber-brand font-bold">DIV_{service.number}</span>
          </nav>

          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-navy-900 border border-amber-brand/40 text-amber-brand text-xs font-mono">
            <span>DIVISION {service.number} // {service.category.toUpperCase()}</span>
          </div>

          <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-extrabold text-white tracking-tight leading-tight">
            {service.title}
          </h1>

          <p class="font-sans text-base sm:text-lg text-slate-300 leading-relaxed max-w-2xl">
            {service.tagline}
          </p>

          <div class="flex flex-wrap items-center gap-4 pt-2 font-display">
            <a 
              href="#quotation" 
              data-magnetic="true"
              class="inline-flex items-center gap-2 px-6 py-3.5 rounded-xl text-xs font-bold uppercase tracking-wider bg-amber-brand text-navy-950 hover:bg-amber-glow transition-all shadow-amber-glow"
            >
              <span>Request Quotation</span>
              <Icon name="arrow-right" class="w-4 h-4" />
            </a>
            <a 
              href="#scope" 
              class="inline-flex items-center gap-2 px-6 py-3.5 rounded-xl text-xs font-mono font-semibold bg-navy-900 text-white hover:bg-navy-850 border border-navy-700 transition-colors"
            >
              <span>View Technical Scope</span>
              <Icon name="chevron-down" class="w-4 h-4 text-amber-brand" />
            </a>
          </div>
        </div>

        <!-- Right: Authority & Quick Stats Card -->
        <div class="lg:col-span-4 glass-panel-navy rounded-3xl p-6 sm:p-8 space-y-6 shadow-glass-navy crosshair-corner font-mono text-xs">
          <span class="font-bold uppercase tracking-widest text-amber-brand block">
            REGULATORY CONFORMITY
          </span>
          <div class="space-y-3 text-slate-300 font-sans">
            <div class="flex items-start gap-2.5">
              <Icon name="check-circle" class="w-4 h-4 text-emerald-400 shrink-0 mt-0.5" />
              <span>Full load schedules, single-line diagrams, and authority approvals.</span>
            </div>
            <div class="flex items-start gap-2.5">
              <Icon name="check-circle" class="w-4 h-4 text-emerald-400 shrink-0 mt-0.5" />
              <span>ADQCC compliant materials & certified testing.</span>
            </div>
            <div class="flex items-start gap-2.5">
              <Icon name="check-circle" class="w-4 h-4 text-emerald-400 shrink-0 mt-0.5" />
              <span>Dedicated project engineer on-site supervision.</span>
            </div>
          </div>

          <div class="pt-4 border-t border-navy-800">
            <span class="text-slate-500 block mb-1 text-[10px]">ESTIMATING DESK:</span>
            <a href="tel:025829700" class="font-display text-base font-bold text-white hover:text-amber-brand block">02-5829700</a>
            <a href="mailto:info@almanartech.com" class="text-slate-400 hover:text-amber-brand block mt-0.5">info@almanartech.com</a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <MarqueeTicker variant="amber" />

  <!-- 2. Detailed Technical Scope & Imagery (Warm Ivory) -->
  <section class="py-24 bg-ivory-100 text-navy-950 border-b border-ivory-300 hud-grid-ivory">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        
        <div class="lg:col-span-7 space-y-6">
          <span class="font-mono text-xs font-bold uppercase tracking-widest text-amber-dark">
            TECHNICAL ENGINEERING OVERVIEW
          </span>
          <h2 class="font-display text-3xl sm:text-4xl font-extrabold text-navy-900 tracking-tight">
            Code-Compliant, Energy-Efficient Installation
          </h2>
          <p class="font-sans text-base text-slate-700 leading-relaxed">
            {service.description}
          </p>
          <p class="font-sans text-sm text-slate-600 leading-relaxed">
            Our certified engineering teams carry out installations in strict compliance with Abu Dhabi Distribution Company (ADDC) guidelines, the Abu Dhabi International Building Code, and relevant national safety frameworks. Every project undergoes thorough quality inspections, insulation resistance and continuity testing, and systematic commissioning prior to final authority handover.
          </p>

          <!-- Core Technical Bullet Points -->
          <div class="pt-2">
            <span class="font-mono text-xs font-bold uppercase tracking-wider text-navy-900 block mb-3">
              Core Technical Capabilities:
            </span>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
              {service.technicalHighlights.map((hl) => (
                <div class="flex items-start gap-2 font-sans text-xs text-slate-800 p-3 rounded-xl bg-white border border-ivory-300">
                  <Icon name="check" class="w-4 h-4 text-amber-dark shrink-0 mt-0.5" />
                  <span>{hl}</span>
                </div>
              ))}
            </div>
          </div>
        </div>

        <div class="lg:col-span-5" data-cursor="view">
          <div class="rounded-3xl overflow-hidden shadow-editorial border border-ivory-300 aspect-[4/3] bg-navy-950 crosshair-corner">
            <img 
              src={service.heroImage} 
              alt={`${service.title} by Al Manar Tech in Abu Dhabi`}
              class="w-full h-full object-cover"
              loading="lazy"
            />
          </div>
          <div class="mt-3 text-center font-mono text-[11px] text-slate-500">
            Al Manar Tech Field Execution — Abu Dhabi & Al Ain
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- 3. Actual Confirmed Scope of Services (Navy) -->
  <section id="scope" class="py-24 bg-navy-950 text-white border-b border-navy-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
      
      <div class="max-w-3xl space-y-4">
        <span class="font-mono text-xs font-bold uppercase tracking-widest text-amber-brand">
          WORK BREAKDOWN STRUCTURE
        </span>
        <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight">
          Confirmed Scope of Works & Deliverables
        </h2>
        <p class="font-sans text-slate-300 text-base">
          All engineering deliverables are planned and executed to ensure seamless integration with structural and architectural elements.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {service.detailedScope.map((scopeGroup, idx) => (
          <div class="bg-navy-900 rounded-2xl p-7 border border-navy-800 shadow-card-dark flex flex-col justify-between space-y-4">
            <div>
              <div class="font-mono text-xs font-bold text-amber-brand mb-2">
                SCOPE_0{idx + 1}
              </div>
              <h3 class="font-display text-lg font-bold text-white mb-4 pb-2 border-b border-navy-800">
                {scopeGroup.title}
              </h3>
              <ul class="space-y-2.5 font-sans text-xs text-slate-300">
                {scopeGroup.items.map((item) => (
                  <li class="flex items-start gap-2">
                    <Icon name="check-circle" class="w-3.5 h-3.5 text-emerald-400 shrink-0 mt-0.5" />
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
            <div class="pt-4 border-t border-navy-800 font-mono text-[10px] text-slate-500">
              TESTED & COMMISSIONED
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- 4. Frequently Asked Questions (Warm Ivory) -->
  <section class="py-24 bg-ivory-100 text-navy-950 border-b border-ivory-300">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
      <div class="text-center space-y-3">
        <span class="font-mono text-xs font-bold uppercase tracking-widest text-amber-dark">
          TECHNICAL INQUIRIES
        </span>
        <h2 class="font-display text-3xl font-extrabold text-navy-900 tracking-tight">
          Frequently Asked Questions
        </h2>
        <p class="font-sans text-slate-600 text-sm">
          Common queries regarding {service.title} engineering, permits, and execution.
        </p>
      </div>

      <FaqAccordion faqs={service.faqs} />
    </div>
  </section>

  <!-- 5. Quotation & Inquiry Form Section (Navy) -->
  <section id="quotation" class="py-24 bg-navy-950 text-white hud-grid">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        
        <div class="lg:col-span-5 space-y-6">
          <span class="font-mono text-xs font-bold uppercase tracking-widest text-amber-brand">
            DIRECT ESTIMATING DESK
          </span>
          <h2 class="font-display text-3xl sm:text-4xl font-extrabold text-white tracking-tight leading-tight">
            Request a Dedicated Quote for {service.shortTitle}
          </h2>
          <p class="font-sans text-slate-300 text-sm sm:text-base leading-relaxed">
            Submit your project blueprints, load schedules, or tender documents for an official commercial and engineering evaluation.
          </p>

          <div class="space-y-4 pt-2 font-mono text-xs text-slate-300">
            <div class="flex items-center gap-3">
              <Icon name="phone" class="w-4 h-4 text-amber-brand shrink-0" />
              <span>Call directly: 02-5829700</span>
            </div>
            <div class="flex items-center gap-3">
              <Icon name="mail" class="w-4 h-4 text-amber-brand shrink-0" />
              <span>Email: info@almanartech.com</span>
            </div>
            <div class="flex items-center gap-3">
              <Icon name="clock" class="w-4 h-4 text-amber-brand shrink-0" />
              <span>Turnaround: 24-48 working hours</span>
            </div>
          </div>
        </div>

        <div class="lg:col-span-7">
          <ContactForm preselectedService={service.title} compact={true} />
        </div>

      </div>
    </div>
  </section>

</Layout>
