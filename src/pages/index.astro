---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import AlManarTypographicHero from '../components/AlManarTypographicHero';
import MarqueeTicker from '../components/MarqueeTicker.astro';
import ServiceCockpit from '../components/ServiceCockpit.astro';
import IndustriesEditorial from '../components/IndustriesEditorial.astro';
import ProjectsHorizontalShowcase from '../components/ProjectsHorizontalShowcase.astro';
import ProjectsEditorial from '../components/ProjectsEditorial.astro';
import ContactForm from '../components/ContactForm.astro';
import StatsSection from '../components/StatsSection.astro';
import { COMPANY, WORK_PROCESS } from '../data/company';

const pageTitle = "Engineering the Systems That Keep Buildings Running | Al Manar Tech Abu Dhabi";
const pageDescription = "Al Manar Tech is an established ADDC-approved electromechanical and MEP contractor delivering integrated engineering, HVAC, fire life safety, and IT infrastructure across Abu Dhabi and Al Ain.";
---

<Layout title={pageTitle} description={pageDescription}>

  <!-- =========================================================================
       1. AL MANAR TECH — PHOTO-FREE CINEMATIC TYPOGRAPHIC HERO
       ========================================================================= -->
  <AlManarTypographicHero client:load />

  <!-- =========================================================================
       2. CONTINUOUS ENGINEERING DISCIPLINE MARQUEE
       ========================================================================= -->
  <MarqueeTicker variant="amber" />

  <!-- =========================================================================
       3. INTRODUCTION SECTION — WARM IVORY EDITORIAL SURFACE WITH OVERLAP REVEAL
       ========================================================================= -->
  <section class="py-24 lg:py-32 bg-ivory-100 text-navy-950 border-b border-ivory-300 hud-grid-ivory relative section-overlap-top shadow-2xl">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
        
        <!-- Left: Designed Section Heading Composition (6 Cols) -->
        <div class="lg:col-span-6 space-y-6 scroll-reveal-up">
          <div class="inline-flex items-center gap-2 font-mono text-xs text-navy-900 font-bold uppercase tracking-widest px-3 py-1 rounded-full glass-panel-ivory">
            <span class="text-amber-dark">01 //</span>
            <span>ABOUT THE COMPANY</span>
          </div>

          <h2 class="font-display text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-navy-900 leading-[1.05]">
            Engineering<br/>
            <span class="font-light text-slate-700">with a purpose.</span><br/>
            Building for<br/>
            <span class="text-metallic-amber drawn-accent">what comes next.</span>
          </h2>

          <div class="pt-4 font-mono text-xs text-slate-600 space-y-1">
            <p>CONTRACTOR LICENSURE: ADDC // ADM // ADQCC</p>
            <p>HEADQUARTERS: M35, MUSAFFAH, ABU DHABI</p>
          </div>
        </div>

        <!-- Right: Narrative & Glass Specification Cards (6 Cols) -->
        <div class="lg:col-span-6 space-y-6 font-sans text-slate-700 leading-relaxed text-base sm:text-lg scroll-reveal-up stagger-2">
          <p>
            Since our establishment in 2001, Al Manar Tech has engineered and maintained mission-critical electromechanical infrastructure across the built landscape of Abu Dhabi and Al Ain.
          </p>
          <p class="text-sm sm:text-base text-slate-600">
            Behind every modern commercial facade, retail destination, and industrial production plant lies an intricate nervous system of power distribution, climate engineering, life safety alarms, and optical telecommunications. When these systems are engineered with precision, facilities run seamlessly, energy overheads plummet, and statutory compliance is safeguarded.
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-4 text-xs font-mono">
            <div class="p-5 rounded-2xl glass-panel-ivory space-y-1">
              <span class="text-amber-dark font-bold block text-sm">PRECISION MEP</span>
              <p class="text-slate-600 font-sans text-xs">Full load calculations, single-line diagrams, and substation energization approvals.</p>
            </div>
            <div class="p-5 rounded-2xl glass-panel-ivory space-y-1">
              <span class="text-amber-dark font-bold block text-sm">LIFECYCLE AMC</span>
              <p class="text-slate-600 font-sans text-xs">Planned preventive servicing, switchgear thermal imaging, and 24/7 on-call repair.</p>
            </div>
          </div>

          <div class="pt-4">
            <a href="/about" class="inline-flex items-center gap-2 font-display text-sm font-bold text-navy-900 hover:text-amber-dark transition-colors group">
              <span>Read Our Full Corporate Credentials & Founding Story</span>
              <Icon name="arrow-right" class="w-4 h-4 group-hover:translate-x-1 transition-transform text-amber-dark" />
            </a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- =========================================================================
       4. SERVICES SECTION — INTERACTIVE ARCHITECTURAL GLASS COCKPIT (NAVY)
       ========================================================================= -->
  <section class="py-24 lg:py-32 bg-navy-950 text-white border-b border-navy-800 relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
      
      <!-- Designed Heading Composition -->
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 pb-6 border-b border-white/5 scroll-reveal-up">
        <div class="space-y-3">
          <div class="inline-flex items-center gap-2 font-mono text-xs text-amber-brand font-bold tracking-widest uppercase px-3 py-1 rounded-full glass-panel-amber">
            <span>02 // CAPABILITIES & DIVISIONS</span>
          </div>
          <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-tight">
            Not just systems.<br/>
            <span class="text-metallic-amber">ENGINEERED PERFORMANCE.</span>
          </h2>
        </div>
        <p class="text-slate-400 font-mono text-xs max-w-md">
          INTERACTIVE COCKPIT // HOVER OR TAP ANY DIVISION TO INSPECT REAL-TIME TECHNICAL SPECIFICATIONS & IMAGERY.
        </p>
      </div>

      <!-- Interactive Cockpit Component with Scale Transition -->
      <div class="scroll-reveal-scale">
        <ServiceCockpit />
      </div>

    </div>
  </section>

  <!-- =========================================================================
       5. INDUSTRIES SECTION — WARM IVORY SURFACE WITH CLEAN 16:11 RATIOS
       ========================================================================= -->
  <section class="py-24 lg:py-32 bg-ivory-100 text-navy-950 border-b border-ivory-300 relative section-overlap-top shadow-2xl">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
      
      <!-- Designed Heading Composition -->
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 pb-6 border-b border-ivory-300 scroll-reveal-up">
        <div class="space-y-3">
          <div class="inline-flex items-center gap-2 font-mono text-xs text-navy-900 font-bold tracking-widest uppercase px-3 py-1 rounded-full glass-panel-ivory">
            <span class="text-amber-dark">03 // SECTOR DEPLOYMENTS</span>
          </div>
          <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-extrabold text-navy-900 tracking-tight">
            Tailored Engineering for<br/>
            <span class="text-amber-dark font-light">Demanding Operating Environments.</span>
          </h2>
        </div>
        <p class="text-slate-600 font-mono text-xs max-w-sm">
          MUSAFFAH, KIZAD, ICAD, ABU DHABI ISLAND & AL AIN OPERATING REALITIES.
        </p>
      </div>

      <!-- Clean Editorial Industries Grid -->
      <IndustriesEditorial />

    </div>
  </section>

  <!-- =========================================================================
       6. FEATURED PROJECTS — INTERACTIVE LANDMARK SHOWCASE CAROUSEL (NAVY)
       ========================================================================= -->
  <ProjectsHorizontalShowcase />

  <!-- =========================================================================
       7. PROJECTS DIRECTORY — CATEGORY FILTERABLE EDITORIAL GRID
       ========================================================================= -->
  <section class="py-24 lg:py-32 bg-navy-950 text-white border-b border-navy-800 relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
      
      <!-- Designed Heading Composition -->
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 pb-6 border-b border-white/5 scroll-reveal-up">
        <div class="space-y-3">
          <div class="inline-flex items-center gap-2 font-mono text-xs text-amber-brand font-bold tracking-widest uppercase px-3 py-1 rounded-full glass-panel-amber">
            <span>05 // VERIFIED DIRECTORY</span>
          </div>
          <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight">
            Categorized Portfolio.<br/>
            <span class="text-metallic-amber">FILTER BY OPERATING SECTOR.</span>
          </h2>
        </div>
        <a 
          href="/projects" 
          class="font-mono text-xs text-amber-brand hover:text-white font-bold flex items-center gap-2 shrink-0 px-4 py-2 rounded-xl glass-panel-navy"
        >
          <span>VIEW FULL ARCHIVE (160+ PROJECTS)</span>
          <Icon name="arrow-right" class="w-3.5 h-3.5" />
        </a>
      </div>

      <!-- Asymmetrical Editorial Projects Component with Scroll Reveal -->
      <div class="scroll-reveal-up">
        <ProjectsEditorial showFilters={true} />
      </div>

    </div>
  </section>

  <!-- =========================================================================
       8. PROCESS SECTION — TECHNICAL BLUEPRINT METHODOLOGY (NAVY)
       ========================================================================= -->
  <section class="py-24 lg:py-32 bg-navy-900 text-white border-b border-navy-800 hud-grid relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
      
      <div class="text-center max-w-3xl mx-auto space-y-4">
        <div class="inline-flex items-center gap-2 font-mono text-xs text-amber-brand font-bold tracking-widest uppercase px-3 py-1 rounded-full glass-panel-amber">
          <span>06 // METHODOLOGY</span>
        </div>
        <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight">
          A Disciplined 4-Stage Project Lifecycle
        </h2>
        <p class="text-slate-300 text-sm sm:text-base font-sans">
          From initial load estimation and single-line diagrams to ADDC meter energization and operational handover.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {WORK_PROCESS.map((stage, idx) => (
          <div class={`p-7 rounded-3xl glass-panel-navy flex flex-col justify-between space-y-6 hover:border-amber-brand/50 transition-all scroll-reveal-up stagger-${idx + 1}`}>
            <div class="space-y-3">
              <span class="font-mono text-[10px] text-amber-brand font-bold tracking-wider block">
                {stage.phase}
              </span>
              <span class="font-display text-4xl font-extrabold text-slate-500 block">
                {stage.step}
              </span>
              <h3 class="font-display text-lg font-bold text-white leading-snug">
                {stage.title}
              </h3>
              <p class="font-sans text-xs text-slate-300 leading-relaxed">
                {stage.details}
              </p>
            </div>

            <div class="pt-3 border-t border-white/5 font-mono text-[10px] text-slate-400 flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 rounded-full bg-amber-brand"></span>
              <span>CERTIFIED DELIVERABLE</span>
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- =========================================================================
       9. VERIFIED STATS & ACCREDITATIONS
       ========================================================================= -->
  <StatsSection variant="dark" />

  <!-- =========================================================================
       10. CONTACT & TENDER ESTIMATING DESK (BOLD DARK FINISH WITH AMBER)
       ========================================================================= -->
  <section class="py-24 lg:py-32 bg-navy-950 text-white relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
        
        <div class="lg:col-span-5 space-y-8 scroll-reveal-up">
          <div class="space-y-3">
            <div class="inline-flex items-center gap-2 font-mono text-xs text-amber-brand font-bold tracking-widest uppercase px-3 py-1 rounded-full glass-panel-amber">
              <span>07 // INITIATE CONSULTATION</span>
            </div>
            <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-tight">
              Connect with Our<br/>
              <span class="text-metallic-amber">ENGINEERING DESK.</span>
            </h2>
          </div>

          <p class="font-sans text-sm sm:text-base text-slate-300 leading-relaxed">
            Our estimating engineers review project blueprints, single-line diagrams, and BOQs with strict commercial confidentiality.
          </p>

          <div class="space-y-4 font-mono text-xs text-slate-300 pt-2">
            <div class="p-4 rounded-2xl glass-panel-navy flex items-center justify-between">
              <span>DIRECT TELEPHONE:</span>
              <a href="tel:025829700" class="text-amber-brand font-bold text-sm hover:underline">02-5829700</a>
            </div>
            <div class="p-4 rounded-2xl glass-panel-navy flex items-center justify-between">
              <span>OFFICIAL EMAIL:</span>
              <a href="mailto:info@almanartech.com" class="text-white hover:text-amber-brand">info@almanartech.com</a>
            </div>
            <div class="p-4 rounded-2xl glass-panel-navy flex items-center justify-between">
              <span>HEADQUARTERS:</span>
              <span class="text-slate-300">M35, Musaffah, Abu Dhabi</span>
            </div>
          </div>
        </div>

        <div class="lg:col-span-7 scroll-reveal-scale stagger-2">
          <ContactForm compact={false} />
        </div>

      </div>
    </div>
  </section>

</Layout>
