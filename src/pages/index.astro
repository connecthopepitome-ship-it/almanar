---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import ContactForm from '../components/ContactForm.astro';
import StatsSection from '../components/StatsSection.astro';
import ProjectGallery from '../components/ProjectGallery.astro';
import { COMPANY, SERVICES, INDUSTRIES, WORK_PROCESS } from '../data/company';

const pageTitle = "Engineering the Systems That Keep Buildings Running | MEP & Infrastructure Contracting Abu Dhabi";
const pageDescription = "Al Manar Tech is an ADDC-approved engineering contractor delivering integrated electromechanical, HVAC, fire detection, IT telecom, security, and facility maintenance solutions across Abu Dhabi and Al Ain.";
---

<Layout title={pageTitle} description={pageDescription}>

  <!-- 1. Cinematic Hero Section -->
  <section class="relative bg-navy-950 text-white min-h-[85vh] flex items-center overflow-hidden engineering-grid-dark py-20 lg:py-28">
    <!-- Subtle architectural background accent -->
    <div class="absolute inset-0 bg-gradient-to-r from-navy-950 via-navy-950/95 to-navy-900/80 z-0"></div>
    <div class="absolute right-0 top-0 bottom-0 w-full lg:w-1/2 opacity-20 lg:opacity-30 pointer-events-none z-0">
      <img 
        src="/images/original/alybo5_professionals_in_Abu_Dhabi_working_on_a_big_electrical_i_9c3c592b-a369-4b7e-8b61-72bc56261dcb.png" 
        alt="Al Manar Tech Engineering in Abu Dhabi"
        class="w-full h-full object-cover object-center"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-navy-950 via-navy-950/60 to-transparent"></div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
      <div class="max-w-3xl space-y-8">
        
        <!-- Credibility Tag -->
        <div class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full bg-navy-800/90 border border-gold-500/40 text-gold-400 text-xs font-semibold tracking-wide backdrop-blur-md shadow-sm">
          <Icon name="shield-check" class="w-4 h-4 text-gold-500" />
          <span>ADDC & ADM Approved Electromechanical Contractor • Abu Dhabi</span>
        </div>

        <!-- Hero Headline -->
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-white font-heading tracking-tight leading-[1.15]">
          Engineering the Systems That Keep <span class="text-gold-500 underline decoration-gold-500/30 underline-offset-8">Buildings Running.</span>
        </h1>

        <!-- Hero Description -->
        <p class="text-lg sm:text-xl text-slate-300 leading-relaxed font-normal">
          {COMPANY.description}
        </p>

        <!-- Hero CTAs -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 pt-2">
          <a 
            href="/contact" 
            class="inline-flex items-center justify-center gap-2 px-8 py-4 rounded-xl text-base font-bold bg-gold-500 text-navy-950 hover:bg-gold-400 transition-all duration-200 shadow-lg hover:shadow-gold-glow"
          >
            <span>Discuss Your Project</span>
            <Icon name="arrow-right" class="w-5 h-5" />
          </a>

          <a 
            href="/services" 
            class="inline-flex items-center justify-center gap-2 px-7 py-4 rounded-xl text-base font-semibold bg-navy-800/90 text-white hover:bg-navy-700 border border-navy-700 transition-all duration-200 backdrop-blur-sm"
          >
            <span>Explore Our Services</span>
            <Icon name="chevron-right" class="w-4 h-4 text-gold-500" />
          </a>
        </div>

        <!-- Hero Quick Trust Metrics -->
        <div class="pt-8 border-t border-navy-800/80 grid grid-cols-2 sm:grid-cols-4 gap-4 text-xs">
          <div>
            <span class="block text-xl font-bold font-heading text-white">2001</span>
            <span class="text-slate-400">Established in UAE</span>
          </div>
          <div>
            <span class="block text-xl font-bold font-heading text-gold-500">160+</span>
            <span class="text-slate-400">Verified Projects</span>
          </div>
          <div>
            <span class="block text-xl font-bold font-heading text-white">ADDC</span>
            <span class="text-slate-400">Licensed Contractor</span>
          </div>
          <div>
            <span class="block text-xl font-bold font-heading text-gold-500">24/7</span>
            <span class="text-slate-400">Emergency Support</span>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- 2. Credibility & Authority Indicators Strip -->
  <div class="bg-navy-900 border-b border-navy-800 py-6 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto flex flex-col md:flex-row items-center justify-between gap-4">
      <span class="text-xs font-bold uppercase tracking-wider text-slate-400 shrink-0">
        Certified Conformity & Regulatory Approvals:
      </span>
      <div class="flex flex-wrap items-center justify-center md:justify-end gap-6 sm:gap-8 text-xs font-semibold text-slate-200">
        <div class="flex items-center gap-2">
          <Icon name="check-circle" class="w-4 h-4 text-gold-500 shrink-0" />
          <span>Abu Dhabi Distribution Company (ADDC)</span>
        </div>
        <div class="flex items-center gap-2">
          <Icon name="check-circle" class="w-4 h-4 text-gold-500 shrink-0" />
          <span>Abu Dhabi Municipality (ADM)</span>
        </div>
        <div class="flex items-center gap-2">
          <Icon name="check-circle" class="w-4 h-4 text-gold-500 shrink-0" />
          <span>ADQCC Quality & Conformity</span>
        </div>
        <div class="flex items-center gap-2">
          <Icon name="check-circle" class="w-4 h-4 text-gold-500 shrink-0" />
          <span>UAE Civil Defence Code Aligned</span>
        </div>
      </div>
    </div>
  </div>

  <!-- 3. Company Introduction Section -->
  <section class="py-20 lg:py-28 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
        
        <!-- Left: Text content -->
        <div class="lg:col-span-7 space-y-6">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded bg-cloud-100 border border-cloud-200 text-gold-600 text-xs font-bold uppercase tracking-wider">
            <span>About Al Manar Tech</span>
          </div>

          <h2 class="text-3xl sm:text-4xl font-extrabold text-navy-900 font-heading tracking-tight leading-tight">
            Over Two Decades of Engineering Discipline in Abu Dhabi
          </h2>

          <p class="text-base sm:text-lg text-slate-custom leading-relaxed">
            Since our establishment in 2001, Al Manar Tech has served the demanding built landscape of Abu Dhabi and Al Ain. As an approved contractor recognized by the Abu Dhabi Municipality (ADM), Abu Dhabi Distribution Company (ADDC), and the Abu Dhabi Quality and Conformity Council (ADQCC), we engineer, install, and maintain the electromechanical infrastructure that powers modern enterprises.
          </p>

          <p class="text-sm sm:text-base text-slate-custom leading-relaxed">
            We understand that behind every architectural façade lies a complex network of power distribution, climate engineering, life safety detection, and telecommunications. When these systems are engineered with precision, facilities operate smoothly, energy waste is eliminated, and regulatory compliance is safeguarded.
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-4">
            <div class="p-4 rounded-xl bg-cloud-100 border border-cloud-200">
              <div class="flex items-center gap-2.5 font-bold text-navy-900 text-sm mb-1 font-heading">
                <Icon name="shield-check" class="w-4 h-4 text-gold-600" />
                <span>ADDC Licensed Engineering</span>
              </div>
              <p class="text-xs text-slate-600">
                Official load calculations, shop drawings, single-line diagrams, and substation energization approvals.
              </p>
            </div>

            <div class="p-4 rounded-xl bg-cloud-100 border border-cloud-200">
              <div class="flex items-center gap-2.5 font-bold text-navy-900 text-sm mb-1 font-heading">
                <Icon name="wrench" class="w-4 h-4 text-gold-600" />
                <span>Lifecycle Maintenance</span>
              </div>
              <p class="text-xs text-slate-600">
                Preventive maintenance contracts (PPM), thermal imaging, and 24/7 emergency repair response.
              </p>
            </div>
          </div>

          <div class="pt-4">
            <a href="/about" class="inline-flex items-center gap-2 font-bold text-navy-900 hover:text-gold-600 text-sm group">
              <span>Read Our Full Corporate Profile & Credentials</span>
              <Icon name="arrow-right" class="w-4 h-4 group-hover:translate-x-1 transition-transform" />
            </a>
          </div>
        </div>

        <!-- Right: Real Project Photography & Credibility Badge -->
        <div class="lg:col-span-5 relative">
          <div class="relative rounded-2xl overflow-hidden shadow-2xl border border-cloud-300 aspect-[4/3]">
            <img 
              src="/images/original/alybo5_professionals_in_Abu_Dhabi_working_on_a_big_electrical_i_9c3c592b-a369-4b7e-8b61-72bc56261dcb.png" 
              alt="Al Manar Tech Field Technicians Executing MEP Project in Abu Dhabi"
              class="w-full h-full object-cover"
              loading="lazy"
            />
          </div>

          <!-- Floating Experience Card -->
          <div class="absolute -bottom-6 -left-6 sm:bottom-6 sm:-left-8 bg-navy-950 text-white p-5 rounded-2xl shadow-2xl border border-navy-800 max-w-[260px]">
            <span class="text-3xl font-black text-gold-500 font-heading block">2001</span>
            <span class="text-xs uppercase tracking-wider font-semibold text-slate-300 block mb-1">Established in UAE</span>
            <p class="text-[11px] text-slate-400 leading-tight">
              Over 23 years of continuous contracting excellence across Abu Dhabi & Al Ain.
            </p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- 4. Six Core Service Divisions -->
  <section class="py-20 lg:py-28 bg-cloud-100 border-y border-cloud-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Section Header -->
      <div class="max-w-3xl mx-auto text-center space-y-4 mb-16">
        <span class="text-xs font-bold uppercase tracking-wider text-gold-600">
          Integrated Capabilities
        </span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-navy-900 font-heading tracking-tight">
          Six Core Engineering Divisions
        </h2>
        <p class="text-slate-custom text-base sm:text-lg">
          Complete end-to-end design, authority coordination, installation, testing, and lifecycle maintenance for installed building infrastructures.
        </p>
      </div>

      <!-- Services Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {SERVICES.map((service) => (
          <div class="bg-white rounded-2xl border border-cloud-200 shadow-premium p-8 flex flex-col justify-between hover:shadow-premium-lg hover:border-gold-500/50 transition-all duration-300 group">
            <div class="space-y-5">
              <!-- Service Icon & Category -->
              <div class="flex items-center justify-between">
                <div class="w-14 h-14 rounded-xl bg-navy-900 text-gold-500 flex items-center justify-center shadow-md group-hover:bg-gold-500 group-hover:text-navy-950 transition-colors">
                  <Icon name={service.icon.toLowerCase()} class="w-7 h-7" />
                </div>
                <span class="text-[11px] font-bold uppercase tracking-wider px-2.5 py-1 rounded bg-cloud-100 text-navy-800">
                  {service.category}
                </span>
              </div>

              <!-- Title & Tagline -->
              <div>
                <h3 class="text-xl font-bold text-navy-900 font-heading group-hover:text-gold-600 transition-colors">
                  <a href={`/services/${service.slug}`} class="focus:outline-none">
                    {service.title}
                  </a>
                </h3>
                <p class="text-xs text-gold-600 font-semibold mt-1">
                  {service.tagline}
                </p>
              </div>

              <!-- Description -->
              <p class="text-sm text-slate-custom leading-relaxed">
                {service.description}
              </p>

              <!-- Technical Highlights Bullets -->
              <div class="space-y-2 pt-2 border-t border-cloud-100">
                <span class="text-[11px] font-bold uppercase tracking-wider text-navy-900 block">
                  Core Technical Scope:
                </span>
                <ul class="space-y-1.5 text-xs text-slate-600">
                  {service.technicalHighlights.slice(0, 3).map((item) => (
                    <li class="flex items-start gap-2">
                      <Icon name="check" class="w-3.5 h-3.5 text-gold-600 shrink-0 mt-0.5" />
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>

            <!-- Card Action Footer -->
            <div class="pt-6 mt-6 border-t border-cloud-100 flex items-center justify-between">
              <a 
                href={`/services/${service.slug}`} 
                class="inline-flex items-center gap-1.5 text-sm font-bold text-navy-900 group-hover:text-gold-600 transition-colors"
              >
                <span>View Technical Scope</span>
                <Icon name="arrow-right" class="w-4 h-4 group-hover:translate-x-1 transition-transform" />
              </a>
              <span class="text-xs font-semibold text-slate-400">
                ADDC / UAE Code
              </span>
            </div>
          </div>
        ))}
      </div>

      <!-- Bottom Overview CTA -->
      <div class="mt-12 text-center">
        <a 
          href="/services" 
          class="inline-flex items-center gap-2 px-6 py-3 rounded-xl text-sm font-bold bg-navy-900 text-white hover:bg-navy-800 transition-colors shadow-sm"
        >
          <span>Explore All Engineering Divisions & Specifications</span>
          <Icon name="arrow-right" class="w-4 h-4" />
        </a>
      </div>

    </div>
  </section>

  <!-- 5. Industries Served Section -->
  <section class="py-20 lg:py-28 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="max-w-3xl mx-auto text-center space-y-4 mb-16">
        <span class="text-xs font-bold uppercase tracking-wider text-gold-600">
          Sector Experience
        </span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-navy-900 font-heading tracking-tight">
          Tailored Engineering for Demanding Sectors
        </h2>
        <p class="text-slate-custom text-base sm:text-lg">
          Each industry presents unique electromechanical constraints, thermal loads, and compliance requirements.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {INDUSTRIES.map((ind) => (
          <div class="bg-white rounded-2xl border border-cloud-200 overflow-hidden shadow-premium hover:shadow-premium-lg transition-all duration-300 flex flex-col justify-between">
            <div class="relative aspect-[16/10] bg-navy-900">
              <img 
                src={ind.image} 
                alt={`${ind.name} Engineering in Abu Dhabi`}
                class="w-full h-full object-cover"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-navy-950/90 via-navy-950/30 to-transparent"></div>
              <h3 class="absolute bottom-4 left-5 right-5 text-xl font-bold text-white font-heading">
                {ind.name}
              </h3>
            </div>

            <div class="p-6 flex-1 flex flex-col justify-between space-y-4">
              <div>
                <p class="text-xs text-gold-600 font-semibold mb-2">
                  {ind.tagline}
                </p>
                <p class="text-sm text-slate-custom leading-relaxed">
                  {ind.description}
                </p>
              </div>

              <div class="pt-4 border-t border-cloud-100">
                <span class="text-[11px] font-bold uppercase tracking-wider text-navy-900 block mb-2">
                  Primary Capabilities Deployed:
                </span>
                <div class="flex flex-wrap gap-1.5">
                  {ind.servicesOffered.map((svc) => (
                    <span class="px-2 py-1 rounded bg-cloud-100 text-navy-900 text-xs font-medium">
                      {svc}
                    </span>
                  ))}
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>

      <div class="mt-12 text-center">
        <a 
          href="/industries" 
          class="inline-flex items-center gap-2 font-bold text-navy-900 hover:text-gold-600 text-sm group"
        >
          <span>View Industry Challenges & Engineering Solutions</span>
          <Icon name="arrow-right" class="w-4 h-4 group-hover:translate-x-1 transition-transform" />
        </a>
      </div>

    </div>
  </section>

  <!-- 6. Verified Project Portfolio Gallery -->
  <section class="py-20 lg:py-28 bg-cloud-100 border-y border-cloud-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12">
        <div class="space-y-2">
          <span class="text-xs font-bold uppercase tracking-wider text-gold-600">
            Proven Track Record
          </span>
          <h2 class="text-3xl sm:text-4xl font-extrabold text-navy-900 font-heading tracking-tight">
            Selected Project Portfolio
          </h2>
          <p class="text-slate-custom text-base max-w-2xl">
            Real, confirmed technical and electromechanical installations completed for reputable entities in Abu Dhabi and across the UAE.
          </p>
        </div>

        <a 
          href="/projects" 
          class="inline-flex items-center gap-2 px-6 py-3 rounded-xl text-sm font-bold bg-navy-900 text-white hover:bg-navy-800 transition-colors shrink-0 shadow-sm"
        >
          <span>View All Completed Projects</span>
          <Icon name="arrow-right" class="w-4 h-4" />
        </a>
      </div>

      <!-- Project Gallery with 6 items on home -->
      <ProjectGallery limit={6} showFilters={true} />

    </div>
  </section>

  <!-- 7. Four-Step Project Delivery Process -->
  <section class="py-20 lg:py-28 bg-navy-950 text-white engineering-grid-dark">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="max-w-3xl mx-auto text-center space-y-4 mb-16">
        <span class="text-xs font-bold uppercase tracking-wider text-gold-500">
          Disciplined Execution
        </span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-white font-heading tracking-tight">
          Our 4-Stage Project Delivery Process
        </h2>
        <p class="text-slate-300 text-base sm:text-lg">
          From preliminary load calculations to final ADDC energization and operational handover, every milestone is managed with rigor.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        {WORK_PROCESS.map((stage) => (
          <div class="relative bg-navy-900 border border-navy-800 rounded-2xl p-6 sm:p-7 flex flex-col justify-between space-y-4 hover:border-gold-500/50 transition-colors">
            <div>
              <div class="text-3xl font-black font-heading text-gold-500 mb-4 opacity-90">
                {stage.step}
              </div>
              <h3 class="text-lg font-bold text-white font-heading mb-2">
                {stage.title}
              </h3>
              <p class="text-xs text-gold-400 font-semibold mb-3">
                {stage.summary}
              </p>
              <p class="text-xs text-slate-300 leading-relaxed">
                {stage.details}
              </p>
            </div>

            <div class="pt-4 border-t border-navy-800 text-[11px] font-semibold text-slate-400 flex items-center gap-1.5">
              <Icon name="check-circle" class="w-3.5 h-3.5 text-gold-500" />
              <span>Certified Engineering Stage</span>
            </div>
          </div>
        ))}
      </div>

      <div class="mt-12 text-center">
        <a 
          href="/process" 
          class="inline-flex items-center gap-2 text-sm font-semibold text-gold-400 hover:text-gold-300 group"
        >
          <span>Learn More About Our Quality Assurance & Safety Procedures</span>
          <Icon name="arrow-right" class="w-4 h-4 group-hover:translate-x-1 transition-transform" />
        </a>
      </div>

    </div>
  </section>

  <!-- 8. Verified Stats & Accreditations -->
  <StatsSection variant="dark" />

  <!-- 9. Why Choose Al Manar Tech (Credibility Grid) -->
  <section class="py-20 lg:py-28 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
        
        <div class="lg:col-span-5 space-y-6">
          <span class="text-xs font-bold uppercase tracking-wider text-gold-600">
            Why Al Manar Tech
          </span>
          <h2 class="text-3xl sm:text-4xl font-extrabold text-navy-900 font-heading tracking-tight leading-tight">
            Built on Rigorous Standards, Not Shortcuts
          </h2>
          <p class="text-slate-custom text-base leading-relaxed">
            In technical and electromechanical contracting, cutting corners results in catastrophic downtime, electrical fires, and rejected authority inspections. Al Manar Tech pairs seasoned field expertise with strict adherence to UAE building codes.
          </p>

          <div class="space-y-4 pt-2">
            <div class="flex items-start gap-3">
              <div class="w-8 h-8 rounded-lg bg-navy-900 text-gold-500 flex items-center justify-center shrink-0 mt-1">
                <Icon name="shield-check" class="w-4 h-4" />
              </div>
              <div>
                <h3 class="text-sm font-bold text-navy-900 font-heading">Official ADDC Approved Status</h3>
                <p class="text-xs text-slate-custom mt-0.5">Licensed to prepare, submit, and sign off electrical designs and power connections.</p>
              </div>
            </div>

            <div class="flex items-start gap-3">
              <div class="w-8 h-8 rounded-lg bg-navy-900 text-gold-500 flex items-center justify-center shrink-0 mt-1">
                <Icon name="wrench" class="w-4 h-4" />
              </div>
              <div>
                <h3 class="text-sm font-bold text-navy-900 font-heading">Certified Field Engineers & Technicians</h3>
                <p class="text-xs text-slate-custom mt-0.5">Continuous training in UAE Civil Defence codes, Estidama standards, and telecom compliance.</p>
              </div>
            </div>

            <div class="flex items-start gap-3">
              <div class="w-8 h-8 rounded-lg bg-navy-900 text-gold-500 flex items-center justify-center shrink-0 mt-1">
                <Icon name="clock" class="w-4 h-4" />
              </div>
              <div>
                <h3 class="text-sm font-bold text-navy-900 font-heading">Reliable Turnarounds & Timelines</h3>
                <p class="text-xs text-slate-custom mt-0.5">Committed milestone tracking ensuring commercial retail tenancies and offices open on schedule.</p>
              </div>
            </div>
          </div>
        </div>

        <div class="lg:col-span-7">
          <ContactForm compact={false} />
        </div>

      </div>

    </div>
  </section>

</Layout>
