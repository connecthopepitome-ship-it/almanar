---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import AlManarReferenceHero from '../components/AlManarReferenceHero.astro';
import MarqueeTicker from '../components/MarqueeTicker.astro';
import ServiceCockpit from '../components/ServiceCockpit.astro';
import IndustriesEditorial from '../components/IndustriesEditorial.astro';
import ProjectsEditorial from '../components/ProjectsEditorial.astro';
import WhyChooseUs from '../components/WhyChooseUs.astro';
import ContactForm from '../components/ContactForm.astro';
import { COMPANY, WORK_PROCESS } from '../data/company';

const pageTitle = "Engineering the Systems That Keep Buildings Running | Al Manar Tech Abu Dhabi";
const pageDescription = "Al Manar Tech is an established ADDC-approved electromechanical and MEP contractor delivering integrated engineering, HVAC, fire life safety, and IT infrastructure across Abu Dhabi and Al Ain.";
---

<Layout title={pageTitle} description={pageDescription}>

  <!-- =========================================================================
       SECTION 01 — CINEMATIC HERO (WITH 14-SLICE VENETIAN CAROUSEL)
       ========================================================================= -->
  <AlManarReferenceHero />

  <!-- CONTINUOUS ENGINEERING DISCIPLINE MARQUEE -->
  <MarqueeTicker variant="amber" />

  <!-- =========================================================================
       SECTION 02 — ABOUT AL MANAR TECH (OBSIDIAN & WARM COPPER EDITORIAL SURFACE)
       ========================================================================= -->
  <section id="about" class="py-24 lg:py-32 bg-[#17191D] text-white border-b border-white/10 hud-grid relative section-overlap-top shadow-2xl">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
        
        <!-- Left: Heading Composition (6 Cols) -->
        <div class="lg:col-span-6 space-y-6 scroll-reveal-up">
          <div class="inline-flex items-center gap-2 font-mono text-xs text-[#FFAB78] font-bold uppercase tracking-widest px-3.5 py-1.5 rounded-full bg-[#252A30] border border-[#B56E4B]/40">
            <span class="text-[#F07842]">02 //</span>
            <span>ABOUT AL MANAR TECH</span>
          </div>

          <h2 class="font-display text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-white leading-[1.05]">
            Engineering<br/>
            <span class="font-light text-slate-300">with a purpose.</span><br/>
            Building for<br/>
            <span class="text-[#F07842] drawn-accent">what comes next.</span>
          </h2>

          <div class="pt-4 font-mono text-xs text-slate-400 space-y-1">
            <p>CONTRACTOR LICENSURE: <span class="text-white font-bold">ADDC // ADM // ADQCC</span></p>
            <p>HEADQUARTERS: <span class="text-white font-bold">M35, MUSAFFAH, ABU DHABI</span></p>
          </div>
        </div>

        <!-- Right: Narrative & Dual Glass Spec Cards (6 Cols) -->
        <div class="lg:col-span-6 space-y-6 font-sans text-slate-200 leading-relaxed text-base sm:text-lg scroll-reveal-up stagger-2">
          <p class="text-slate-100 font-medium">
            Since our establishment in 2001, Al Manar Tech has engineered and maintained mission-critical electromechanical infrastructure across the built landscape of Abu Dhabi and Al Ain.
          </p>
          <p class="text-sm sm:text-base text-slate-300 leading-relaxed">
            Behind every modern commercial facade, retail destination, and industrial production plant lies an intricate nervous system of power distribution, climate engineering, life safety alarms, and optical telecommunications. When these systems are engineered with precision, facilities run seamlessly, energy overheads plummet, and statutory compliance is safeguarded.
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-4 text-xs font-mono">
            <div class="p-5 rounded-2xl bg-[#252A30]/80 border border-white/10 space-y-1.5 hover:border-[#F07842]/50 transition-colors shadow-lg">
              <span class="text-[#FFAB78] font-bold block text-sm tracking-wide">PRECISION MEP</span>
              <p class="text-slate-300 font-sans text-xs leading-relaxed">Full load calculations, single-line diagrams, and substation energization approvals.</p>
            </div>
            <div class="p-5 rounded-2xl bg-[#252A30]/80 border border-white/10 space-y-1.5 hover:border-[#F07842]/50 transition-colors shadow-lg">
              <span class="text-[#FFAB78] font-bold block text-sm tracking-wide">LIFECYCLE AMC</span>
              <p class="text-slate-300 font-sans text-xs leading-relaxed">Planned preventive servicing, switchgear thermal imaging, and 24/7 on-call repair.</p>
            </div>
          </div>

          <div class="pt-4">
            <a href="/about" class="inline-flex items-center gap-2 font-display text-sm font-bold text-white hover:text-[#FFAB78] transition-colors group">
              <span>Read Our Full Corporate Credentials &amp; Founding Story</span>
              <Icon name="arrow-right" class="w-4 h-4 group-hover:translate-x-1 transition-transform text-[#F07842]" />
            </a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- =========================================================================
       SECTION 03 — OUR ENGINEERING DIVISIONS (PRIMARY UNIFIED SERVICES COCKPIT)
       ========================================================================= -->
  <section id="services" class="py-24 lg:py-32 bg-navy-950 text-white border-b border-navy-800 relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
      
      <!-- Heading Composition matching Phase 2 Part A -->
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 pb-6 border-b border-white/10 scroll-reveal-up">
        <div class="space-y-3">
          <div class="inline-flex items-center gap-2 font-mono text-xs text-[#F07842] font-bold tracking-widest uppercase px-3.5 py-1.5 rounded-full bg-[#252A30] border border-[#B56E4B]/40">
            <span>03 // OUR ENGINEERING DIVISIONS</span>
          </div>
          <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-tight">
            OUR ENGINEERING DIVISIONS
          </h2>
          <p class="text-slate-300 font-sans text-base max-w-2xl leading-relaxed">
            Integrated technical expertise across building systems, infrastructure and facility operations.
          </p>
        </div>
        <p class="text-slate-400 font-mono text-xs max-w-xs">
          INTERACTIVE COCKPIT // SELECT ANY DIVISION TO INSPECT REAL-TIME TECHNICAL SPECIFICATIONS, IMAGERY &amp; SCOPE.
        </p>
      </div>

      <!-- Unified Cockpit Component -->
      <div class="scroll-reveal-scale">
        <ServiceCockpit />
      </div>

    </div>
  </section>

  <!-- =========================================================================
       SECTION 04 — INDUSTRIES WE SERVE (8-SECTOR EDITORIAL GRID)
       ========================================================================= -->
  <section id="industries" class="py-24 lg:py-32 bg-[#152435] text-white border-b border-white/10 relative section-overlap-top shadow-2xl">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
      
      <!-- Heading Composition -->
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 pb-6 border-b border-white/10 scroll-reveal-up">
        <div class="space-y-3">
          <div class="inline-flex items-center gap-2 font-mono text-xs text-[#FFAB78] font-bold tracking-widest uppercase px-3.5 py-1.5 rounded-full bg-[#1D2E42] border border-[#B56E4B]/40">
            <span class="text-[#F07842]">04 //</span>
            <span>INDUSTRIES WE SERVE</span>
          </div>
          <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight">
            Tailored Engineering for<br/>
            <span class="text-[#F07842] font-light">Demanding Operating Environments.</span>
          </h2>
        </div>
        <p class="text-slate-300 font-mono text-xs max-w-sm">
          MUSAFFAH, KIZAD, ICAD, ABU DHABI ISLAND &amp; AL AIN OPERATING REALITIES.
        </p>
      </div>

      <!-- Clean Editorial Industries Grid -->
      <IndustriesEditorial />

    </div>
  </section>

  <!-- =========================================================================
       SECTION 05 — SELECTED PROJECTS (CONSOLIDATED CASE-STUDY SHOWCASE)
       ========================================================================= -->
  <section id="projects" class="py-24 lg:py-32 bg-navy-950 text-white border-b border-navy-800 relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
      
      <!-- Heading Composition matching Phase 2 Part B -->
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 pb-6 border-b border-white/10 scroll-reveal-up">
        <div class="space-y-3">
          <div class="inline-flex items-center gap-2 font-mono text-xs text-[#F07842] font-bold tracking-widest uppercase px-3.5 py-1.5 rounded-full bg-[#252A30] border border-[#B56E4B]/40">
            <span>05 // SELECTED PROJECTS</span>
          </div>
          <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-tight">
            SELECTED PROJECTS
          </h2>
          <p class="text-slate-300 font-sans text-base max-w-2xl leading-relaxed">
            Engineering expertise delivered across commercial, retail, hospitality and institutional environments.
          </p>
        </div>
        <a 
          href="/projects" 
          class="font-mono text-xs text-[#F07842] hover:text-white font-bold flex items-center gap-2 shrink-0 px-4 py-2.5 rounded-xl bg-[#252A30] border border-white/10 hover:border-[#F07842]/50 transition-colors"
        >
          <span>VIEW FULL ARCHIVE (160+ PROJECTS)</span>
          <Icon name="arrow-right" class="w-3.5 h-3.5" />
        </a>
      </div>

      <!-- Consolidated Editorial Projects Component with Case Study Detail Links -->
      <div class="scroll-reveal-up">
        <ProjectsEditorial showFilters={true} />
      </div>

    </div>
  </section>

  <!-- =========================================================================
       SECTION 06 — WHY AL MANAR TECH (CONSOLIDATED CREDIBILITY & STATS)
       ========================================================================= -->
  <WhyChooseUs />

  <!-- =========================================================================
       SECTION 07 — OUR PROCESS (4-STAGE METHODOLOGY TIMELINE)
       ========================================================================= -->
  <section id="process" class="py-24 lg:py-32 bg-navy-900 text-white border-b border-navy-800 hud-grid relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
      
      <div class="text-center max-w-3xl mx-auto space-y-4">
        <div class="inline-flex items-center gap-2 font-mono text-xs text-[#F07842] font-bold tracking-widest uppercase px-3 py-1 rounded-full glass-panel-copper">
          <span>07 // OUR PROCESS</span>
        </div>
        <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight">
          A Disciplined 4-Stage Project Lifecycle
        </h2>
        <p class="text-slate-300 text-sm sm:text-base font-sans">
          From initial load estimation and single-line diagrams to ADDC meter energization and operational handover.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {WORK_PROCESS.map((stage, idx) => (
          <div class={`p-7 rounded-3xl glass-panel-navy flex flex-col justify-between space-y-6 hover:border-[#F07842]/50 transition-all scroll-reveal-up stagger-${idx + 1}`}>
            <div class="space-y-3">
              <span class="font-mono text-[10px] text-[#F07842] font-bold tracking-wider block">
                {stage.phase}
              </span>
              <span class="font-display text-4xl font-extrabold text-slate-500 block">
                {stage.step}
              </span>
              <h3 class="font-display text-lg font-bold text-white leading-snug">
                {stage.title}
              </h3>
              <p class="font-sans text-xs text-slate-300 leading-relaxed">
                {stage.details}
              </p>
            </div>

            <div class="pt-3 border-t border-white/5 font-mono text-[10px] text-slate-400 flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 rounded-full bg-[#F07842]"></span>
              <span>CERTIFIED DELIVERABLE</span>
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- =========================================================================
       SECTION 08 — CONTACT & PROJECT ENQUIRY (DESK CONSULTATION & WHATSAPP)
       ========================================================================= -->
  <section id="contact" class="py-24 lg:py-32 bg-navy-950 text-white relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
        
        <div class="lg:col-span-5 space-y-8 scroll-reveal-up">
          <div class="space-y-3">
            <div class="inline-flex items-center gap-2 font-mono text-xs text-[#F07842] font-bold tracking-widest uppercase px-3 py-1 rounded-full glass-panel-copper">
              <span>08 // INITIATE CONSULTATION</span>
            </div>
            <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-tight">
              Connect with Our<br/>
              <span class="text-copper-headline">ENGINEERING DESK.</span>
            </h2>
          </div>

          <p class="font-sans text-sm sm:text-base text-slate-300 leading-relaxed">
            Our estimating engineers review project blueprints, single-line diagrams, and BOQs with strict commercial confidentiality.
          </p>

          <div class="space-y-4 font-mono text-xs text-slate-300 pt-2">
            <div class="p-4 rounded-2xl glass-panel-navy flex items-center justify-between border border-white/10">
              <span>DIRECT TELEPHONE:</span>
              <a href="tel:025829700" class="text-[#F07842] font-bold text-sm hover:underline">02-5829700</a>
            </div>
            <div class="p-4 rounded-2xl glass-panel-navy flex items-center justify-between border border-white/10">
              <span>OFFICIAL EMAIL:</span>
              <a href="mailto:info@almanartech.com" class="text-white hover:text-[#F07842]">info@almanartech.com</a>
            </div>
            <div class="p-4 rounded-2xl glass-panel-navy flex items-center justify-between border border-white/10">
              <span>HEADQUARTERS:</span>
              <span class="text-slate-300">Warehouse 2, Al Afou 3 St, M35 Musaffah</span>
            </div>
          </div>
        </div>

        <div class="lg:col-span-7 scroll-reveal-scale stagger-2">
          <ContactForm compact={false} />
        </div>

      </div>
    </div>
  </section>

</Layout>
