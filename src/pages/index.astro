---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import MarqueeTicker from '../components/MarqueeTicker.astro';
import ServiceCockpit from '../components/ServiceCockpit.astro';
import IndustriesEditorial from '../components/IndustriesEditorial.astro';
import ProjectsEditorial from '../components/ProjectsEditorial.astro';
import ContactForm from '../components/ContactForm.astro';
import StatsSection from '../components/StatsSection.astro';
import { COMPANY, WORK_PROCESS } from '../data/company';

const pageTitle = "Engineering the Systems That Keep Buildings Running | Al Manar Tech Abu Dhabi";
const pageDescription = "Al Manar Tech is an established ADDC-approved electromechanical and MEP contractor delivering integrated engineering, HVAC, fire life safety, and IT infrastructure across Abu Dhabi and Al Ain.";
---

<Layout title={pageTitle} description={pageDescription}>

  <!-- =========================================================================
       1. HERO SECTION — KINETIC ENGINEERING SPLIT COMPOSITION
       ========================================================================= -->
  <section class="relative bg-navy-950 text-white min-h-[92vh] flex items-center overflow-hidden hud-grid pt-12 pb-20 lg:py-24">
    
    <!-- Subtle moving radial ambient light behind hero -->
    <div class="absolute top-1/4 left-1/3 w-[600px] h-[600px] bg-amber-brand/5 rounded-full blur-[140px] pointer-events-none -z-0"></div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
        
        <!-- LEFT COLUMN: Headline & Telemetry (7 Cols) -->
        <div class="lg:col-span-7 space-y-8 mask-reveal-trigger">
          
          <!-- Animated Engineering Approval Label -->
          <div class="inline-flex items-center gap-3 px-3.5 py-1.5 rounded-full bg-navy-900 border border-amber-brand/40 text-slate-200 text-xs font-mono tracking-wider backdrop-blur-md">
            <span class="w-2 h-2 rounded-full bg-amber-brand animate-ping"></span>
            <span class="text-amber-brand font-bold">[SYS_AUTH: ADDC-CON-2001]</span>
            <span class="hidden sm:inline text-slate-400">• ABU DHABI MUNICIPALITY LICENSED</span>
          </div>

          <!-- Large Kinetic Headline with Deliberate Line Breaks -->
          <h1 class="font-display font-extrabold text-5xl sm:text-6xl lg:text-7xl xl:text-[82px] leading-compressed tracking-tighter text-white">
            <span class="mask-line">
              <span class="mask-line-inner">Engineering</span>
            </span>
            <span class="mask-line">
              <span class="mask-line-inner">the Systems</span>
            </span>
            <span class="mask-line">
              <span class="mask-line-inner text-slate-200">That Keep Buildings</span>
            </span>
            <span class="mask-line">
              <span class="mask-line-inner text-amber-brand underline-reveal active">Running.</span>
            </span>
          </h1>

          <!-- Supporting Description -->
          <p class="text-base sm:text-lg text-slate-300 leading-relaxed font-sans max-w-2xl">
            {COMPANY.description}
          </p>

          <!-- Primary and Secondary CTAs with Magnetic Effect -->
          <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 pt-2">
            <a 
              href="/contact" 
              data-magnetic="true"
              class="inline-flex items-center justify-center gap-2.5 px-8 py-4 rounded-xl text-sm font-display font-bold uppercase tracking-wider bg-amber-brand text-navy-950 hover:bg-amber-glow shadow-amber-glow transition-all duration-200"
            >
              <span>Discuss Your Project</span>
              <Icon name="arrow-right" class="w-4 h-4" />
            </a>

            <a 
              href="/services" 
              data-magnetic="true"
              class="inline-flex items-center justify-center gap-2 px-7 py-4 rounded-xl text-sm font-mono font-semibold bg-navy-900 text-white hover:bg-navy-850 border border-navy-700 hover:border-amber-brand/40 transition-all duration-200"
            >
              <span>Explore Divisions</span>
              <span class="text-amber-brand">→</span>
            </a>
          </div>

          <!-- Compact Technical Statistics Strip -->
          <div class="pt-8 border-t border-navy-800/80 grid grid-cols-3 gap-6 font-mono text-xs">
            <div>
              <span class="text-slate-500 block text-[10px] tracking-widest uppercase">FOUNDED</span>
              <span class="text-2xl font-bold font-display text-white tracking-tight">2001</span>
              <span class="text-slate-400 block text-[11px]">23+ YRS UAE</span>
            </div>
            <div>
              <span class="text-slate-500 block text-[10px] tracking-widest uppercase">COMPLETED</span>
              <span class="text-2xl font-bold font-display text-amber-brand tracking-tight">160+</span>
              <span class="text-slate-400 block text-[11px]">VERIFIED SITES</span>
            </div>
            <div>
              <span class="text-slate-500 block text-[10px] tracking-widest uppercase">AUTHORITY</span>
              <span class="text-2xl font-bold font-display text-white tracking-tight">ADDC</span>
              <span class="text-slate-400 block text-[11px]">CERTIFIED MEP</span>
            </div>
          </div>

        </div>

        <!-- RIGHT COLUMN: Asymmetrical Frame & Interactive Photo (5 Cols) -->
        <div class="lg:col-span-5 relative" id="hero-photo-wrapper">
          
          <!-- Outer Asymmetrical Frame with Corner Crosshairs -->
          <div 
            id="hero-photo-frame"
            class="relative rounded-3xl overflow-hidden border border-navy-800 bg-navy-900 shadow-editorial crosshair-corner group transition-transform duration-500 ease-out"
            data-cursor="view"
          >
            <!-- Authentic Engineering Photo -->
            <div class="aspect-[4/5] sm:aspect-[4/4.5] overflow-hidden relative">
              <img 
                src="/images/original/electrical-team-abu-dhabi.png" 
                alt="Al Manar Tech Field Engineering Technicians Executing Switchgear Works in Abu Dhabi"
                class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-1000"
                loading="eager"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-navy-950 via-navy-950/20 to-transparent"></div>

              <!-- Animated Moving Amber Scanning Line -->
              <div class="absolute inset-x-0 h-1 bg-gradient-to-r from-transparent via-amber-brand to-transparent animate-scanline pointer-events-none"></div>

              <!-- Rotated Vertical Identifier -->
              <div class="absolute right-3 top-6 bottom-6 hidden sm:flex items-center justify-center pointer-events-none">
                <span class="font-mono text-[9px] tracking-widest text-amber-brand/80 uppercase [writing-mode:vertical-rl] rotate-180 select-none">
                  AL MANAR TECH — INFRASTRUCTURE COCKPIT // AUH-M35
                </span>
              </div>
            </div>

            <!-- Floating Technical Metadata HUD Panel -->
            <div class="absolute bottom-4 left-4 right-4 bg-navy-950/90 backdrop-blur-md p-4 rounded-2xl border border-navy-800 font-mono text-xs space-y-2">
              <div class="flex items-center justify-between border-b border-navy-800 pb-2">
                <span class="text-slate-400">TELEMETRY_STATUS</span>
                <span class="text-emerald-400 font-bold flex items-center gap-1.5">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                  OPERATIONAL
                </span>
              </div>
              <div class="grid grid-cols-2 gap-2 text-[11px] text-slate-300">
                <div>
                  <span class="text-slate-500 block text-[9px]">LOAD CAPACITY</span>
                  <span class="font-semibold text-white">415V / 3-PHASE</span>
                </div>
                <div>
                  <span class="text-slate-500 block text-[9px]">REGULATORY CODE</span>
                  <span class="font-semibold text-amber-brand">ADDC COMPLIANT</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Ambient Amber Glow behind photo frame -->
          <div class="absolute -bottom-8 -right-8 w-48 h-48 bg-amber-brand/10 rounded-full blur-3xl pointer-events-none -z-10"></div>
        </div>

      </div>
    </div>
  </section>

  <!-- =========================================================================
       2. CONTINUOUS ENGINEERING DISCIPLINE MARQUEE
       ========================================================================= -->
  <MarqueeTicker variant="amber" />

  <!-- =========================================================================
       3. INTRODUCTION SECTION — WARM IVORY EDITORIAL SURFACE
       ========================================================================= -->
  <section class="py-24 lg:py-32 bg-ivory-100 text-navy-950 border-b border-ivory-300 hud-grid-ivory relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
        
        <!-- Left: Editorial Label & Headline (6 Cols) -->
        <div class="lg:col-span-6 space-y-6">
          <div class="inline-flex items-center gap-2 font-mono text-xs text-navy-900 font-bold uppercase tracking-widest">
            <span class="text-amber-dark">01 //</span>
            <span>CORPORATE POSITIONING</span>
          </div>

          <h2 class="font-display text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-navy-900 leading-[1.05]">
            Engineering the invisible arteries of Abu Dhabi’s architecture.
          </h2>

          <div class="pt-4 font-mono text-xs text-slate-600 space-y-1">
            <p>CONTRACTOR LICENSURE: ADDC // ADM // ADQCC</p>
            <p>HEADQUARTERS: M35, MUSAFFAH, ABU DHABI</p>
          </div>
        </div>

        <!-- Right: Analytical Narrative & Highlight Badges (6 Cols) -->
        <div class="lg:col-span-6 space-y-6 font-sans text-slate-700 leading-relaxed text-base sm:text-lg">
          <p>
            Since our establishment in 2001, Al Manar Tech has engineered and maintained mission-critical electromechanical infrastructure across the built environment of Abu Dhabi and Al Ain.
          </p>
          <p class="text-sm sm:text-base text-slate-600">
            Behind every modern commercial facade, retail destination, and industrial production plant lies an intricate nervous system of power distribution, climate engineering, life safety alarms, and optical telecommunications. When these systems are engineered with precision, facilities run seamlessly, energy overheads plummet, and statutory compliance is safeguarded.
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-4 text-xs font-mono">
            <div class="p-4 rounded-xl bg-white border border-ivory-300 shadow-sm space-y-1">
              <span class="text-amber-dark font-bold block">PRECISION MEP</span>
              <p class="text-slate-600 font-sans">Full load calculations, single-line diagrams, and substation energization approvals.</p>
            </div>
            <div class="p-4 rounded-xl bg-white border border-ivory-300 shadow-sm space-y-1">
              <span class="text-amber-dark font-bold block">LIFECYCLE AMC</span>
              <p class="text-slate-600 font-sans">Planned preventive servicing, switchgear thermal imaging, and 24/7 on-call repair.</p>
            </div>
          </div>

          <div class="pt-4">
            <a href="/about" class="inline-flex items-center gap-2 font-display text-sm font-bold text-navy-900 hover:text-amber-dark transition-colors group">
              <span>Read Our Full Corporate Credentials & Founding Story</span>
              <Icon name="arrow-right" class="w-4 h-4 group-hover:translate-x-1 transition-transform text-amber-dark" />
            </a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- =========================================================================
       4. SERVICES SECTION — INTERACTIVE EDITORIAL COCKPIT (NAVY)
       ========================================================================= -->
  <section class="py-24 lg:py-32 bg-navy-950 text-white border-b border-navy-800 relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
      
      <!-- Section Header -->
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 pb-6 border-b border-navy-800">
        <div class="space-y-3">
          <div class="inline-flex items-center gap-2 font-mono text-xs text-amber-brand font-bold tracking-widest uppercase">
            <span>02 // CAPABILITIES</span>
          </div>
          <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight">
            Six Core Engineering Divisions
          </h2>
        </div>
        <p class="text-slate-400 font-mono text-xs max-w-md">
          INTERACTIVE COCKPIT // HOVER OR TAP ANY DIVISION TO INSPECT REAL-TIME TECHNICAL SPECIFICATIONS & IMAGERY.
        </p>
      </div>

      <!-- Interactive Cockpit Component -->
      <ServiceCockpit />

    </div>
  </section>

  <!-- =========================================================================
       5. INDUSTRIES SECTION — WARM IVORY SURFACE WITH CLEAN 16:11 RATIOS
       ========================================================================= -->
  <section class="py-24 lg:py-32 bg-ivory-100 text-navy-950 border-b border-ivory-300 relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
      
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 pb-6 border-b border-ivory-300">
        <div class="space-y-3">
          <div class="inline-flex items-center gap-2 font-mono text-xs text-navy-900 font-bold tracking-widest uppercase">
            <span class="text-amber-dark">03 // SECTOR DEPLOYMENTS</span>
          </div>
          <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-extrabold text-navy-900 tracking-tight">
            Tailored Engineering for Demanding Sectors
          </h2>
        </div>
        <p class="text-slate-600 font-mono text-xs max-w-sm">
          MUSAFFAH, KIZAD, ICAD, ABU DHABI ISLAND & AL AIN OPERATING ENVIRONMENTS.
        </p>
      </div>

      <!-- Clean Editorial Industries Grid -->
      <IndustriesEditorial />

    </div>
  </section>

  <!-- =========================================================================
       6. PROJECTS PORTFOLIO — ASYMMETRICAL EDITORIAL COMPOSITION (NAVY)
       ========================================================================= -->
  <section class="py-24 lg:py-32 bg-navy-950 text-white border-b border-navy-800 relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
      
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 pb-6 border-b border-navy-800">
        <div class="space-y-3">
          <div class="inline-flex items-center gap-2 font-mono text-xs text-amber-brand font-bold tracking-widest uppercase">
            <span>04 // VERIFIED PORTFOLIO</span>
          </div>
          <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight">
            Selected Executed Works
          </h2>
        </div>
        <a 
          href="/projects" 
          class="font-mono text-xs text-amber-brand hover:text-white font-bold flex items-center gap-2 shrink-0"
        >
          <span>VIEW FULL PORTFOLIO (160+ PROJECTS)</span>
          <Icon name="arrow-right" class="w-3.5 h-3.5" />
        </a>
      </div>

      <!-- Asymmetrical Editorial Projects Component -->
      <ProjectsEditorial showFilters={true} />

    </div>
  </section>

  <!-- =========================================================================
       7. PROCESS SECTION — TECHNICAL BLUEPRINT METHODOLOGY (NAVY)
       ========================================================================= -->
  <section class="py-24 lg:py-32 bg-navy-900 text-white border-b border-navy-800 hud-grid relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
      
      <div class="text-center max-w-3xl mx-auto space-y-4">
        <div class="inline-flex items-center gap-2 font-mono text-xs text-amber-brand font-bold tracking-widest uppercase">
          <span>05 // METHODOLOGY</span>
        </div>
        <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight">
          A Disciplined 4-Stage Project Lifecycle
        </h2>
        <p class="text-slate-300 text-sm sm:text-base font-sans">
          From initial load estimation and single-line diagrams to ADDC meter energization and operational handover.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {WORK_PROCESS.map((stage) => (
          <div class="p-6 rounded-2xl bg-navy-950 border border-navy-800 flex flex-col justify-between space-y-6 hover:border-amber-brand/50 transition-colors">
            <div class="space-y-3">
              <span class="font-mono text-[10px] text-amber-brand font-bold tracking-wider block">
                {stage.phase}
              </span>
              <span class="font-display text-4xl font-extrabold text-slate-600 block">
                {stage.step}
              </span>
              <h3 class="font-display text-lg font-bold text-white leading-snug">
                {stage.title}
              </h3>
              <p class="font-sans text-xs text-slate-300 leading-relaxed">
                {stage.details}
              </p>
            </div>

            <div class="pt-3 border-t border-navy-800 font-mono text-[10px] text-slate-400 flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 rounded-full bg-amber-brand"></span>
              <span>CERTIFIED DELIVERABLE</span>
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- =========================================================================
       8. VERIFIED STATS & ACCREDITATIONS
       ========================================================================= -->
  <StatsSection variant="dark" />

  <!-- =========================================================================
       9. CONTACT & TENDER ESTIMATING DESK (BOLD DARK FINISH WITH AMBER)
       ========================================================================= -->
  <section class="py-24 lg:py-32 bg-navy-950 text-white relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
        
        <div class="lg:col-span-5 space-y-8">
          <div class="space-y-3">
            <div class="inline-flex items-center gap-2 font-mono text-xs text-amber-brand font-bold tracking-widest uppercase">
              <span>06 // INITIATE CONSULTATION</span>
            </div>
            <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-tight">
              Connect with Our Engineering Desk
            </h2>
          </div>

          <p class="font-sans text-sm sm:text-base text-slate-300 leading-relaxed">
            Our estimating engineers review project blueprints, single-line diagrams, and BOQs with strict commercial confidentiality.
          </p>

          <div class="space-y-4 font-mono text-xs text-slate-300 pt-2">
            <div class="p-4 rounded-xl bg-navy-900 border border-navy-800 flex items-center justify-between">
              <span>DIRECT TELEPHONE:</span>
              <a href="tel:025829700" class="text-amber-brand font-bold text-sm hover:underline">02-5829700</a>
            </div>
            <div class="p-4 rounded-xl bg-navy-900 border border-navy-800 flex items-center justify-between">
              <span>OFFICIAL EMAIL:</span>
              <a href="mailto:info@almanartech.com" class="text-white hover:text-amber-brand">info@almanartech.com</a>
            </div>
            <div class="p-4 rounded-xl bg-navy-900 border border-navy-800 flex items-center justify-between">
              <span>HEADQUARTERS:</span>
              <span class="text-slate-300">M35, Musaffah, Abu Dhabi</span>
            </div>
          </div>
        </div>

        <div class="lg:col-span-7">
          <ContactForm compact={false} />
        </div>

      </div>
    </div>
  </section>

  <!-- Interactive 3D tilt script for hero photo -->
  <script>
    const photoFrame = document.getElementById('hero-photo-frame');
    const photoWrapper = document.getElementById('hero-photo-wrapper');

    if (photoFrame && photoWrapper && window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
      photoWrapper.addEventListener('mousemove', (e) => {
        const rect = photoWrapper.getBoundingClientRect();
        const x = (e.clientX - rect.left) / rect.width - 0.5;
        const y = (e.clientY - rect.top) / rect.height - 0.5;
        photoFrame.style.transform = `perspective(1000px) rotateY(${x * 6}deg) rotateX(${-y * 6}deg) translateY(-4px)`;
      });

      photoWrapper.addEventListener('mouseleave', () => {
        photoFrame.style.transform = 'perspective(1000px) rotateY(0deg) rotateX(0deg) translateY(0px)';
      });
    }
  </script>

</Layout>
