---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import ProjectsEditorial from '../components/ProjectsEditorial.astro';
import MarqueeTicker from '../components/MarqueeTicker.astro';
import { COMPANY } from '../data/company';

const pageTitle = "Proven Engineering Portfolio | 160+ Landmark Projects Abu Dhabi | Al Manar Tech";
const pageDescription = "Explore Al Manar Tech's verified portfolio of electromechanical, HVAC, life safety fire alarms, and IT telecommunications contracts across commercial, hospitality, retail, and industrial sectors in Abu Dhabi and Al Ain.";
---

<Layout title={pageTitle} description={pageDescription}>

  <!-- =========================================================================
       SECTION 01 — PROJECTS COMMAND HERO (ANIMATED HUD & COPPER AMBIENCE)
       ========================================================================= -->
  <section class="relative bg-[#111920] text-white py-20 lg:py-28 overflow-hidden border-b border-[#252F38]">
    
    <!-- Background Animated Canvas (Ambient Orbs & Technical Grid) -->
    <div class="absolute inset-0 pointer-events-none select-none overflow-hidden">
      <!-- Animated Coordinate Grid -->
      <div 
        class="absolute inset-0 opacity-[0.07]"
        style="background-image: linear-gradient(to right, #FFFFFF 1px, transparent 1px), linear-gradient(to bottom, #FFFFFF 1px, transparent 1px); background-size: 70px 70px;"
      ></div>

      <!-- Glowing Copper Ambient Orbs -->
      <div 
        class="absolute -top-24 -right-24 w-96 h-96 rounded-full bg-[#F07842]/15 blur-3xl animate-pulse"
        style="animation-duration: 6s;"
      ></div>
      <div 
        class="absolute top-1/2 -left-24 w-80 h-80 rounded-full bg-[#F07842]/10 blur-3xl animate-pulse"
        style="animation-duration: 8s;"
      ></div>

      <!-- Technical Copper Wave Vectors -->
      <svg 
        class="absolute inset-0 w-full h-full opacity-30" 
        xmlns="http://www.w3.org/2000/svg"
      >
        <defs>
          <linearGradient id="prjCopperStreak" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#F07842" stop-opacity="0" />
            <stop offset="50%" stop-color="#F07842" stop-opacity="0.8" />
            <stop offset="100%" stop-color="#FFAB78" stop-opacity="0" />
          </linearGradient>
        </defs>
        <path 
          d="M 100 200 C 400 120, 700 350, 1200 180" 
          fill="none" 
          stroke="url(#prjCopperStreak)" 
          stroke-width="1.5" 
          stroke-dasharray="8 6"
        />
        <path 
          d="M 200 450 C 600 300, 900 500, 1400 380" 
          fill="none" 
          stroke="url(#prjCopperStreak)" 
          stroke-width="1" 
          opacity="0.6"
        />
      </svg>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="max-w-3xl space-y-6">
        <!-- Eyebrow Badge -->
        <div class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full bg-[#17232D] border border-[#F07842]/40 text-[#F07842] text-xs font-mono font-bold tracking-wider uppercase">
          <span class="w-2 h-2 rounded-full bg-[#F07842] animate-ping"></span>
          <span>Proven Execution • 160+ Contracts Delivered</span>
        </div>

        <!-- Authoritative Professional Headline -->
        <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-extrabold text-white tracking-tight leading-[1.08]">
          Proven Engineering Execution.<br/>
          <span class="text-metallic-amber">Mission-Critical Delivery Across the UAE.</span>
        </h1>

        <!-- Subtitle Narrative -->
        <p class="font-sans text-base sm:text-lg text-slate-300 leading-relaxed">
          Over two decades of verified electromechanical contracting, high-capacity HVAC climate engineering, certified life safety alarms, and optical telecommunications infrastructure across corporate, retail, leisure, and industrial sectors.
        </p>

        <!-- Authenticity & Quality Stamp -->
        <div class="pt-2 flex flex-wrap items-center gap-6 text-xs font-mono text-slate-300">
          <div class="flex items-center gap-2">
            <Icon name="shield-check" class="w-4 h-4 text-[#F07842] shrink-0" />
            <span>100% Authentic Documented UAE Projects</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-[#F07842] font-bold">✓</span>
            <span>ADDC &amp; UAE Civil Defence Compliant</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-[#F07842] font-bold">✓</span>
            <span>Zero-Defect Handover Track Record</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ENGINEERING DISCIPLINE TICKER -->
  <MarqueeTicker variant="amber" />

  <!-- =========================================================================
       SECTION 02 — INTERACTIVE PROJECT DIRECTORY & FILTER ENGINE
       ========================================================================= -->
  <section class="relative py-20 lg:py-28 bg-[#111920] text-white min-h-[700px] overflow-hidden">
    
    <!-- Subtle Animated Background Grid & Gradients -->
    <div class="absolute inset-0 pointer-events-none select-none">
      <div 
        class="absolute inset-0 opacity-[0.04]"
        style="background-image: linear-gradient(to right, #FFFFFF 1px, transparent 1px), linear-gradient(to bottom, #FFFFFF 1px, transparent 1px); background-size: 80px 80px;"
      ></div>
      <div 
        class="absolute top-1/4 right-0 w-[500px] h-[500px] rounded-full bg-[#F07842]/8 blur-3xl pointer-events-none"
      ></div>
      <div 
        class="absolute bottom-10 left-0 w-[400px] h-[400px] rounded-full bg-[#F07842]/5 blur-3xl pointer-events-none"
      ></div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12 relative z-10">
      
      <!-- Professional Section Heading (Replaced generic "Filter Projects" text) -->
      <div class="text-center max-w-3xl mx-auto space-y-3">
        <div class="inline-flex items-center gap-2 font-mono text-xs font-bold uppercase tracking-widest text-[#F07842] px-3 py-1 rounded-full bg-[#17232D] border border-[#F07842]/30">
          <span>Portfolio Directory • Sector Filter</span>
        </div>
        <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight">
          Engineered with Precision. <span class="text-metallic-amber">Proven in Operation.</span>
        </h2>
        <p class="text-slate-300 text-sm sm:text-base font-sans leading-relaxed">
          Select any sector below or search by client name to inspect our verified project delivery across Abu Dhabi and Al Ain.
        </p>
      </div>

      <!-- Complete Interactive Filterable Projects Grid -->
      <ProjectsEditorial showFilters={true} />

    </div>
  </section>

  <!-- =========================================================================
       SECTION 03 — CONTRACTOR PREQUALIFICATION DOSSIER CTA (WARM IVORY)
       ========================================================================= -->
  <section class="py-24 bg-ivory-100 text-navy-950 border-t border-ivory-300 shadow-2xl" style="background-color: #F4F1EA;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-[#17232D] rounded-3xl p-8 sm:p-12 lg:p-16 text-white border border-white/10 flex flex-col lg:flex-row items-center justify-between gap-10 shadow-2xl crosshair-corner">
        <div class="space-y-4 max-w-2xl">
          <div class="inline-flex items-center gap-2 font-mono text-xs font-bold uppercase tracking-widest text-[#F07842]">
            <span>Contractor Prequalification &amp; Tender Submissions</span>
          </div>
          <h3 class="font-display text-2xl sm:text-3xl lg:text-4xl font-extrabold text-white leading-tight">
            Need Our Verified Company Profile &amp; Licensure for Tenders?
          </h3>
          <p class="font-sans text-sm text-slate-300 leading-relaxed">
            We provide comprehensive prequalification dossiers including ADDC contractor approval, Abu Dhabi Municipality engineering license, ADQCC conformity, and complete project reference schedules for developers, consultants, and main contractors.
          </p>
          <div class="flex flex-wrap items-center gap-3 font-mono text-xs text-slate-300 pt-2">
            <span class="px-2.5 py-1 rounded bg-white/5 border border-white/10">• ADDC Registered Contractor</span>
            <span class="px-2.5 py-1 rounded bg-white/5 border border-white/10">• ADM Commercial Licensure</span>
            <span class="px-2.5 py-1 rounded bg-white/5 border border-white/10">• Comprehensive CAR Insurance</span>
          </div>
        </div>

        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 shrink-0 w-full sm:w-auto font-display">
          <a 
            href="/contact" 
            data-magnetic="true"
            class="inline-flex items-center justify-center px-8 py-4 rounded-xl text-xs font-bold uppercase tracking-wider bg-[#F07842] text-[#111920] hover:bg-[#D96532] shadow-lg shadow-[#F07842]/25 transition-all"
          >
            <span>Request Prequalification Dossier</span>
            <Icon name="arrow-right" class="w-4 h-4 ml-2" />
          </a>
        </div>
      </div>
    </div>
  </section>

</Layout>
