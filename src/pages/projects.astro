---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import ProjectsEditorial from '../components/ProjectsEditorial.astro';
import MarqueeTicker from '../components/MarqueeTicker.astro';
import { COMPANY } from '../data/company';

const pageTitle = "Executed Project Portfolio | Verified MEP & Contracting Works Abu Dhabi";
const pageDescription = "View verified commercial, retail, hospitality, institutional, and industrial engineering projects completed by Al Manar Tech across Abu Dhabi and the UAE.";
---

<Layout title={pageTitle} description={pageDescription}>

  <!-- Projects Hero -->
  <section class="bg-navy-950 text-white py-16 lg:py-24 hud-grid relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="max-w-3xl space-y-4">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-navy-900 border border-amber-brand/40 text-amber-brand text-xs font-mono">
          <span>04 // CONTRACTING PORTFOLIO</span>
        </div>
        <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-extrabold text-white tracking-tight">
          Executed Engineering & Infrastructure Works
        </h1>
        <p class="font-sans text-base sm:text-lg text-slate-300 leading-relaxed">
          Al Manar Tech has successfully completed over 160 technical and electromechanical contracting projects in Abu Dhabi. Explore our verified portfolio across corporate, retail, leisure, and industrial sectors.
        </p>

        <!-- Transparency Note -->
        <div class="pt-4 flex items-center gap-3 text-xs font-mono text-slate-400">
          <Icon name="shield-check" class="w-4 h-4 text-amber-brand shrink-0" />
          <span>All portfolio items represent authentic, company-verified project execution in the UAE.</span>
        </div>
      </div>
    </div>
  </section>

  <MarqueeTicker variant="navy" />

  <!-- Interactive Project Gallery Section (Navy) -->
  <section class="py-24 bg-navy-950 text-white min-h-[600px]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      <div class="text-center max-w-2xl mx-auto space-y-3">
        <span class="font-mono text-xs font-bold uppercase tracking-widest text-amber-brand">
          VERIFIED INSTALLATIONS // 160+ PROJECTS
        </span>
        <h2 class="font-display text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
          Filter Projects by Operating Sector
        </h2>
        <p class="text-slate-400 text-sm font-sans">
          Browse through completed electromechanical, HVAC, and low-current installations across Abu Dhabi and Al Ain.
        </p>
      </div>

      <ProjectsEditorial showFilters={true} />

    </div>
  </section>

  <!-- Prequalification CTA (Warm Ivory) -->
  <section class="py-24 bg-ivory-100 text-navy-950 border-t border-ivory-300">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-navy-900 rounded-3xl p-8 sm:p-12 lg:p-16 text-white border border-navy-800 flex flex-col lg:flex-row items-center justify-between gap-10 shadow-editorial crosshair-corner">
        <div class="space-y-4 max-w-2xl">
          <span class="font-mono text-xs font-bold uppercase tracking-widest text-amber-brand">
            CONTRACTOR PREQUALIFICATION
          </span>
          <h3 class="font-display text-2xl sm:text-3xl font-extrabold text-white">
            Need Our Company Profile & Trade Licensure for Tenders?
          </h3>
          <p class="font-sans text-sm text-slate-300 leading-relaxed">
            We provide comprehensive pre-qualification dossiers including our ADDC contractor registration, ADM trade license, insurance coverage, and audited project lists for developer and main contractor evaluation.
          </p>
          <div class="flex flex-wrap items-center gap-4 font-mono text-xs text-slate-400 pt-2">
            <span>• ADDC License</span>
            <span>• Municipality Trade License</span>
            <span>• Workmen Compensation & CAR Insurance</span>
          </div>
        </div>

        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 shrink-0 w-full sm:w-auto font-display">
          <a 
            href="/contact" 
            data-magnetic="true"
            class="inline-flex items-center justify-center px-8 py-4 rounded-xl text-xs font-bold uppercase tracking-wider bg-amber-brand text-navy-950 hover:bg-amber-glow shadow-amber-glow transition-colors"
          >
            <span>Request Prequalification Dossier</span>
            <Icon name="arrow-right" class="w-4 h-4 ml-2" />
          </a>
        </div>
      </div>
    </div>
  </section>

</Layout>
