---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import MarqueeTicker from '../components/MarqueeTicker.astro';
import { WORK_PROCESS } from '../data/company';

const pageTitle = "Our Engineering Delivery Process | ADDC Approved Workflow Abu Dhabi";
const pageDescription = "Learn how Al Manar Tech delivers electromechanical and MEP projects in Abu Dhabi through a structured 4-stage process ensuring regulatory compliance, safety, and punctuality.";

const processFaqs = [
  {
    question: "How long does ADDC electrical drawing approval typically take?",
    answer: "Drawing submission and review timelines vary depending on electrical load capacity and substation availability. For standard low-voltage commercial fit-outs, ADDC review generally takes 7 to 14 working days once all single-line diagrams (SLD) and load schedules are submitted in order."
  },
  {
    question: "How does Al Manar Tech ensure on-site health, safety, and environmental (HSE) standards?",
    answer: "All technicians and project engineers operate under strict HSE guidelines. We conduct mandatory daily toolbox talks, enforce certified Personal Protective Equipment (PPE), adhere to lockout-tagout (LOTO) protocols for energized systems, and maintain active contractor all-risk (CAR) insurance."
  },
  {
    question: "Do you coordinate with main contractors and interior design consultants?",
    answer: "Yes. Our project managers participate in weekly progress meetings, resolve MEP-architectural clash detections via coordinated shop drawings, and align our conduit, ducting, and cabling schedules with false ceiling and floor finish timelines."
  },
  {
    question: "What documentation is provided upon project handover?",
    answer: "Every completed project includes a comprehensive handover binder containing: approved As-Built drawings, ADDC inspection test certificates, Fluke network cabling test sheets, TAB air and water balancing logs, equipment warranty certificates, and Operation & Maintenance (O&M) manuals."
  }
];
---

<Layout title={pageTitle} description={pageDescription}>

  <!-- Process Hero -->
  <section class="bg-navy-950 text-white py-16 lg:py-24 hud-grid relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="max-w-3xl space-y-4">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-navy-900 border border-amber-brand/40 text-amber-brand text-xs font-mono">
          <span>05 // METHODOLOGY</span>
        </div>
        <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-extrabold text-white tracking-tight">
          A Disciplined 4-Stage Approach to Infrastructure Execution
        </h1>
        <p class="font-sans text-base sm:text-lg text-slate-300 leading-relaxed">
          Electromechanical installations succeed or fail on the rigor of their engineering workflow. Al Manar Tech follows a systematic milestone lifecycle designed to eliminate delays, prevent rework, and secure authority approvals efficiently.
        </p>
      </div>
    </div>
  </section>

  <MarqueeTicker variant="navy" />

  <!-- Detailed 4-Step Process Section with Animated Timeline Beam (Navy Surface) -->
  <section id="process-timeline-section" class="py-24 bg-navy-950 text-white border-b border-navy-800 hud-grid relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16 relative z-10">
      
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 pb-6 border-b border-white/5">
        <div class="space-y-3">
          <span class="font-mono text-xs text-amber-brand font-bold tracking-widest uppercase">
            CHRONOLOGICAL EXECUTION PIPELINE
          </span>
          <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight">
            From Blueprint Submittal to <span class="text-metallic-amber">Authority Energization</span>
          </h2>
        </div>
        <div class="font-mono text-xs text-slate-400">
          <span>AVERAGE CYCLE: MILESTONE-DRIVEN ACCORDING TO PROJECT SCALE</span>
        </div>
      </div>

      <div class="relative pl-8 sm:pl-12 space-y-12">
        <!-- Glowing Amber Laser Beam Track -->
        <div class="timeline-laser-track hidden sm:block">
          <div id="timeline-laser-beam" class="timeline-laser-beam"></div>
        </div>
        
        {WORK_PROCESS.map((stage, idx) => (
          <div class={`timeline-stage-card scroll-reveal-up stagger-${idx + 1} glass-panel-navy rounded-3xl p-8 sm:p-12 border border-white/10 shadow-glass-navy relative crosshair-corner`}>
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
              
              <div class="lg:col-span-3 flex lg:flex-col items-center lg:items-start justify-between">
                <span class="font-display text-6xl sm:text-7xl font-extrabold text-white/20 leading-none">
                  {stage.step}
                </span>
                <div class="inline-block px-3 py-1.5 rounded-lg glass-panel-amber text-amber-brand font-mono text-[11px] font-bold uppercase tracking-wider mt-2 border border-amber-brand/40">
                  {stage.phase}
                </div>
              </div>

              <div class="lg:col-span-9 space-y-4 font-sans">
                <h3 class="font-display text-2xl sm:text-3xl font-extrabold text-white">
                  {stage.title}
                </h3>
                <p class="font-mono text-xs font-semibold text-amber-brand bg-amber-brand/10 px-3.5 py-1.5 rounded-lg border border-amber-brand/20 inline-block">
                  {stage.summary}
                </p>
                <p class="text-sm sm:text-base text-slate-300 leading-relaxed">
                  {stage.details}
                </p>

                <!-- Stage Key Milestones -->
                <div class="pt-4 border-t border-white/10">
                  <span class="font-mono text-xs font-bold uppercase tracking-wider text-white block mb-2">
                    Key Deliverables for This Stage:
                  </span>
                  <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs font-sans text-slate-300">
                  {idx === 0 && (
                    <>
                      <div class="flex items-center gap-2"><Icon name="check-circle" class="w-4 h-4 text-emerald-600" /><span>Site condition survey & existing services audit</span></div>
                      <div class="flex items-center gap-2"><Icon name="check-circle" class="w-4 h-4 text-emerald-600" /><span>Electrical load demand calculation (kVA/kW)</span></div>
                      <div class="flex items-center gap-2"><Icon name="check-circle" class="w-4 h-4 text-emerald-600" /><span>HVAC heat load estimation (BTU/TR)</span></div>
                      <div class="flex items-center gap-2"><Icon name="check-circle" class="w-4 h-4 text-emerald-600" /><span>Detailed commercial quotation & timeline outline</span></div>
                    </>
                  )}
                  {idx === 1 && (
                    <>
                      <div class="flex items-center gap-2"><Icon name="check-circle" class="w-4 h-4 text-emerald-600" /><span>Single-Line Diagrams (SLD) & DB Schedules</span></div>
                      <div class="flex items-center gap-2"><Icon name="check-circle" class="w-4 h-4 text-emerald-600" /><span>ADDC official drawing submission & tracking</span></div>
                      <div class="flex items-center gap-2"><Icon name="check-circle" class="w-4 h-4 text-emerald-600" /><span>Material submittals & ADQCC compliance verification</span></div>
                      <div class="flex items-center gap-2"><Icon name="check-circle" class="w-4 h-4 text-emerald-600" /><span>Civil Defence fire alarm cause-and-effect matrix</span></div>
                    </>
                  )}
                  {idx === 2 && (
                    <>
                      <div class="flex items-center gap-2"><Icon name="check-circle" class="w-4 h-4 text-emerald-600" /><span>Certified on-site engineering supervision</span></div>
                      <div class="flex items-center gap-2"><Icon name="check-circle" class="w-4 h-4 text-emerald-600" /><span>Conduit, tray, duct, and pipe pressure containment</span></div>
                      <div class="flex items-center gap-2"><Icon name="check-circle" class="w-4 h-4 text-emerald-600" /><span>Weekly coordination meetings & milestone tracking</span></div>
                      <div class="flex items-center gap-2"><Icon name="check-circle" class="w-4 h-4 text-emerald-600" /><span>Full adherence to UAE safety & EHS regulations</span></div>
                    </>
                  )}
                  {idx === 3 && (
                    <>
                      <div class="flex items-center gap-2"><Icon name="check-circle" class="w-4 h-4 text-emerald-600" /><span>Megger insulation resistance & continuity testing</span></div>
                      <div class="flex items-center gap-2"><Icon name="check-circle" class="w-4 h-4 text-emerald-600" /><span>TAB air flow balancing and chiller water delta-T checks</span></div>
                      <div class="flex items-center gap-2"><Icon name="check-circle" class="w-4 h-4 text-emerald-600" /><span>Official ADDC meter energization inspection sign-off</span></div>
                      <div class="flex items-center gap-2"><Icon name="check-circle" class="w-4 h-4 text-emerald-600" /><span>As-Built drawings, O&M manuals & warranty handover</span></div>
                    </>
                  )}
                </div>
              </div>
            </div>

          </div>
        </div>
      ))}

      </div>
    </div>
  </section>

  <!-- Process FAQs (Navy) -->
  <section class="py-24 bg-navy-950 text-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
      <div class="text-center space-y-3">
        <span class="font-mono text-xs font-bold uppercase tracking-widest text-amber-brand">
          FAQ // EXECUTION TIMELINES
        </span>
        <h2 class="font-display text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
          Frequently Asked Questions
        </h2>
        <p class="font-sans text-slate-300 text-sm">
          Everything you need to know about initiating an engineering project with Al Manar Tech.
        </p>
      </div>

      <FaqAccordion faqs={processFaqs} />
    </div>
  </section>

</Layout>
