---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import ContactForm from '../components/ContactForm.astro';
import { COMPANY } from '../data/company';

const pageTitle = "Contact Us | Engineering & Estimating Desk Abu Dhabi";
const pageDescription = "Contact Al Manar Tech in Musaffah M35, Abu Dhabi. Call 02-5829700 or submit your project drawings and specifications for an ADDC-compliant MEP tender review.";
---

<Layout title={pageTitle} description={pageDescription}>

  <!-- Contact Hero -->
  <section class="bg-navy-950 text-white py-16 lg:py-24 engineering-grid-dark relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="max-w-3xl space-y-4">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded bg-navy-800 border border-gold-500/40 text-gold-400 text-xs font-semibold">
          <Icon name="phone" class="w-4 h-4 text-gold-500" />
          <span>Engineering Estimating Desk</span>
        </div>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold font-heading text-white tracking-tight">
          Discuss Your Project with Our Technical Team
        </h1>
        <p class="text-base sm:text-lg text-slate-300 leading-relaxed">
          Whether you require a comprehensive electromechanical contracting tender, authority drawing submission, emergency facility servicing, or structured cabling, our engineers in Abu Dhabi are ready to assist.
        </p>
      </div>
    </div>
  </section>

  <!-- Main Contact Section: Details + Form -->
  <section class="py-20 bg-cloud-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
        
        <!-- Left Column: Official Contact Channels (5 cols) -->
        <div class="lg:col-span-5 space-y-8">
          
          <div class="bg-white rounded-3xl p-8 border border-cloud-200 shadow-premium space-y-6">
            <h2 class="text-2xl font-bold text-navy-900 font-heading">
              Abu Dhabi Head Office
            </h2>

            <div class="space-y-5 text-sm">
              <!-- Address -->
              <div class="flex items-start gap-4">
                <div class="w-10 h-10 rounded-xl bg-navy-900 text-gold-500 flex items-center justify-center shrink-0 mt-0.5">
                  <Icon name="map-pin" class="w-5 h-5" />
                </div>
                <div>
                  <span class="text-xs font-bold uppercase tracking-wider text-slate-400 block mb-1">Office Location</span>
                  <p class="text-navy-900 font-medium leading-relaxed">
                    Warehouse 2, Al Afou 3St, Musaffah M35,<br/>Abu Dhabi, United Arab Emirates
                  </p>
                </div>
              </div>

              <!-- Phone -->
              <div class="flex items-start gap-4">
                <div class="w-10 h-10 rounded-xl bg-navy-900 text-gold-500 flex items-center justify-center shrink-0 mt-0.5">
                  <Icon name="phone" class="w-5 h-5" />
                </div>
                <div>
                  <span class="text-xs font-bold uppercase tracking-wider text-slate-400 block mb-1">Telephone</span>
                  <a href="tel:025829700" class="text-lg font-bold text-navy-900 hover:text-gold-600 transition-colors block">
                    02-5829700
                  </a>
                  <span class="text-xs text-slate-500">Direct engineering line</span>
                </div>
              </div>

              <!-- Email -->
              <div class="flex items-start gap-4">
                <div class="w-10 h-10 rounded-xl bg-navy-900 text-gold-500 flex items-center justify-center shrink-0 mt-0.5">
                  <Icon name="mail" class="w-5 h-5" />
                </div>
                <div>
                  <span class="text-xs font-bold uppercase tracking-wider text-slate-400 block mb-1">Official Email</span>
                  <a href="mailto:info@almanartech.com" class="text-base font-semibold text-navy-900 hover:text-gold-600 transition-colors block">
                    info@almanartech.com
                  </a>
                  <span class="text-xs text-slate-500">Tender submittals & general inquiries</span>
                </div>
              </div>

              <!-- Hours -->
              <div class="flex items-start gap-4">
                <div class="w-10 h-10 rounded-xl bg-navy-900 text-gold-500 flex items-center justify-center shrink-0 mt-0.5">
                  <Icon name="clock" class="w-5 h-5" />
                </div>
                <div>
                  <span class="text-xs font-bold uppercase tracking-wider text-slate-400 block mb-1">Business Hours</span>
                  <p class="text-navy-900 font-medium">
                    Monday – Saturday: 09:00 – 18:00
                  </p>
                  <p class="text-xs text-slate-500">
                    Sunday: Closed (Emergency breakdown teams on call)
                  </p>
                </div>
              </div>
            </div>

            <!-- Licensing Badges -->
            <div class="pt-6 border-t border-cloud-100 space-y-2">
              <span class="text-xs font-bold uppercase tracking-wider text-slate-400 block">
                Official Certifications
              </span>
              <div class="flex flex-wrap gap-2 text-xs">
                <span class="px-2.5 py-1 rounded bg-cloud-100 text-navy-900 font-medium">ADDC Approved</span>
                <span class="px-2.5 py-1 rounded bg-cloud-100 text-navy-900 font-medium">ADM Registered</span>
                <span class="px-2.5 py-1 rounded bg-cloud-100 text-navy-900 font-medium">ADQCC Aligned</span>
              </div>
            </div>

          </div>

          <!-- Emergency Support Banner -->
          <div class="bg-navy-950 text-white rounded-3xl p-6 border border-navy-800 space-y-3">
            <div class="flex items-center gap-2 text-gold-500 text-xs font-bold uppercase tracking-wider">
              <Icon name="shield-alert" class="w-4 h-4" />
              <span>Contract Emergency Support</span>
            </div>
            <h3 class="text-base font-bold font-heading text-white">
              Annual Maintenance Clients
            </h3>
            <p class="text-xs text-slate-300 leading-relaxed">
              Clients with active Annual Maintenance Contracts (AMC) have 24/7 dedicated telephone access to our rapid response technicians in Musaffah for emergency power, chiller, or fire alarm tripping.
            </p>
          </div>

        </div>

        <!-- Right Column: Interactive Form (7 cols) -->
        <div class="lg:col-span-7">
          <ContactForm compact={false} />
        </div>

      </div>
    </div>
  </section>

  <!-- Interactive Map / Location Context -->
  <section class="py-16 bg-white border-t border-cloud-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-gold-600 block mb-1">
            Site Location
          </span>
          <h2 class="text-2xl font-bold text-navy-900 font-heading">
            Conveniently Located in Musaffah Industrial Zone
          </h2>
        </div>
        <a 
          href="https://maps.google.com/?q=Musaffah+M35+Abu+Dhabi" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="inline-flex items-center gap-2 text-xs font-bold text-navy-900 hover:text-gold-600 bg-cloud-100 px-4 py-2.5 rounded-lg border border-cloud-300"
        >
          <Icon name="map-pin" class="w-4 h-4 text-gold-600" />
          <span>Open in Google Maps</span>
        </a>
      </div>

      <!-- Map Presentation Container -->
      <div class="rounded-2xl border border-cloud-300 bg-cloud-100 p-8 text-center space-y-4">
        <div class="w-12 h-12 rounded-full bg-navy-900 text-gold-500 mx-auto flex items-center justify-center">
          <Icon name="map-pin" class="w-6 h-6" />
        </div>
        <div class="max-w-lg mx-auto space-y-1">
          <h3 class="text-lg font-bold text-navy-900 font-heading">Al Manar Technical Contracting</h3>
          <p class="text-sm text-slate-600">Warehouse 2, Al Afou 3St, Musaffah M35, Abu Dhabi, UAE</p>
          <p class="text-xs text-slate-500 pt-2">
            Minutes from main transport arteries connecting Abu Dhabi Island, Mohammed Bin Zayed City, ICAD, and the Abu Dhabi–Dubai E11 Highway.
          </p>
        </div>
      </div>
    </div>
  </section>

</Layout>
