---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import ContactForm from '../components/ContactForm.astro';
import MarqueeTicker from '../components/MarqueeTicker.astro';
import { COMPANY } from '../data/company';

const pageTitle = "Contact Us | Engineering & Estimating Desk Abu Dhabi";
const pageDescription = "Contact Al Manar Tech in Musaffah M35, Abu Dhabi. Call 02-5829700 or submit your project drawings and specifications for an ADDC-compliant MEP tender review.";
---

<Layout title={pageTitle} description={pageDescription}>

  <!-- Contact Hero -->
  <section class="bg-navy-950 text-white py-16 lg:py-24 hud-grid relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="max-w-3xl space-y-4">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-navy-900 border border-amber-brand/40 text-amber-brand text-xs font-mono">
          <span>06 // INITIATE CONSULTATION</span>
        </div>
        <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-extrabold text-white tracking-tight">
          Discuss Your Project with Our Technical Estimating Team
        </h1>
        <p class="font-sans text-base sm:text-lg text-slate-300 leading-relaxed">
          Whether you require a comprehensive electromechanical contracting tender, authority drawing submission, emergency facility servicing, or structured cabling, our engineers in Abu Dhabi are ready to assist.
        </p>
      </div>
    </div>
  </section>

  <MarqueeTicker variant="navy" />

  <!-- Main Contact Section (Warm Ivory background with Dark Forms) -->
  <section class="py-24 bg-ivory-100 text-navy-950 border-b border-ivory-300 hud-grid-ivory">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
        
        <!-- Left Column: Official Contact Channels (5 cols) -->
        <div class="lg:col-span-5 space-y-8">
          
          <div class="bg-white rounded-3xl p-8 border border-ivory-300 shadow-editorial space-y-6">
            <h2 class="font-display text-2xl font-extrabold text-navy-900">
              Abu Dhabi Head Office
            </h2>

            <div class="space-y-5 text-sm font-sans">
              <!-- Address -->
              <div class="flex items-start gap-4">
                <div class="w-10 h-10 rounded-xl bg-navy-950 text-amber-brand flex items-center justify-center shrink-0 mt-0.5">
                  <Icon name="map-pin" class="w-5 h-5" />
                </div>
                <div>
                  <span class="font-mono text-xs font-bold uppercase tracking-wider text-slate-400 block mb-1">Office Location</span>
                  <p class="text-navy-900 font-medium leading-relaxed">
                    Warehouse 2, Al Afou 3St, Musaffah M35,<br/>Abu Dhabi, United Arab Emirates
                  </p>
                </div>
              </div>

              <!-- Phone -->
              <div class="flex items-start gap-4">
                <div class="w-10 h-10 rounded-xl bg-navy-950 text-amber-brand flex items-center justify-center shrink-0 mt-0.5">
                  <Icon name="phone" class="w-5 h-5" />
                </div>
                <div>
                  <span class="font-mono text-xs font-bold uppercase tracking-wider text-slate-400 block mb-1">Telephone</span>
                  <a href="tel:025829700" class="font-display text-lg font-bold text-navy-900 hover:text-amber-dark transition-colors block">
                    02-5829700
                  </a>
                  <span class="font-mono text-xs text-slate-500">Direct engineering line</span>
                </div>
              </div>

              <!-- Email -->
              <div class="flex items-start gap-4">
                <div class="w-10 h-10 rounded-xl bg-navy-950 text-amber-brand flex items-center justify-center shrink-0 mt-0.5">
                  <Icon name="mail" class="w-5 h-5" />
                </div>
                <div>
                  <span class="font-mono text-xs font-bold uppercase tracking-wider text-slate-400 block mb-1">Official Email</span>
                  <a href="mailto:info@almanartech.com" class="font-sans text-base font-semibold text-navy-900 hover:text-amber-dark transition-colors block">
                    info@almanartech.com
                  </a>
                  <span class="font-mono text-xs text-slate-500">Tender submittals & inquiries</span>
                </div>
              </div>

              <!-- Hours -->
              <div class="flex items-start gap-4">
                <div class="w-10 h-10 rounded-xl bg-navy-950 text-amber-brand flex items-center justify-center shrink-0 mt-0.5">
                  <Icon name="clock" class="w-5 h-5" />
                </div>
                <div>
                  <span class="font-mono text-xs font-bold uppercase tracking-wider text-slate-400 block mb-1">Business Hours</span>
                  <p class="text-navy-900 font-medium">
                    Monday – Saturday: 09:00 – 18:00
                  </p>
                  <p class="font-mono text-xs text-slate-500">
                    Sunday: Closed (Emergency breakdown on call)
                  </p>
                </div>
              </div>
            </div>

            <!-- Licensing Badges -->
            <div class="pt-6 border-t border-ivory-300 space-y-2 font-mono text-xs">
              <span class="font-bold uppercase tracking-wider text-slate-500 block">
                OFFICIAL CERTIFICATIONS:
              </span>
              <div class="flex flex-wrap gap-2 text-[11px]">
                <span class="px-2.5 py-1 rounded bg-ivory-100 border border-ivory-300 text-navy-900 font-medium">ADDC Approved</span>
                <span class="px-2.5 py-1 rounded bg-ivory-100 border border-ivory-300 text-navy-900 font-medium">ADM Registered</span>
                <span class="px-2.5 py-1 rounded bg-ivory-100 border border-ivory-300 text-navy-900 font-medium">ADQCC Aligned</span>
              </div>
            </div>

          </div>

          <!-- Emergency Support Banner -->
          <div class="bg-navy-950 text-white rounded-3xl p-6 border border-navy-800 space-y-3 shadow-card-dark">
            <div class="flex items-center gap-2 text-amber-brand font-mono text-xs font-bold uppercase tracking-wider">
              <Icon name="shield-alert" class="w-4 h-4" />
              <span>Contract Emergency Support</span>
            </div>
            <h3 class="font-display text-base font-bold text-white">
              Annual Maintenance Contract (AMC) Clients
            </h3>
            <p class="font-sans text-xs text-slate-300 leading-relaxed">
              Clients with active Annual Maintenance Contracts have 24/7 dedicated telephone access to our rapid response technicians in Musaffah for emergency power, chiller, or fire alarm tripping.
            </p>
          </div>

        </div>

        <!-- Right Column: Interactive Form (7 cols) -->
        <div class="lg:col-span-7">
          <ContactForm compact={false} />
        </div>

      </div>
    </div>
  </section>

</Layout>
