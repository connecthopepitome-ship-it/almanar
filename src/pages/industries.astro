---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import MarqueeTicker from '../components/MarqueeTicker.astro';
import { INDUSTRIES } from '../data/company';

const pageTitle = "Industries Served | Industrial, Commercial & Healthcare MEP Abu Dhabi";
const pageDescription = "Discover how Al Manar Tech engineers electromechanical, HVAC, fire detection, and IT telecom solutions tailored for industrial facilities, corporate offices, retail, and healthcare across Abu Dhabi.";
---

<Layout title={pageTitle} description={pageDescription}>

  <!-- Industries Hero -->
  <section class="bg-navy-950 text-white py-16 lg:py-24 hud-grid relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="max-w-3xl space-y-4">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-navy-900 border border-amber-brand/40 text-amber-brand text-xs font-mono">
          <span>Sector Specialization</span>
        </div>
        <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-extrabold text-white tracking-tight">
          Specialized Engineering for Demanding Operating Environments
        </h1>
        <p class="font-sans text-base sm:text-lg text-slate-300 leading-relaxed">
          From heavy industrial manufacturing plants in Musaffah to prestigious corporate headquarters, sports venues, and sterile healthcare clinics, Al Manar Tech engineers systems designed around specific sector realities.
        </p>
      </div>
    </div>
  </section>

  <MarqueeTicker variant="navy" />

  <!-- Detailed Industries List (Warm Ivory) -->
  <section class="py-24 bg-ivory-100 text-navy-950 border-b border-ivory-300 hud-grid-ivory">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
      
      {INDUSTRIES.map((ind, idx) => (
        <div id={ind.id} class="bg-white rounded-3xl border border-ivory-300 shadow-editorial overflow-hidden transition-all hover:border-amber-dark/40">
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
            
            <!-- Left Info (7 cols) -->
            <div class={`p-8 lg:p-12 lg:col-span-7 space-y-6 ${idx % 2 === 1 ? 'lg:order-2' : ''}`}>
              <div>
                <span class="font-mono text-xs font-bold uppercase tracking-widest text-amber-dark">
                  Sector {ind.number} • Abu Dhabi &amp; Al Ain
                </span>
                <h2 class="font-display text-2xl sm:text-3xl font-extrabold text-navy-900 mt-1">
                  {ind.name}
                </h2>
                <p class="font-sans text-xs font-semibold text-slate-500 mt-1">
                  {ind.tagline}
                </p>
              </div>

              <p class="font-sans text-sm sm:text-base text-slate-700 leading-relaxed">
                {ind.description}
              </p>

              <!-- Challenges vs Solutions Grid -->
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2 font-sans">
                <div class="p-4 rounded-xl bg-red-50/50 border border-red-100 space-y-2">
                  <span class="font-mono text-xs font-bold uppercase tracking-wider text-red-900 block">
                    Operating Challenges:
                  </span>
                  <ul class="space-y-1.5 text-xs text-slate-700">
                    {ind.challenges.map((c) => (
                      <li class="flex items-start gap-1.5">
                        <span class="text-red-500 font-bold shrink-0">•</span>
                        <span>{c}</span>
                      </li>
                    ))}
                  </ul>
                </div>

                <div class="p-4 rounded-xl bg-emerald-50/50 border border-emerald-100 space-y-2">
                  <span class="font-mono text-xs font-bold uppercase tracking-wider text-emerald-900 block">
                    Al Manar Tech Solutions:
                  </span>
                  <ul class="space-y-1.5 text-xs text-slate-700">
                    {ind.solutions.map((s) => (
                      <li class="flex items-start gap-1.5">
                        <Icon name="check" class="w-3.5 h-3.5 text-emerald-600 shrink-0 mt-0.5" />
                        <span>{s}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>

              <!-- Associated Services Tags -->
              <div class="pt-4 border-t border-ivory-300 flex flex-wrap items-center justify-between gap-4 font-mono text-xs">
                <div class="flex flex-wrap items-center gap-2">
                  <span class="font-bold text-navy-900">Services Deployed:</span>
                  {ind.servicesOffered.map((svc) => (
                    <span class="px-2.5 py-1 rounded bg-ivory-100 text-navy-900 font-medium border border-ivory-300">
                      {svc}
                    </span>
                  ))}
                </div>

                <a href="/contact" class="inline-flex items-center gap-1.5 font-bold text-amber-dark hover:underline">
                  <span>Inquire for {ind.name}</span>
                  <Icon name="arrow-right" class="w-3.5 h-3.5" />
                </a>
              </div>
            </div>

            <!-- Right Image (5 cols) with consistent 16:11 Aspect Ratio -->
            <div class={`lg:col-span-5 h-full min-h-[300px] lg:min-h-[440px] relative bg-navy-950 ${idx % 2 === 1 ? 'lg:order-1' : ''}`} data-cursor="view">
              <img 
                src={ind.image} 
                alt={`${ind.name} - Al Manar Tech Project`}
                class="w-full h-full object-cover"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-navy-950/80 via-transparent to-transparent"></div>
              <div class="absolute bottom-6 left-6 right-6 text-white text-xs font-mono">
                <span class="px-2.5 py-1 rounded bg-navy-950/90 text-amber-brand font-bold backdrop-blur-sm border border-navy-800">
                  Sector {ind.number}
                </span>
              </div>
            </div>

          </div>
        </div>
      ))}

    </div>
  </section>

</Layout>
