---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { INDUSTRIES } from '../data/company';

const pageTitle = "Industries Served | Industrial, Commercial & Healthcare MEP Abu Dhabi";
const pageDescription = "Discover how Al Manar Tech engineers electromechanical, HVAC, fire detection, and IT telecom solutions tailored for industrial facilities, corporate offices, retail, and healthcare across Abu Dhabi.";
---

<Layout title={pageTitle} description={pageDescription}>

  <!-- Industries Hero -->
  <section class="bg-navy-950 text-white py-16 lg:py-24 engineering-grid-dark relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="max-w-3xl space-y-4">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded bg-navy-800 border border-gold-500/40 text-gold-400 text-xs font-semibold">
          <Icon name="factory" class="w-4 h-4 text-gold-500" />
          <span>Sector Specialization</span>
        </div>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold font-heading text-white tracking-tight">
          Specialized Engineering for Demanding Operating Environments
        </h1>
        <p class="text-base sm:text-lg text-slate-300 leading-relaxed">
          From heavy industrial manufacturing plants in Musaffah to prestigious corporate headquarters and sterile healthcare clinics, Al Manar Tech engineers systems designed around specific sector realities.
        </p>
      </div>
    </div>
  </section>

  <!-- Detailed Industries List -->
  <section class="py-20 bg-cloud-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
      
      {INDUSTRIES.map((ind, idx) => (
        <div id={ind.id} class="bg-white rounded-3xl border border-cloud-200 shadow-premium overflow-hidden transition-all hover:shadow-premium-lg">
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
            
            <!-- Left Info (7 cols) -->
            <div class={`p-8 lg:p-12 lg:col-span-7 space-y-6 ${idx % 2 === 1 ? 'lg:order-2' : ''}`}>
              <div>
                <span class="text-xs font-bold uppercase tracking-wider text-gold-600">
                  Sector 0{idx + 1}
                </span>
                <h2 class="text-2xl sm:text-3xl font-extrabold text-navy-900 font-heading">
                  {ind.name}
                </h2>
                <p class="text-xs font-semibold text-slate-500 mt-1">
                  {ind.tagline}
                </p>
              </div>

              <p class="text-sm sm:text-base text-slate-custom leading-relaxed">
                {ind.description}
              </p>

              <!-- Challenges vs Solutions Grid -->
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
                <div class="p-4 rounded-xl bg-red-50/50 border border-red-100 space-y-2">
                  <span class="text-xs font-bold uppercase tracking-wider text-red-900 block">
                    Operating Challenges:
                  </span>
                  <ul class="space-y-1.5 text-xs text-slate-700">
                    {ind.challenges.map((c) => (
                      <li class="flex items-start gap-1.5">
                        <span class="text-red-500 font-bold shrink-0">•</span>
                        <span>{c}</span>
                      </li>
                    ))}
                  </ul>
                </div>

                <div class="p-4 rounded-xl bg-emerald-50/50 border border-emerald-100 space-y-2">
                  <span class="text-xs font-bold uppercase tracking-wider text-emerald-900 block">
                    Al Manar Tech Solutions:
                  </span>
                  <ul class="space-y-1.5 text-xs text-slate-700">
                    {ind.solutions.map((s) => (
                      <li class="flex items-start gap-1.5">
                        <Icon name="check" class="w-3.5 h-3.5 text-emerald-600 shrink-0 mt-0.5" />
                        <span>{s}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>

              <!-- Associated Services Tags -->
              <div class="pt-4 border-t border-cloud-100 flex flex-wrap items-center justify-between gap-4">
                <div class="flex flex-wrap items-center gap-2">
                  <span class="text-xs font-bold text-navy-900">Services Deployed:</span>
                  {ind.servicesOffered.map((svc) => (
                    <span class="px-2.5 py-1 rounded bg-cloud-100 text-navy-900 text-xs font-medium">
                      {svc}
                    </span>
                  ))}
                </div>

                <a href="/contact" class="inline-flex items-center gap-1.5 text-xs font-bold text-gold-600 hover:text-gold-700">
                  <span>Inquire for {ind.name}</span>
                  <Icon name="arrow-right" class="w-3.5 h-3.5" />
                </a>
              </div>
            </div>

            <!-- Right Image (5 cols) -->
            <div class={`lg:col-span-5 h-full min-h-[300px] lg:min-h-[450px] relative bg-navy-900 ${idx % 2 === 1 ? 'lg:order-1' : ''}`}>
              <img 
                src={ind.image} 
                alt={`${ind.name} - Al Manar Tech Project`}
                class="w-full h-full object-cover"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-navy-950/80 via-transparent to-transparent"></div>
              <div class="absolute bottom-6 left-6 right-6 text-white text-xs">
                <span class="px-2.5 py-1 rounded bg-navy-950/90 text-gold-400 font-semibold backdrop-blur-sm">
                  Abu Dhabi & Al Ain Installations
                </span>
              </div>
            </div>

          </div>
        </div>
      ))}

    </div>
  </section>

  <!-- Bottom CTA -->
  <section class="py-16 bg-navy-900 text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-6">
      <h2 class="text-2xl sm:text-3xl font-extrabold font-heading text-white">
        Don’t See Your Specific Industry Listed?
      </h2>
      <p class="text-slate-300 text-sm sm:text-base max-w-2xl mx-auto">
        Our multi-disciplinary engineering background allows us to develop custom electromechanical and building system solutions for any commercial, governmental, or educational facility.
      </p>
      <div>
        <a href="/contact" class="inline-flex items-center gap-2 px-8 py-3.5 rounded-xl text-sm font-bold bg-gold-500 text-navy-950 hover:bg-gold-400 shadow-md">
          <span>Consult with Our Project Engineers</span>
          <Icon name="arrow-right" class="w-4 h-4" />
        </a>
      </div>
    </div>
  </section>

</Layout>
